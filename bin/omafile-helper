VERSION = "1.0.0"
HOME = os.path.expanduser("~")

STDOUT_LOCK = threading.Lock()

def emit(obj):
    line = json.dumps(obj, ensure_ascii=True)
    with STDOUT_LOCK:
        sys.stdout.write(line)
        sys.stdout.write("\n")
        sys.stdout.flush()

def send_error(req_id, code, message, path=None):
    obj = {"id": req_id, "t": "error", "code": code, "message": message}
    if path is not None:
        obj["path"] = path
    emit(obj)

def send_done(req_id, **fields):
    obj = {"id": req_id, "t": "done"}
    obj.update(fields)
    emit(obj)

def errno_code(e):
    if isinstance(e, OSError) and e.errno:
        return errno.errorcode.get(e.errno, "EINTERNAL")
    return "EINTERNAL"

def to_bytes(p):
    return os.fsencode(p)

def to_str(b):
    return os.fsdecode(b)

INFLIGHT_LOCK = threading.Lock()
INFLIGHT = {}

def register_inflight(req_id, kind):
    ev = threading.Event()
    with INFLIGHT_LOCK:
        if req_id in INFLIGHT:
            return None
        INFLIGHT[req_id] = {"cancel": ev, "kind": kind}
    return ev

def unregister_inflight(req_id):
    with INFLIGHT_LOCK:
        INFLIGHT.pop(req_id, None)

CONFLICT_LOCK = threading.Lock()
PENDING_CONFLICTS = {}
CONFLICT_SEQ = [0]

WATCH_LOCK = threading.Lock()
WATCHES = {}

class Cancelled(Exception):
    pass

def classify(full_path_bytes, lst):
    mode = lst.st_mode
    if stat.S_ISLNK(mode):
        try:
            target = os.readlink(full_path_bytes)
        except OSError:
            target = b""
        link_target_str = to_str(target)
        try:
            st = os.stat(full_path_bytes)
        except OSError:
            return "b", 0, link_target_str
        if stat.S_ISDIR(st.st_mode):
            return "L", 0, link_target_str
        if not stat.S_ISREG(st.st_mode):
            return "o", 0, link_target_str
        return "l", st.st_size, link_target_str
    if stat.S_ISDIR(mode):
        return "d", 0, None
    if stat.S_ISREG(mode):
        return "f", lst.st_size, None
    return "o", getattr(lst, "st_size", 0), None

NATURAL_SPLIT = re.compile(r"(\d+)")


def natural_key(name):
    parts = NATURAL_SPLIT.split(name.lower())
    key = []
    for index, part in enumerate(parts):
        if index % 2:
            key.append((1, int(part), ""))
        else:
            key.append((0, 0, part))
    return key


def list_sort_key(entry):
    directory_first = 0 if entry[1] in ("d", "L") else 1
    return (directory_first, natural_key(entry[0]), entry[0])


PEEK_LIMIT = 262144
LIST_LIMIT = 200000

def op_list(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    hidden = bool(req.get("hidden", False))
    chunk_size = req.get("chunk") or 500
    try:
        chunk_size = int(chunk_size)
        if chunk_size <= 0:
            chunk_size = 500
    except (TypeError, ValueError):
        chunk_size = 500
    path_bytes = to_bytes(path)
    collected = []
    truncated = False
    remote = is_gvfs_path(path_bytes)
    try:
        with os.scandir(path_bytes) as it:
            for entry in it:
                if cancel_event.is_set():
                    send_error(req_id, "ECANCELED", "cancelled")
                    return
                if len(collected) >= LIST_LIMIT:
                    truncated = True
                    break
                name_str = to_str(entry.name)
                if not hidden and name_str.startswith("."):
                    continue
                if remote:
                    try:
                        if entry.is_symlink():
                            kind, size, mode = "l", 0, stat.S_IFLNK
                        elif entry.is_dir(follow_symlinks=False):
                            kind, size, mode = "d", 0, stat.S_IFDIR
                        else:
                            kind, size, mode = "f", 0, stat.S_IFREG
                    except OSError:
                        continue
                    collected.append([name_str, kind, size, 0, mode, None])
                    continue
                try:
                    lst = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                kind, size, link_target = classify(entry.path, lst)
                collected.append([name_str, kind, size, int(lst.st_mtime), lst.st_mode, link_target])
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    collected.sort(key=list_sort_key)
    total = len(collected)
    for i in range(0, total, chunk_size):
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        emit({"id": req_id, "t": "entries", "c": collected[i:i + chunk_size]})
    try:
        real = to_str(os.path.realpath(path_bytes))
    except (OSError, ValueError):
        real = path
    if truncated:
        send_done(req_id, total=total, truncated=True, real=real)
    else:
        send_done(req_id, total=total, real=real)

INOTIFY_LIB = None
INOTIFY_AVAILABLE = False
IN_CLOEXEC = 0o2000000
IN_NONBLOCK = 0o4000
IN_CREATE = 0x100
IN_DELETE = 0x200
IN_DELETE_SELF = 0x400
IN_MODIFY = 0x2
IN_MOVE_SELF = 0x800
IN_MOVED_FROM = 0x40
IN_MOVED_TO = 0x80
IN_ATTRIB = 0x4
IN_CLOSE_WRITE = 0x8
IN_Q_OVERFLOW = 0x4000
WATCH_MASK = (IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MODIFY | IN_MOVE_SELF |
              IN_MOVED_FROM | IN_MOVED_TO | IN_ATTRIB | IN_CLOSE_WRITE)
EVENT_FMT = "iIII"
EVENT_SIZE = struct.calcsize(EVENT_FMT)

try:
    INOTIFY_LIB = ctypes.CDLL("libc.so.6", use_errno=True)
    INOTIFY_LIB.inotify_init1.restype = ctypes.c_int
    INOTIFY_LIB.inotify_init1.argtypes = [ctypes.c_int]
    INOTIFY_LIB.inotify_add_watch.restype = ctypes.c_int
    INOTIFY_LIB.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    INOTIFY_LIB.inotify_rm_watch.restype = ctypes.c_int
    INOTIFY_LIB.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
except (OSError, AttributeError):
    INOTIFY_LIB = None

def try_inotify_init():
    if INOTIFY_LIB is None:
        return None
    fd = INOTIFY_LIB.inotify_init1(IN_CLOEXEC | IN_NONBLOCK)
    if fd < 0:
        return None
    return fd

_probe_fd = try_inotify_init()
INOTIFY_AVAILABLE = _probe_fd is not None
if _probe_fd is not None:
    os.close(_probe_fd)

class WatchHandle:
    def __init__(self, req_id, path_bytes):
        self.req_id = req_id
        self.path_bytes = path_bytes
        self.stop_event = threading.Event()
        self.thread = None
        self.fd = -1
        self.wd = -1
        self.mode = None

def inotify_loop(handle):
    pending = set()
    first_pending_time = None
    fd = handle.fd
    while not handle.stop_event.is_set():
        try:
            r, _, _ = select.select([fd], [], [], 0.05)
        except (OSError, ValueError):
            break
        if handle.stop_event.is_set():
            break
        if r:
            try:
                data = os.read(fd, 65536)
            except OSError:
                break
            offset = 0
            overflow = False
            while offset + EVENT_SIZE <= len(data):
                wd, mask, cookie, length = struct.unpack_from(EVENT_FMT, data, offset)
                name = b""
                if length:
                    raw = data[offset + EVENT_SIZE:offset + EVENT_SIZE + length]
                    name = raw.split(b"\0", 1)[0]
                offset += EVENT_SIZE + length
                if mask & IN_Q_OVERFLOW:
                    overflow = True
                    continue
                if name:
                    pending.add(name)
                if first_pending_time is None:
                    first_pending_time = time.monotonic()
            if overflow:
                pending.clear()
                first_pending_time = None
                emit({"id": handle.req_id, "t": "changed", "path": to_str(handle.path_bytes), "names": []})
        if pending and first_pending_time is not None and time.monotonic() - first_pending_time >= 0.12:
            names = sorted(to_str(n) for n in pending)
            emit({"id": handle.req_id, "t": "changed", "path": to_str(handle.path_bytes), "names": names})
            pending.clear()
            first_pending_time = None
    try:
        if handle.wd >= 0:
            INOTIFY_LIB.inotify_rm_watch(handle.fd, handle.wd)
    except OSError:
        pass
    try:
        os.close(handle.fd)
    except OSError:
        pass

def poll_loop(handle):
    last_snapshot = None
    names_only = is_gvfs_path(handle.path_bytes)
    while not handle.stop_event.wait(2.0):
        snap = None
        try:
            with os.scandir(handle.path_bytes) as it:
                if names_only:
                    snap = set(to_str(e.name) for e in it)
                else:
                    snap = {}
                    for e in it:
                        try:
                            st = e.stat(follow_symlinks=False)
                            snap[e.name] = (st.st_mtime, st.st_size)
                        except OSError:
                            pass
        except OSError:
            snap = None
        if last_snapshot is not None and snap is not None and snap != last_snapshot:
            if names_only:
                changed = set(snap) ^ set(last_snapshot)
            else:
                changed = [n for n in set(snap) | set(last_snapshot) if snap.get(n) != last_snapshot.get(n)]
            names = sorted(to_str(n) for n in changed) if len(changed) <= 200 else []
            emit({"id": handle.req_id, "t": "changed", "path": to_str(handle.path_bytes), "names": names})
        if snap is not None:
            last_snapshot = snap

def start_watch(req_id, path_bytes):
    handle = WatchHandle(req_id, path_bytes)
    fd = try_inotify_init() if INOTIFY_AVAILABLE else None
    if fd is not None:
        wd = INOTIFY_LIB.inotify_add_watch(fd, path_bytes, WATCH_MASK)
        if wd >= 0:
            handle.fd = fd
            handle.wd = wd
            handle.mode = "inotify"
            handle.thread = threading.Thread(target=inotify_loop, args=(handle,), daemon=True)
        else:
            os.close(fd)
    if handle.mode is None:
        handle.mode = "poll"
        handle.thread = threading.Thread(target=poll_loop, args=(handle,), daemon=True)
    handle.thread.start()
    return handle

def stop_watch(handle, cancelled=False):
    handle.stop_event.set()
    if handle.thread:
        handle.thread.join(timeout=1.0)
    if cancelled:
        send_error(handle.req_id, "ECANCELED", "cancelled")
    else:
        send_done(handle.req_id)

def op_watch(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    path_bytes = to_bytes(path)
    try:
        if not os.path.isdir(path_bytes):
            send_error(req_id, "ENOTDIR", "not a directory", path)
            return
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    old = None
    with WATCH_LOCK:
        old = WATCHES.get(path)
        handle = start_watch(req_id, path_bytes)
        WATCHES[path] = handle
    if old:
        stop_watch(old)

def op_unwatch(req):
    path = req.get("path")
    with WATCH_LOCK:
        handle = WATCHES.pop(path, None)
    if handle:
        stop_watch(handle)
    else:
        send_error(req["id"], "EINVAL", "no such watch", path)

def op_stat(req):
    req_id = req["id"]
    paths = req.get("paths") or []
    items = []
    for p in paths:
        item = {"path": p}
        try:
            pb = to_bytes(p)
            lst = os.lstat(pb)
            kind, size, link_target = classify(pb, lst)
            name = to_str(os.path.basename(pb))
            try:
                owner = pwd.getpwuid(lst.st_uid).pw_name
            except KeyError:
                owner = str(lst.st_uid)
            try:
                group = grp.getgrgid(lst.st_gid).gr_name
            except KeyError:
                group = str(lst.st_gid)
            mime, _ = mimetypes.guess_type(name)
            item.update({
                "name": name, "kind": kind, "size": size,
                "mtime": int(lst.st_mtime), "atime": int(lst.st_atime),
                "ctime": int(lst.st_ctime), "mode": lst.st_mode,
                "uid": lst.st_uid, "gid": lst.st_gid, "owner": owner, "group": group,
                "nlink": lst.st_nlink, "disk": lst.st_blocks * 512, "inode": lst.st_ino, "dev": lst.st_dev,
                "mime": mime, "linkTarget": link_target,
            })
        except OSError as e:
            item["error"] = errno_code(e)
        items.append(item)
    emit({"id": req_id, "t": "stat", "items": items})
    send_done(req_id)

DU_MAX_DEPTH = 256

def op_du(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    path_bytes = to_bytes(path)
    total_bytes = 0
    files = 0
    dirs = 0
    last_emit = [time.monotonic()]

    def maybe_emit(final=False):
        now = time.monotonic()
        if final or now - last_emit[0] >= 0.25:
            emit({"id": req_id, "t": "du", "bytes": total_bytes, "files": files, "dirs": dirs, "partial": not final})
            last_emit[0] = now

    try:
        root_lst = os.lstat(path_bytes)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    if stat.S_ISDIR(root_lst.st_mode) and not stat.S_ISLNK(root_lst.st_mode):
        pass
    else:
        total_bytes += root_lst.st_size
        files += 1
        maybe_emit(final=True)
        send_done(req_id)
        return
    root_dev = root_lst.st_dev
    seen = {(root_lst.st_dev, root_lst.st_ino)}
    stack = [(path_bytes, 0)]
    while stack:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        current, depth = stack.pop()
        try:
            with os.scandir(current) as it:
                for entry in it:
                    if cancel_event.is_set():
                        send_error(req_id, "ECANCELED", "cancelled")
                        return
                    try:
                        lst = entry.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(lst.st_mode):
                        key = (lst.st_dev, lst.st_ino)
                        if lst.st_dev != root_dev or key in seen:
                            continue
                        seen.add(key)
                        dirs += 1
                        if depth < DU_MAX_DEPTH:
                            stack.append((entry.path, depth + 1))
                    else:
                        total_bytes += lst.st_size
                        files += 1
                    maybe_emit()
        except OSError:
            continue
    maybe_emit(final=True)
    send_done(req_id)

class ChangedWhileCopying(OSError):
    pass


def open_checked(dir_fd, name, lst, flags):
    fd = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        st = os.fstat(fd)
        if (st.st_dev, st.st_ino) != (lst.st_dev, lst.st_ino) or stat.S_IFMT(st.st_mode) != stat.S_IFMT(lst.st_mode):
            raise ChangedWhileCopying(errno.ESTALE, "changed while copying")
        return fd
    except BaseException:
        os.close(fd)
        raise


def copy_file_data(src_fd, dst_fd, progress_cb, cancel_event):
    copied = 0
    use_cfr = hasattr(os, "copy_file_range")
    while True:
        if cancel_event.is_set():
            raise Cancelled()
        if use_cfr:
            try:
                n = os.copy_file_range(src_fd, dst_fd, 1024 * 1024)
            except OSError:
                use_cfr = False
                continue
            if n == 0:
                break
            copied += n
        else:
            buf = os.read(src_fd, 1024 * 1024)
            if not buf:
                break
            os.write(dst_fd, buf)
            copied += len(buf)
        progress_cb(copied)
    return copied


def copy_meta_fd(fd, lst):
    try:
        os.fchmod(fd, stat.S_IMODE(lst.st_mode))
    except OSError:
        pass
    try:
        os.utime(fd, ns=(lst.st_atime_ns, lst.st_mtime_ns))
    except OSError:
        pass


def lstat_at(dir_fd, name):
    try:
        return os.lstat(name, dir_fd=dir_fd)
    except FileNotFoundError:
        return None


def unique_name_at(dir_fd, name_bytes):
    if lstat_at(dir_fd, name_bytes) is None:
        return name_bytes
    stem, ext = os.path.splitext(to_str(name_bytes))
    n = 1
    while True:
        candidate = to_bytes("%s (%d)%s" % (stem, n, ext))
        if lstat_at(dir_fd, candidate) is None:
            return candidate
        n += 1


def remove_at(dir_fd, name, existing):
    if stat.S_ISDIR(existing.st_mode):
        shutil.rmtree(name, dir_fd=dir_fd)
    else:
        os.unlink(name, dir_fd=dir_fd)


PATH_OPEN_FLAGS = os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC
MAX_LINK_HOPS = 40
UNTRUSTED_LINK_ROOTS = (b"/mnt", b"/media", b"/run/media")


MOUNT_ESCAPE_RE = re.compile(rb"\\([0-7]{3})")


def unescape_mount(field):
    return MOUNT_ESCAPE_RE.sub(lambda m: bytes([int(m.group(1), 8) & 0xFF]), field)


def mount_entries():
    entries = []
    try:
        with open("/proc/self/mountinfo", "rb") as f:
            for line in f:
                parts = line.rstrip(b"\n").split(b" ")
                if b"-" not in parts or len(parts) < 5:
                    continue
                sep = parts.index(b"-")
                fstype = to_str(parts[sep + 1]) if len(parts) > sep + 1 else ""
                entries.append((unescape_mount(parts[4]), fstype))
    except OSError:
        pass
    return entries


def mount_for_path(real, entries):
    best = (b"/", "")
    for point, fstype in entries:
        if real == point or point == b"/" or real.startswith(point + b"/"):
            if len(point) >= len(best[0]):
                best = (point, fstype)
    return best


def real_dir(dir_fd):
    return os.readlink(b"/proc/self/fd/%d" % dir_fd)


def link_trusted(lst, dir_fd, mounts):
    if lst.st_uid not in (0, os.getuid()):
        return False
    try:
        real = real_dir(dir_fd)
    except OSError:
        return False
    point, fstype = mount_for_path(real, mounts)
    if fstype in NETWORK_FILESYSTEMS or fstype.startswith("fuse"):
        return False
    for root in UNTRUSTED_LINK_ROOTS:
        if point == root or point.startswith(root + b"/"):
            return False
    gvfs = to_bytes(GVFS_ROOT)
    if real == gvfs or real.startswith(gvfs + b"/"):
        return False
    return True


def trusted_link_target(dir_fd, name, mounts, message, shown):
    fd = os.open(name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        lst = os.fstat(fd)
        if not stat.S_ISLNK(lst.st_mode):
            return None
        if not link_trusted(lst, dir_fd, mounts):
            raise OSError(errno.ELOOP, message, to_str(shown))
        return os.readlink(b"", dir_fd=fd)
    finally:
        os.close(fd)


def open_dir_safely(path_bytes, create=False):
    if not path_bytes.startswith(b"/"):
        raise OSError(errno.EINVAL, "path must be absolute", to_str(path_bytes))
    fd = os.open(b"/", PATH_OPEN_FLAGS)
    pending = [c for c in path_bytes.split(b"/") if c]
    hops = 0
    mounts = None
    try:
        while pending:
            comp = pending.pop(0)
            if comp == b".":
                continue
            try:
                nxt = os.open(comp, PATH_OPEN_FLAGS | os.O_NOFOLLOW, dir_fd=fd)
            except FileNotFoundError:
                if not create or comp == b"..":
                    raise
                try:
                    os.mkdir(comp, 0o777, dir_fd=fd)
                except FileExistsError:
                    pass
                hops += 1
                if hops > MAX_LINK_HOPS:
                    raise OSError(errno.ELOOP, "this folder keeps changing", to_str(path_bytes))
                pending.insert(0, comp)
                continue
            except OSError as e:
                if e.errno not in (errno.ELOOP, errno.ENOTDIR):
                    raise
                if mounts is None:
                    mounts = mount_entries()
                target = trusted_link_target(fd, comp, mounts,
                                             "a folder in this path is a link Omafile will not follow here", path_bytes)
                if target is None:
                    raise
                hops += 1
                if hops > MAX_LINK_HOPS:
                    raise OSError(errno.ELOOP, "too many links", to_str(path_bytes))
                if target.startswith(b"/"):
                    os.close(fd)
                    fd = os.open(b"/", PATH_OPEN_FLAGS)
                pending = [c for c in target.split(b"/") if c] + pending
                continue
            os.close(fd)
            fd = nxt
        return fd
    except BaseException:
        os.close(fd)
        raise


def inside_or_same(path, folder):
    return path == folder or path.startswith(folder.rstrip(b"/") + b"/")


def valid_leaf(name):
    return bool(name) and name not in (b".", b"..") and b"/" not in name and b"\0" not in name


def open_parent_safely(path_bytes):
    path_bytes = path_bytes.rstrip(b"/") or b"/"
    name = os.path.basename(path_bytes)
    if not valid_leaf(name):
        raise OSError(errno.EINVAL, "not a valid file name", to_str(path_bytes))
    return open_dir_safely(os.path.dirname(path_bytes) or b"/"), name


RENAME_NOREPLACE = 1
_RENAMEAT2 = None
try:
    _libc = ctypes.CDLL(None, use_errno=True)
    _RENAMEAT2 = _libc.renameat2
    _RENAMEAT2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    _RENAMEAT2.restype = ctypes.c_int
except (OSError, AttributeError):
    _RENAMEAT2 = None


def rename_noreplace(src_name, src_fd, dst_name, dst_fd):
    if _RENAMEAT2 is not None:
        if _RENAMEAT2(src_fd, src_name, dst_fd, dst_name, RENAME_NOREPLACE) == 0:
            return
        err = ctypes.get_errno()
        if err not in (errno.EINVAL, errno.ENOSYS, errno.ENOTSUP):
            raise OSError(err, os.strerror(err), to_str(dst_name))
    if lstat_at(dst_fd, dst_name) is not None:
        raise OSError(errno.EEXIST, os.strerror(errno.EEXIST), to_str(dst_name))
    os.rename(src_name, dst_name, src_dir_fd=src_fd, dst_dir_fd=dst_fd)


def open_parent(path_bytes):
    fd, _ = open_parent_safely(path_bytes)
    return fd


def resolve_conflict(req_id, cancel_event, source_str, dest_str, dest_bytes, conflict_mode, job_state, both_dirs=False, over_folder=False):
    apply_all = job_state.get("applyAll")
    if both_dirs and conflict_mode == "ask":
        if "mergeDirs" not in job_state and apply_all not in ("skip", "rename"):
            choice = ask_conflict(req_id, cancel_event, source_str, dest_str, dest_bytes, job_state, True)
            if choice not in ("overwrite", "merge"):
                return "cancel"
            job_state["mergeDirs"] = choice == "merge"
        if job_state.get("mergeDirs"):
            return "merge"
    if apply_all and not (over_folder and apply_all == "overwrite"):
        return apply_all
    if conflict_mode != "ask":
        return conflict_mode
    return ask_conflict(req_id, cancel_event, source_str, dest_str, dest_bytes, job_state, False)


def ask_conflict(req_id, cancel_event, source_str, dest_str, dest_bytes, job_state, folders):
    try:
        dlst = os.lstat(dest_bytes)
        dkind, dsize, _ = classify(dest_bytes, dlst)
        dmtime = int(dlst.st_mtime)
    except OSError:
        dkind, dsize, dmtime = "f", 0, 0
    ev = threading.Event()
    with CONFLICT_LOCK:
        if req_id in PENDING_CONFLICTS:
            return "cancel"
        CONFLICT_SEQ[0] += 1
        seq = CONFLICT_SEQ[0]
        PENDING_CONFLICTS[req_id] = {"event": ev, "action": None, "applyAll": False, "seq": seq}
    emit({"id": req_id, "t": "conflict", "source": source_str, "dest": dest_str,
          "destKind": dkind, "destSize": dsize, "destMtime": dmtime, "seq": seq, "folders": folders})
    while True:
        if cancel_event.is_set():
            with CONFLICT_LOCK:
                PENDING_CONFLICTS.pop(req_id, None)
            return "cancel"
        if ev.wait(timeout=0.1):
            break
    with CONFLICT_LOCK:
        info = PENDING_CONFLICTS.pop(req_id, None)
    action = info["action"] if info else "cancel"
    if not folders and info and info.get("applyAll") and action in ("overwrite", "skip", "rename"):
        job_state["applyAll"] = action
    return action

def op_resolve(req):
    req_id = req["id"]
    action = req.get("action")
    apply_all = bool(req.get("applyAll", False))
    if action not in ("overwrite", "skip", "rename", "cancel", "merge"):
        action = "cancel"
    with CONFLICT_LOCK:
        info = PENDING_CONFLICTS.get(req_id)
        if info and req.get("seq") == info["seq"] and info["action"] is None:
            info["action"] = action
            info["applyAll"] = apply_all
            info["event"].set()

def op_copy_move(req, cancel_event, is_move):
    req_id = req["id"]
    sources = req.get("sources") or []
    dest = req.get("dest")
    conflict_mode = req.get("conflict", "ask")
    if not sources or not isinstance(dest, str):
        send_error(req_id, "EINVAL", "sources and dest required")
        return
    dest_bytes = to_bytes(dest)
    try:
        dest_lst = os.lstat(dest_bytes)
        if not stat.S_ISDIR(dest_lst.st_mode):
            send_error(req_id, "EINVAL", "dest is not a directory", dest)
            return
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), dest)
        return

    total_bytes = 0
    total_files = 0

    def prescan(p):
        nonlocal total_bytes, total_files
        try:
            lst = os.lstat(p)
        except OSError:
            return
        total_files += 1
        if stat.S_ISLNK(lst.st_mode):
            return
        if stat.S_ISDIR(lst.st_mode):
            try:
                with os.scandir(p) as it:
                    for e in it:
                        if cancel_event.is_set():
                            return
                        prescan(e.path)
            except OSError:
                pass
        else:
            total_bytes += lst.st_size

    for s in sources:
        prescan(to_bytes(s))
    if cancel_event.is_set():
        send_error(req_id, "ECANCELED", "cancelled")
        return

    copied = 0
    skipped = 0
    errors = []
    bytes_done = [0]
    files_done = [0]
    start_time = time.monotonic()
    last_progress = [0.0]
    job_state = {}

    def emit_progress(current_str, force=False):
        now = time.monotonic()
        if force or now - last_progress[0] >= 0.1:
            elapsed = now - start_time
            rate = bytes_done[0] / elapsed if elapsed > 0 else 0
            emit({"id": req_id, "t": "progress", "bytes": bytes_done[0], "total": total_bytes,
                  "files": files_done[0], "filesTotal": total_files, "current": current_str, "rate": rate})
            last_progress[0] = now

    def fail(path_bytes, e):
        errors.append({"path": to_str(path_bytes), "message": e.strerror or str(e)})

    top = {"armed": False, "name": None, "merged": False}

    def place_target(src_lst, src_fd, dst_fd, dst_name, src_path, dst_path, same_action, merge_dirs):
        nonlocal skipped
        armed = top["armed"]
        top["armed"] = False
        result = place_target_inner(src_lst, src_fd, dst_fd, dst_name, src_path, dst_path, same_action, merge_dirs)
        if armed:
            top["name"] = result[0]
            top["merged"] = result[2]
        return result

    def place_target_inner(src_lst, src_fd, dst_fd, dst_name, src_path, dst_path, same_action, merge_dirs):
        nonlocal skipped
        existing = lstat_at(dst_fd, dst_name)
        if existing is None:
            return dst_name, False, False
        over_folder = stat.S_ISDIR(existing.st_mode)
        both_dirs = over_folder and stat.S_ISDIR(src_lst.st_mode)
        if (existing.st_dev, existing.st_ino) == (src_lst.st_dev, src_lst.st_ino):
            action = same_action
        else:
            action = resolve_conflict(req_id, cancel_event, to_str(src_path), to_str(dst_path), dst_path, conflict_mode, job_state, both_dirs, over_folder and not both_dirs)
        if action == "merge" and both_dirs:
            return dst_name, False, True
        if action == "cancel":
            raise Cancelled()
        if action == "skip":
            skipped += 1
            return None, False, False
        if action == "rename":
            return unique_name_at(dst_fd, dst_name), False, False
        if action == "overwrite":
            if job_state.get("mergeDirs", merge_dirs) and both_dirs:
                return dst_name, False, True
            if not over_folder and not stat.S_ISDIR(src_lst.st_mode):
                return dst_name, True, False
            try:
                if over_folder and inside_or_same(real_dir(src_fd), os.path.join(real_dir(dst_fd), dst_name)):
                    raise OSError(errno.EINVAL, "the folder being replaced holds this item")
                remove_at(dst_fd, dst_name, existing)
            except OSError as e:
                fail(src_path, e)
                return None, False, False
            return dst_name, False, False
        raise Cancelled()

    def temp_name_at(dst_fd):
        while True:
            candidate = to_bytes(".omafile-part-%s" % os.urandom(6).hex())
            if lstat_at(dst_fd, candidate) is None:
                return candidate

    def copy_at(src_fd, src_name, dst_fd, dst_name, src_path, dst_path, same_action="rename", moving=False):
        nonlocal copied
        if cancel_event.is_set():
            raise Cancelled()
        try:
            lst = os.lstat(src_name, dir_fd=src_fd)
        except OSError as e:
            fail(src_path, e)
            return
        target, replace, _ = place_target(lst, src_fd, dst_fd, dst_name, src_path, dst_path, same_action, True)
        if target is None:
            return
        src_str = to_str(src_path)
        emit_progress(src_str)
        if stat.S_ISLNK(lst.st_mode):
            try:
                link = os.readlink(src_name, dir_fd=src_fd)
                tmp = temp_name_at(dst_fd)
                os.symlink(link, tmp, dir_fd=dst_fd)
                try:
                    if replace:
                        os.rename(tmp, target, src_dir_fd=dst_fd, dst_dir_fd=dst_fd)
                    else:
                        rename_noreplace(tmp, dst_fd, target, dst_fd)
                except OSError:
                    os.unlink(tmp, dir_fd=dst_fd)
                    raise
            except OSError as e:
                fail(src_path, e)
                return
            files_done[0] += 1
            copied += 1
        elif stat.S_ISDIR(lst.st_mode):
            try:
                child_src = open_checked(src_fd, src_name, lst, os.O_RDONLY | os.O_DIRECTORY)
            except OSError as e:
                fail(src_path, e)
                return
            try:
                try:
                    os.mkdir(target, 0o700, dir_fd=dst_fd)
                except FileExistsError:
                    pass
                child_dst = os.open(target, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dst_fd)
            except OSError as e:
                os.close(child_src)
                fail(src_path, e)
                return
            try:
                try:
                    names = sorted(os.fsencode(n) for n in os.listdir(child_src))
                except OSError as e:
                    fail(src_path, e)
                    names = []
                for name in names:
                    if cancel_event.is_set():
                        raise Cancelled()
                    (move_at if moving else copy_at)(child_src, name, child_dst, name,
                            os.path.join(src_path, name), os.path.join(os.path.dirname(dst_path), target, name))
                copy_meta_fd(child_dst, lst)
                if moving:
                    try:
                        os.rmdir(src_name, dir_fd=src_fd)
                    except OSError as e:
                        if e.errno != errno.ENOTEMPTY:
                            fail(src_path, e)
            finally:
                os.close(child_src)
                os.close(child_dst)
            files_done[0] += 1
            copied += 1
        elif stat.S_ISREG(lst.st_mode):
            base = bytes_done[0]

            def progress_cb(n):
                bytes_done[0] = base + n
                emit_progress(src_str)

            try:
                file_src = open_checked(src_fd, src_name, lst, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as e:
                fail(src_path, e)
                return
            try:
                tmp = temp_name_at(dst_fd)
                file_dst = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                                   0o600, dir_fd=dst_fd)
            except OSError as e:
                os.close(file_src)
                fail(src_path, e)
                return
            placed = False
            try:
                copy_file_data(file_src, file_dst, progress_cb, cancel_event)
                copy_meta_fd(file_dst, lst)
                os.close(file_dst)
                file_dst = None
                if replace:
                    os.rename(tmp, target, src_dir_fd=dst_fd, dst_dir_fd=dst_fd)
                else:
                    rename_noreplace(tmp, dst_fd, target, dst_fd)
                placed = True
            except Cancelled:
                raise
            except OSError as e:
                fail(src_path, e)
                bytes_done[0] = base
                return
            finally:
                os.close(file_src)
                if file_dst is not None:
                    os.close(file_dst)
                if not placed:
                    try:
                        os.unlink(tmp, dir_fd=dst_fd)
                    except OSError:
                        pass
            bytes_done[0] = base + lst.st_size
            files_done[0] += 1
            copied += 1
        else:
            fail(src_path, OSError(errno.EINVAL, "special files are not copied"))

    def move_at(src_fd, src_name, dst_fd, dst_name, src_path, dst_path):
        nonlocal copied
        if cancel_event.is_set():
            raise Cancelled()
        try:
            lst = os.lstat(src_name, dir_fd=src_fd)
        except OSError as e:
            fail(src_path, e)
            return
        target, replace, merged = place_target(lst, src_fd, dst_fd, dst_name, src_path, dst_path, "skip", False)
        if target is None:
            return
        if merged:
            copy_at(src_fd, src_name, dst_fd, target, src_path, dst_path, "skip", moving=True)
            return
        emit_progress(to_str(src_path))
        try:
            if replace:
                os.rename(src_name, target, src_dir_fd=src_fd, dst_dir_fd=dst_fd)
            else:
                rename_noreplace(src_name, src_fd, target, dst_fd)
            size = 0 if stat.S_ISDIR(lst.st_mode) else lst.st_size
            bytes_done[0] += size
            files_done[0] += 1
            copied += 1
        except OSError as e:
            if e.errno != errno.EXDEV:
                fail(src_path, e)
                return
            before = len(errors)
            skipped_before = skipped
            copy_at(src_fd, src_name, dst_fd, target, src_path, os.path.join(os.path.dirname(dst_path), target), "skip")
            if len(errors) != before or skipped != skipped_before:
                return
            try:
                remove_at(src_fd, src_name, lst)
            except OSError as e2:
                fail(src_path, e2)

    try:
        dest_fd = open_dir_safely(dest_bytes)
        dfst = os.fstat(dest_fd)
        if (dfst.st_dev, dfst.st_ino) != (dest_lst.st_dev, dest_lst.st_ino):
            os.close(dest_fd)
            raise ChangedWhileCopying(errno.ESTALE, "changed while copying")
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), dest)
        return
    created = []
    try:
        for s in sources:
            if cancel_event.is_set():
                raise Cancelled()
            src_bytes = to_bytes(s).rstrip(b"/") or b"/"
            name = os.path.basename(src_bytes)
            dst_bytes = os.path.join(dest_bytes, name)
            try:
                parent_fd = open_parent(src_bytes)
            except OSError as e:
                fail(src_bytes, e)
                continue
            before = (len(errors), skipped)
            top["armed"] = True
            top["name"] = None
            top["merged"] = False
            try:
                src_lst = lstat_at(parent_fd, name)
                if (src_lst is not None and stat.S_ISDIR(src_lst.st_mode)
                        and inside_or_same(real_dir(dest_fd), os.path.join(real_dir(parent_fd), name))):
                    fail(src_bytes, OSError(errno.EINVAL, "a folder cannot go inside itself"))
                elif is_move:
                    move_at(parent_fd, name, dest_fd, name, src_bytes, dst_bytes)
                else:
                    copy_at(parent_fd, name, dest_fd, name, src_bytes, dst_bytes)
            finally:
                top["armed"] = False
                os.close(parent_fd)
            if (len(errors), skipped) == before and top["name"] is not None and not top["merged"]:
                created.append({"source": s, "path": to_str(os.path.join(dest_bytes, top["name"]))})
    except Cancelled:
        send_error(req_id, "ECANCELED", "cancelled")
        return
    finally:
        os.close(dest_fd)
    emit_progress("", force=True)
    send_done(req_id, copied=copied, skipped=skipped, errors=errors, created=created)

def xdg_data_home_bytes():
    v = os.environ.get("XDG_DATA_HOME")
    if v:
        return to_bytes(v)
    return to_bytes(os.path.join(HOME, ".local", "share"))

def home_trash_dirs():
    base = os.path.join(xdg_data_home_bytes(), b"Trash")
    files_dir = os.path.join(base, b"files")
    info_dir = os.path.join(base, b"info")
    os.makedirs(files_dir, mode=0o700, exist_ok=True)
    os.makedirs(info_dir, mode=0o700, exist_ok=True)
    return files_dir, info_dir

def percent_encode(path_bytes):
    safe = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~/"
    out = []
    for b in path_bytes:
        if b in safe:
            out.append(chr(b))
        else:
            out.append("%%%02X" % b)
    return "".join(out)

def percent_decode(s):
    out = bytearray()
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if c == "%" and i + 2 < n:
            try:
                out.append(int(s[i + 1:i + 3], 16))
                i += 3
                continue
            except ValueError:
                pass
        out.extend(c.encode("utf-8", "surrogateescape"))
        i += 1
    return bytes(out)

def find_mount_point(path_bytes):
    p = path_bytes
    if not p:
        p = b"/"
    try:
        dev = os.stat(p).st_dev
    except OSError:
        p = os.path.dirname(p) or b"/"
        try:
            dev = os.stat(p).st_dev
        except OSError:
            return b"/"
    while True:
        parent = os.path.dirname(p)
        if parent == p or parent == b"":
            return p
        try:
            pdev = os.stat(parent).st_dev
        except OSError:
            return p
        if pdev != dev:
            return p
        p = parent

def mount_point_for_fd(dir_fd):
    return mount_for_path(real_dir(dir_fd), mount_entries())[0]

def volume_trash_name():
    return (".Trash-%d" % os.getuid()).encode()

def owned_real_dir(path_bytes):
    try:
        st = os.lstat(path_bytes)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid()

def checked_volume_trash(top):
    vol = os.path.join(top, volume_trash_name())
    files_dir = os.path.join(vol, b"files")
    info_dir = os.path.join(vol, b"info")
    if owned_real_dir(vol) and owned_real_dir(files_dir) and owned_real_dir(info_dir):
        return files_dir, info_dir
    return None

def open_owned_at(dir_fd, name, create=False):
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=dir_fd)
        except FileExistsError:
            pass
    fd = os.open(name, PATH_OPEN_FLAGS | os.O_NOFOLLOW, dir_fd=dir_fd)
    if os.fstat(fd).st_uid != os.getuid():
        os.close(fd)
        raise OSError(errno.EPERM, "the trash on this drive is not a folder you own", to_str(name))
    return fd


def open_volume_trash(top_fd, create):
    vol = open_owned_at(top_fd, volume_trash_name(), create)
    try:
        files_fd = open_owned_at(vol, b"files", create)
        try:
            info_fd = open_owned_at(vol, b"info", create)
        except BaseException:
            os.close(files_fd)
            raise
    finally:
        os.close(vol)
    return files_fd, info_fd


def home_trash_fds(files_dir=None, info_dir=None):
    if files_dir is None:
        files_dir, info_dir = home_trash_dirs()
    files_fd = open_dir_safely(files_dir)
    try:
        info_fd = open_dir_safely(info_dir)
    except BaseException:
        os.close(files_fd)
        raise
    return files_fd, info_fd


def trash_fds_for(parent_fd):
    files_fd, info_fd = home_trash_fds()
    if os.fstat(files_fd).st_dev == os.fstat(parent_fd).st_dev:
        return files_fd, info_fd, None
    os.close(files_fd)
    os.close(info_fd)
    top = mount_point_for_fd(parent_fd)
    top_fd = open_dir_safely(top)
    try:
        files_fd, info_fd = open_volume_trash(top_fd, True)
    finally:
        os.close(top_fd)
    return files_fd, info_fd, top


def trash_root_fds(index, files_dir, info_dir):
    if index == 0:
        return home_trash_fds(files_dir, info_dir)
    trash = os.path.dirname(files_dir)
    top_fd = open_dir_safely(os.path.dirname(trash))
    try:
        return open_volume_trash(top_fd, False)
    finally:
        os.close(top_fd)


def reserve_trash_name(info_fd, base_bytes, start=0):
    stem, ext = os.path.splitext(to_str(base_bytes))
    n = start
    while True:
        candidate = base_bytes if n == 0 else to_bytes("%s.%d%s" % (stem, n, ext))
        try:
            fd = os.open(candidate + b".trashinfo", os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=info_fd)
            return candidate, fd, n
        except FileExistsError:
            n += 1


def fd_path(dir_fd, name):
    return b"/proc/self/fd/%d/%s" % (dir_fd, name)


def move_across(src_fd, src_name, dst_fd, dst_name):
    if lstat_at(dst_fd, dst_name) is not None:
        raise OSError(errno.EEXIST, os.strerror(errno.EEXIST), to_str(dst_name))
    lst = os.lstat(src_name, dir_fd=src_fd)
    dst = fd_path(dst_fd, dst_name)
    if stat.S_ISLNK(lst.st_mode):
        os.symlink(os.readlink(src_name, dir_fd=src_fd), dst_name, dir_fd=dst_fd)
        os.unlink(src_name, dir_fd=src_fd)
    elif stat.S_ISDIR(lst.st_mode):
        shutil.copytree(fd_path(src_fd, src_name), dst, symlinks=True, copy_function=shutil.copy2)
        shutil.rmtree(src_name, dir_fd=src_fd)
    elif stat.S_ISREG(lst.st_mode):
        src = os.open(src_name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=src_fd)
        try:
            shutil.copy2(b"/proc/self/fd/%d" % src, dst)
        finally:
            os.close(src)
        os.unlink(src_name, dir_fd=src_fd)
    else:
        raise OSError(errno.EXDEV, "this kind of item cannot be moved to another drive", to_str(src_name))


def trash_one(src):
    pfd, name = open_parent_safely(src)
    try:
        os.lstat(name, dir_fd=pfd)
        files_fd, info_fd, top = trash_fds_for(pfd)
        try:
            real_parent = real_dir(pfd)
            full = os.path.join(real_parent, name)
            path_for_info = full if top is None else os.path.relpath(full, top)
            n = 0
            while True:
                candidate, fd, n = reserve_trash_name(info_fd, name, n)
                deletion_date = time.strftime("%Y-%m-%dT%H:%M:%S")
                content = "[Trash Info]\nPath=%s\nDeletionDate=%s\n" % (percent_encode(path_for_info), deletion_date)
                try:
                    os.write(fd, content.encode("utf-8"))
                finally:
                    os.close(fd)
                try:
                    try:
                        rename_noreplace(name, pfd, candidate, files_fd)
                    except OSError as e:
                        if e.errno != errno.EXDEV:
                            raise
                        move_across(pfd, name, files_fd, candidate)
                    return candidate
                except OSError as e:
                    try:
                        os.unlink(candidate + b".trashinfo", dir_fd=info_fd)
                    except OSError:
                        pass
                    if e.errno != errno.EEXIST:
                        raise
                    n += 1
        finally:
            os.close(files_fd)
            os.close(info_fd)
    finally:
        os.close(pfd)


def op_trash(req):
    req_id = req["id"]
    paths = req.get("paths") or []
    results = []
    for p in paths:
        try:
            candidate = trash_one(to_bytes(p))
            results.append({"path": p, "ok": True, "trashinfo": to_str(candidate)})
        except OSError as e:
            results.append({"path": p, "ok": False, "message": e.strerror or str(e)})
    send_done(req_id, results=results)


def trash_info_dir_for(parent_fd, files_dirs):
    if files_dirs[0] is None:
        table = {}
        for f, i in list_trash_roots():
            try:
                st = os.stat(f)
            except OSError:
                continue
            table[(st.st_dev, st.st_ino)] = i
        files_dirs[0] = table
    st = os.fstat(parent_fd)
    return files_dirs[0].get((st.st_dev, st.st_ino))


def op_delete(req):
    req_id = req["id"]
    paths = req.get("paths") or []
    results = []
    files_dirs = [None]
    for p in paths:
        try:
            pfd, name = open_parent_safely(to_bytes(p))
            try:
                lst = os.lstat(name, dir_fd=pfd)
                if stat.S_ISDIR(lst.st_mode):
                    shutil.rmtree(name, dir_fd=pfd)
                else:
                    os.unlink(name, dir_fd=pfd)
                info_dir = trash_info_dir_for(pfd, files_dirs)
            finally:
                os.close(pfd)
            if info_dir is not None:
                try:
                    ifd = open_dir_safely(info_dir)
                    try:
                        os.unlink(name + b".trashinfo", dir_fd=ifd)
                    finally:
                        os.close(ifd)
                except OSError:
                    pass
            results.append({"path": p, "ok": True})
        except OSError as e:
            results.append({"path": p, "ok": False, "message": e.strerror or str(e)})
    send_done(req_id, results=results)

def volume_mounts():
    mounts = []
    try:
        with open("/proc/mounts", "rb") as f:
            for line in f:
                parts = line.split()
                if len(parts) < 2:
                    continue
                mnt = parts[1].replace(rb"\040", b" ")
                if mnt not in mounts:
                    mounts.append(mnt)
    except OSError:
        pass
    return mounts

TRASHINFO_LIMIT = 65536

def read_trashinfo(info_path, dir_fd=None):
    try:
        fd = os.open(info_path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dir_fd)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > TRASHINFO_LIMIT:
            return None
        data = b""
        while len(data) <= TRASHINFO_LIMIT:
            chunk = os.read(fd, TRASHINFO_LIMIT + 1 - len(data))
            if not chunk:
                break
            data += chunk
        if len(data) > TRASHINFO_LIMIT:
            return None
        return data.decode("utf-8", "surrogateescape")
    except OSError:
        return None
    finally:
        os.close(fd)

def list_trash_roots():
    roots = [home_trash_dirs()]
    seen = {os.path.dirname(roots[0][0])}
    for mnt in volume_mounts():
        cand = os.path.join(mnt, volume_trash_name())
        if cand in seen:
            continue
        seen.add(cand)
        checked = checked_volume_trash(mnt)
        if checked:
            roots.append(checked)
    return roots

def restore_target(path_val, files_fd, is_home):
    orig = percent_decode(path_val)
    if b"\0" in orig:
        return None
    top = None
    if not orig.startswith(b"/"):
        top = mount_point_for_fd(files_fd)
        orig = os.path.join(top, orig)
    elif not is_home:
        top = mount_point_for_fd(files_fd)
    if b".." in orig.split(b"/"):
        return None
    if top is not None and top != b"/" and not orig.startswith(top + b"/"):
        return None
    return orig.rstrip(b"/") or None


def restore_one(name_in_trash, files_fd, info_fd, is_home):
    info_name = name_in_trash + b".trashinfo"
    raw = read_trashinfo(info_name, info_fd)
    if raw is None:
        return None, "invalid trashinfo"
    path_val = None
    for line in raw.splitlines():
        if line.startswith("Path="):
            path_val = line[len("Path="):]
            break
    if path_val is None:
        return None, "invalid trashinfo"
    orig = restore_target(path_val, files_fd, is_home)
    if orig is None or not valid_leaf(os.path.basename(orig)):
        return None, "invalid trashinfo"
    parent = os.path.dirname(orig) or b"/"
    pfd = open_dir_safely(parent, create=True)
    try:
        leaf = os.path.basename(orig)
        try:
            rename_noreplace(name_in_trash, files_fd, leaf, pfd)
        except OSError as e:
            if e.errno != errno.EXDEV:
                raise
            move_across(files_fd, name_in_trash, pfd, leaf)
    finally:
        os.close(pfd)
    os.unlink(info_name, dir_fd=info_fd)
    return orig, None


def op_restore(req):
    req_id = req["id"]
    items = req.get("items") or []
    results = []
    roots = list_trash_roots()
    for item in items:
        item_bytes = to_bytes(item) if isinstance(item, str) else b""
        if item_bytes.endswith(b".trashinfo"):
            item_bytes = item_bytes[:-len(b".trashinfo")]
        if not valid_leaf(item_bytes):
            results.append({"path": item, "ok": False, "message": "not found"})
            continue
        found = False
        for index, (files_dir, info_dir) in enumerate(roots):
            try:
                files_fd, info_fd = trash_root_fds(index, files_dir, info_dir)
            except OSError:
                continue
            try:
                if lstat_at(info_fd, item_bytes + b".trashinfo") is None:
                    continue
                found = True
                try:
                    orig, problem = restore_one(item_bytes, files_fd, info_fd, index == 0)
                    if problem:
                        results.append({"path": item, "ok": False, "message": problem})
                    else:
                        results.append({"path": to_str(orig), "ok": True})
                except OSError as e:
                    results.append({"path": item, "ok": False, "message": e.strerror or str(e)})
                break
            finally:
                os.close(files_fd)
                os.close(info_fd)
        if not found:
            results.append({"path": item, "ok": False, "message": "not found"})
    send_done(req_id, results=results)


TRASH_ITEMS_LIMIT = 5000


def op_trashinfo(req):
    req_id = req["id"]
    want_items = bool(req.get("items"))
    roots = list_trash_roots()
    items = []
    count = 0
    total_bytes = 0
    for index, (files_dir, info_dir) in enumerate(roots):
        try:
            files_fd, info_fd = trash_root_fds(index, files_dir, info_dir)
        except OSError:
            continue
        try:
            try:
                names = os.listdir(fd_path(info_fd, b"."))
            except OSError:
                continue
            for n in names:
                if not n.endswith(b".trashinfo"):
                    continue
                stem = n[:-len(".trashinfo")]
                lst = lstat_at(files_fd, stem)
                if lst is None:
                    continue
                size = lst.st_size if stat.S_ISREG(lst.st_mode) else 0
                count += 1
                total_bytes += size
                if not want_items or len(items) >= TRASH_ITEMS_LIMIT:
                    continue
                raw = read_trashinfo(n, info_fd)
                if raw is None:
                    continue
                path_val = None
                deleted = None
                for line in raw.splitlines():
                    if line.startswith("Path="):
                        path_val = line[len("Path="):]
                    elif line.startswith("DeletionDate="):
                        deleted = line[len("DeletionDate="):]
                orig_bytes = (restore_target(path_val, files_fd, index == 0) if path_val else None) or stem
                kind = "d" if stat.S_ISDIR(lst.st_mode) else ("l" if stat.S_ISLNK(lst.st_mode) else ("f" if stat.S_ISREG(lst.st_mode) else "o"))
                items.append({
                    "name": to_str(stem), "original": to_str(orig_bytes),
                    "deleted": deleted, "size": size, "kind": kind,
                })
        finally:
            os.close(files_fd)
            os.close(info_fd)
    watch_dirs = [to_str(info_dir) for _, info_dir in roots]
    msg = {"id": req_id, "t": "trash", "count": count, "bytes": total_bytes, "infoDirs": watch_dirs}
    if want_items:
        msg["items"] = items
    emit(msg)
    send_done(req_id)

DIR_OPEN_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC

def open_dir_chain(base, names):
    fd = os.open(base, DIR_OPEN_FLAGS)
    try:
        for name in names:
            nxt = os.open(name, DIR_OPEN_FLAGS | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nxt
            if os.fstat(fd).st_uid != os.getuid():
                raise OSError(errno.EPERM, "trash folder is not yours", to_str(name))
        return fd
    except BaseException:
        os.close(fd)
        raise

def empty_dir_fd(fd):
    for name in os.listdir(fd):
        try:
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISDIR(st.st_mode):
                shutil.rmtree(name, dir_fd=fd)
            else:
                os.unlink(name, dir_fd=fd)
        except OSError:
            pass

def trash_dir_chains():
    home_files, home_info = home_trash_dirs()
    chains = [(home_files, []), (home_info, [])]
    seen = {os.path.dirname(home_files)}
    for mnt in volume_mounts():
        cand = os.path.join(mnt, volume_trash_name())
        if cand in seen:
            continue
        seen.add(cand)
        if checked_volume_trash(mnt):
            chains.append((mnt, [volume_trash_name(), b"files"]))
            chains.append((mnt, [volume_trash_name(), b"info"]))
    return chains

def op_emptytrash(req):
    req_id = req["id"]
    for base, names in trash_dir_chains():
        try:
            fd = open_dir_chain(base, names)
        except OSError:
            continue
        try:
            empty_dir_fd(fd)
        finally:
            os.close(fd)
    send_done(req_id)

def op_mkdir(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        pfd, name = open_parent_safely(to_bytes(path))
        try:
            os.mkdir(name, dir_fd=pfd)
        finally:
            os.close(pfd)
        send_done(req_id, path=path)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def op_mkfile(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        pfd, name = open_parent_safely(to_bytes(path))
        try:
            fd = os.open(name, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, 0o666, dir_fd=pfd)
            os.close(fd)
        finally:
            os.close(pfd)
        send_done(req_id, path=path)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def op_rename(req):
    req_id = req["id"]
    path = req.get("path")
    new_name = req.get("newName")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    if not isinstance(new_name, str) or not valid_leaf(to_bytes(new_name)):
        send_error(req_id, "EINVAL", "invalid newName", path)
        return
    try:
        src = to_bytes(path).rstrip(b"/")
        pfd, name = open_parent_safely(src)
        try:
            new_bytes = to_bytes(new_name)
            if new_bytes != name:
                rename_noreplace(name, pfd, new_bytes, pfd)
        finally:
            os.close(pfd)
        send_done(req_id, path=to_str(os.path.join(os.path.dirname(src), to_bytes(new_name))))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def walk_targets(path_bytes, recursive, apply):
    pfd, name = open_parent_safely(path_bytes.rstrip(b"/") or b"/")
    try:
        apply(pfd, name)
        if not recursive:
            return
        try:
            if not stat.S_ISDIR(os.lstat(name, dir_fd=pfd).st_mode):
                return
        except OSError:
            return
        for _, dirnames, filenames, dirfd in os.fwalk(name, dir_fd=pfd, follow_symlinks=False):
            for child in dirnames + filenames:
                apply(dirfd, child)
    finally:
        os.close(pfd)

def op_identity(req):
    req_id = req["id"]
    uid = os.geteuid()
    try:
        user = pwd.getpwuid(uid).pw_name
    except KeyError:
        user = str(uid)
    groups = []
    for gid in list(os.getgroups()) + [os.getegid()]:
        try:
            groups.append(grp.getgrgid(gid).gr_name)
        except KeyError:
            groups.append(str(gid))
    reply = {"id": req_id, "t": "identity", "uid": uid, "user": user,
             "groups": sorted(set(groups)), "root": uid == 0}
    if uid == 0:
        reply["users"] = sorted(p.pw_name for p in pwd.getpwall())
        reply["groups"] = sorted(g.gr_name for g in grp.getgrall())
    emit(reply)
    send_done(req_id)

def op_chmod(req):
    req_id = req["id"]
    path = req.get("path")
    add = req.get("set")
    drop = req.get("clear")
    if not isinstance(path, str) or not isinstance(add, int) or not isinstance(drop, int):
        send_error(req_id, "EINVAL", "path, set and clear required")
        return
    mask = 0o7777
    add &= mask
    drop &= mask
    changed = [0]

    def apply(dir_fd, name):
        fd = os.open(name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
        try:
            lst = os.fstat(fd)
            if stat.S_ISLNK(lst.st_mode):
                return
            current = stat.S_IMODE(lst.st_mode)
            updated = (current | add) & ~drop & mask
            if updated != current:
                os.chmod("/proc/self/fd/%d" % fd, updated)
                changed[0] += 1
        finally:
            os.close(fd)

    try:
        walk_targets(to_bytes(path), bool(req.get("recursive")), apply)
        send_done(req_id, path=path, changed=changed[0])
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def lookup_owner(name):
    if isinstance(name, int):
        return name
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        if name.isdigit():
            return int(name)
        raise OSError(errno.EINVAL, "unknown user " + name)

def lookup_group(name):
    if isinstance(name, int):
        return name
    try:
        return grp.getgrnam(name).gr_gid
    except KeyError:
        if name.isdigit():
            return int(name)
        raise OSError(errno.EINVAL, "unknown group " + name)

def op_chown(req):
    req_id = req["id"]
    path = req.get("path")
    owner = req.get("owner")
    group = req.get("group")
    if not isinstance(path, str) or (owner is None and group is None):
        send_error(req_id, "EINVAL", "path and owner or group required")
        return
    try:
        uid = lookup_owner(owner) if owner is not None else -1
        gid = lookup_group(group) if group is not None else -1
        changed = [0]

        def apply(dir_fd, name):
            os.chown(name, uid, gid, dir_fd=dir_fd, follow_symlinks=False)
            changed[0] += 1

        walk_targets(to_bytes(path), bool(req.get("recursive")), apply)
        send_done(req_id, path=path, changed=changed[0])
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

MIME_TYPE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]*/[A-Za-z0-9][A-Za-z0-9.+_-]*$")
DESKTOP_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]*\.desktop$")
MIME_ENV_PASSTHROUGH = ("XDG_CONFIG_HOME", "XDG_CONFIG_DIRS", "XDG_DATA_HOME", "XDG_DATA_DIRS")


def run_gio_mime(args):
    extra = {key: os.environ[key] for key in MIME_ENV_PASSTHROUGH if os.environ.get(key)}
    return run_trusted("gio", args, timeout=10, extra_env=extra)


def gio_content_type(path):
    try:
        proc = run_gio_mime(["info", "-a", "standard::content-type", path])
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in (proc.stdout or "").splitlines():
        key, _, value = line.strip().partition(": ")
        if key == "standard::content-type" and MIME_TYPE_RE.match(value.strip()):
            return value.strip()
    return ""


def gio_default_app(mime):
    try:
        proc = run_gio_mime(["mime", mime])
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in (proc.stdout or "").splitlines():
        if line.startswith("Default application for"):
            handler = line.rpartition(": ")[2].strip()
            return handler if DESKTOP_ID_RE.match(handler) else ""
    return ""


def op_opener(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str) or not os.path.isabs(path):
        send_error(req_id, "EINVAL", "absolute path required")
        return
    mime = gio_content_type(path)
    if not mime:
        mime = mimetypes.guess_type(to_str(os.path.basename(to_bytes(path))))[0] or ""
    handler = gio_default_app(mime) if mime else ""
    emit({"id": req_id, "t": "opener", "mime": mime, "handler": handler})
    send_done(req_id)


def op_setopener(req):
    req_id = req["id"]
    mime = req.get("mime")
    handler = req.get("handler")
    if (not isinstance(mime, str) or not isinstance(handler, str)
            or not MIME_TYPE_RE.match(mime) or not DESKTOP_ID_RE.match(handler)
            or mime == "inode/directory"):
        send_error(req_id, "EINVAL", "mime and handler required")
        return
    try:
        proc = run_gio_mime(["mime", mime, handler])
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "gio mime timed out")
        return
    if proc.returncode != 0:
        send_error(req_id, "EINTERNAL", (proc.stderr or proc.stdout or "gio mime failed").strip())
        return
    send_done(req_id, mime=mime, handler=handler)

def op_symlink(req):
    req_id = req["id"]
    target = req.get("target")
    path = req.get("path")
    if not isinstance(target, str) or not isinstance(path, str):
        send_error(req_id, "EINVAL", "target and path required")
        return
    try:
        os.symlink(to_bytes(target), to_bytes(path))
        send_done(req_id, path=path)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def op_search(req, cancel_event):
    req_id = req["id"]
    root = req.get("root")
    query = req.get("query", "")
    mode = req.get("mode", "substring")
    max_results = req.get("maxResults") or 2000
    max_depth = req.get("maxDepth")
    if max_depth is None:
        max_depth = 64
    hidden = bool(req.get("hidden", False))
    if not isinstance(root, str):
        send_error(req_id, "EINVAL", "root required")
        return
    root_bytes = to_bytes(root)
    try:
        root_dev = os.stat(root_bytes).st_dev
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), root)
        return
    pattern = None
    if mode == "regex":
        try:
            pattern = re.compile(query)
        except re.error as e:
            send_error(req_id, "EINVAL", str(e))
            return
    query_lower = query.lower()
    matched = 0
    scanned = 0
    stack = [(root_bytes, 0)]
    while stack:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        current, depth = stack.pop()
        try:
            with os.scandir(current) as it:
                for entry in it:
                    if cancel_event.is_set():
                        send_error(req_id, "ECANCELED", "cancelled")
                        return
                    name_str = to_str(entry.name)
                    if name_str == ".git":
                        continue
                    if not hidden and name_str.startswith("."):
                        continue
                    scanned += 1
                    if mode == "substring":
                        is_match = query_lower in name_str.lower()
                    elif mode == "glob":
                        is_match = fnmatch.fnmatch(name_str.lower(), query_lower)
                    elif mode == "regex":
                        is_match = pattern.search(name_str) is not None
                    else:
                        is_match = False
                    if is_match:
                        try:
                            lst = entry.stat(follow_symlinks=False)
                            kind, size, _ = classify(entry.path, lst)
                            mtime = int(lst.st_mtime)
                        except OSError:
                            kind, size, mtime = "o", 0, 0
                        emit({"id": req_id, "t": "hit", "path": to_str(entry.path), "name": name_str,
                              "dir": to_str(current), "kind": kind, "size": size, "mtime": mtime})
                        matched += 1
                        if matched >= max_results:
                            send_done(req_id, truncated=True, scanned=scanned)
                            return
                    try:
                        is_dir = entry.is_dir(follow_symlinks=False)
                        is_symlink = entry.is_symlink()
                    except OSError:
                        is_dir = False
                        is_symlink = False
                    if is_dir and not is_symlink and depth < max_depth:
                        try:
                            st = entry.stat(follow_symlinks=False)
                            if st.st_dev == root_dev:
                                stack.append((entry.path, depth + 1))
                        except OSError:
                            pass
        except OSError:
            continue
    send_done(req_id, truncated=False, scanned=scanned)

def op_peek(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        limit = max(1, min(int(req.get("limit") or PEEK_LIMIT), PEEK_LIMIT))
    except (TypeError, ValueError):
        limit = PEEK_LIMIT
    try:
        fd = os.open(to_bytes(path), os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            st = os.fstat(fd)
            if stat.S_ISDIR(st.st_mode):
                send_error(req_id, "EISDIR", "is a directory", path)
                return
            if not stat.S_ISREG(st.st_mode):
                send_error(req_id, "EINVAL", "not a regular file", path)
                return
            chunks = []
            got = 0
            while got <= limit:
                chunk = os.read(fd, limit + 1 - got)
                if not chunk:
                    break
                chunks.append(chunk)
                got += len(chunk)
            data = b"".join(chunks)
        finally:
            os.close(fd)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    truncated = len(data) > limit
    data = data[:limit]
    binary = b"\0" in data[:8192]
    text = ""
    if not binary:
        text = data.decode("utf-8", errors="replace")
        if truncated and text.endswith("\ufffd"):
            text = text.rstrip("\ufffd")
        sample = text[:8192]
        if sample and sample.count("\ufffd") * 10 > len(sample):
            binary = True
            text = ""
    emit({"id": req_id, "t": "peek", "text": text, "binary": binary,
          "truncated": truncated, "size": len(data)})
    send_done(req_id)

AUDIO_PREVIEW_LIMIT = 1 << 30
AUDIO_PREVIEW_TIMEOUT = 90.0
AUDIO_TAG_LIMIT = 256
AUDIO_TAGS = ("title", "artist", "album_artist", "album")


def audio_preview_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    folder = os.path.join(base, "omafile", "preview")
    private_makedirs(folder)
    return folder


def prune_audio_previews(folder, keep):
    try:
        names = [n for n in os.listdir(folder) if n.startswith("preview-") and n.endswith(".mka")]
    except OSError:
        return
    names.sort(key=lambda n: os.lstat(os.path.join(folder, n)).st_mtime if os.path.lexists(os.path.join(folder, n)) else 0)
    for name in names[:max(0, len(names) - keep)]:
        try:
            os.unlink(os.path.join(folder, name))
        except OSError:
            pass


def run_media(argv, pass_fds, cancel_event, timeout, limit=65536):
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            env=trusted_env(), close_fds=True, pass_fds=tuple(pass_fds), start_new_session=True)
    try:
        os.setpriority(os.PRIO_PROCESS, proc.pid, 10)
    except OSError:
        pass
    out = bytearray()
    deadline = time.monotonic() + timeout
    stream = proc.stdout.fileno()
    open_stream = True
    try:
        while True:
            if cancel_event.is_set() or time.monotonic() > deadline:
                kill_process_group(proc)
                proc.wait()
                return None, b""
            if open_stream:
                ready, _, _ = select.select([stream], [], [], 0.2)
                if ready:
                    chunk = os.read(stream, 65536)
                    if not chunk:
                        open_stream = False
                    elif len(out) < limit:
                        out.extend(chunk[:limit - len(out)])
                continue
            try:
                return proc.wait(timeout=0.2), bytes(out)
            except subprocess.TimeoutExpired:
                continue
    finally:
        proc.stdout.close()


def audio_tags(probe, fd, cancel_event):
    code, out = run_media([probe, "-v", "error", "-show_entries",
                           "format_tags=" + ",".join(AUDIO_TAGS), "-of", "json", "/proc/self/fd/%d" % fd],
                          (fd,), cancel_event, 15.0)
    tags = {}
    if code != 0:
        return tags
    try:
        found = json.loads(out.decode("utf-8", "replace")).get("format", {}).get("tags", {})
    except (ValueError, AttributeError):
        return tags
    if not isinstance(found, dict):
        return tags
    for key, value in found.items():
        name = str(key).lower()
        if name in AUDIO_TAGS and isinstance(value, str):
            tags[name] = value[:AUDIO_TAG_LIMIT]
    return tags


def op_audiopreview(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str) or not path.startswith("/"):
        send_error(req_id, "EINVAL", "absolute path required")
        return
    try:
        ffmpeg = trusted_program("ffmpeg")
        probe = trusted_program("ffprobe")
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "ffmpeg is not installed", path)
        return
    try:
        fd = os.open(to_bytes(path), os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    out = None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            send_error(req_id, "EINVAL", "not a regular file", path)
            return
        if st.st_size > AUDIO_PREVIEW_LIMIT:
            send_error(req_id, "EFBIG", "too large to preview", path)
            return
        os.set_blocking(fd, True)
        folder = audio_preview_dir()
        prune_audio_previews(folder, 1)
        out = os.path.join(folder, "preview-%s.mka" % os.urandom(8).hex())
        tags = audio_tags(probe, fd, cancel_event)
        os.lseek(fd, 0, os.SEEK_SET)
        code, _ = run_media([ffmpeg, "-nostdin", "-v", "error", "-i", "/proc/self/fd/%d" % fd,
                             "-map", "0:a:0", "-c", "copy", "-map_metadata", "-1",
                             "-map_metadata:s:a:0", "-1", "-map_chapters", "-1",
                             "-fs", str(AUDIO_PREVIEW_LIMIT), "-f", "matroska", "-n", out],
                            (fd,), cancel_event, AUDIO_PREVIEW_TIMEOUT)
        if code is None:
            send_error(req_id, "ECANCELED" if cancel_event.is_set() else "ETIMEDOUT", "stopped", path)
            return
        if code != 0 or not os.path.isfile(out):
            send_error(req_id, "EFAIL", "could not read the audio in this file", path)
            return
        os.chmod(out, 0o600)
        result = out
        out = None
        send_done(req_id, path=result, title=tags.get("title", ""),
                  artist=tags.get("artist", "") or tags.get("album_artist", ""), album=tags.get("album", ""))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
    finally:
        os.close(fd)
        if out is not None:
            try:
                os.unlink(out)
            except OSError:
                pass


THUMB_BUCKETS = (("normal", 128), ("large", 256), ("x-large", 512), ("xx-large", 1024))
THUMB_BUCKET_SIZES = dict(THUMB_BUCKETS)
THUMB_URI_SAFE = "/!$&'()*+,;=:@"
THUMB_TIMEOUT = 20.0
THUMB_MAX_READ = 16 * 1024 * 1024
THUMB_WORKERS = threading.BoundedSemaphore(2)
THUMB_LOCKS_LOCK = threading.Lock()
THUMB_LOCKS = {}
THUMB_TABLES_LOCK = threading.Lock()
THUMB_TABLES = None
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"
PIXEL_CHUNKS = frozenset([b"IHDR", b"PLTE", b"tRNS", b"IDAT", b"IEND", b"gAMA", b"sRGB", b"cHRM", b"sBIT"])
THUMB_TEXT_LIMIT = 16384
THUMB_MAX_SIDE = max(size for _, size in THUMB_BUCKETS)
PREVIEW_SIDES = {"preview-2048": 2048, "preview-4096": 4096, "preview-7680": 7680}
PREVIEW_KEEP = 500
PREVIEW_CACHE_BYTES = 2 << 30
PREVIEW_TIMEOUT = 90.0
PNG_SMALL_CHUNK = 65536

def thumb_root():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    return os.path.join(base, "thumbnails")

def preview_root():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    return os.path.join(base, "omafile", "previews")

def png_read_limit(side):
    return side * side * 8 + (1 << 20)

def thumb_place(root, bucket):
    if bucket in PREVIEW_SIDES:
        side = PREVIEW_SIDES[bucket]
        return os.path.join(preview_root(), str(side)), side, png_read_limit(side)
    return os.path.join(root, bucket), THUMB_BUCKET_SIZES[bucket], THUMB_MAX_READ

def prune_previews(root, keep=PREVIEW_KEEP, budget=PREVIEW_CACHE_BYTES):
    files = []
    try:
        entries = os.listdir(root)
    except OSError:
        return
    for entry in entries:
        path = os.path.join(root, entry)
        if entry.endswith(".png"):
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        if entry not in [str(side) for side in PREVIEW_SIDES.values()]:
            continue
        try:
            names = os.listdir(path)
        except OSError:
            continue
        for name in names:
            if not name.endswith(".png") or name.startswith("."):
                continue
            try:
                st = os.lstat(os.path.join(path, name))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                files.append((st.st_mtime, st.st_size, os.path.join(path, name)))
    files.sort(reverse=True)
    total = 0
    for index, (_, size, path) in enumerate(files):
        total += size
        if index < keep and total <= budget:
            continue
        try:
            os.unlink(path)
        except OSError:
            pass

def thumb_uri(path_bytes):
    return "file://" + urllib.parse.quote(path_bytes, safe=THUMB_URI_SAFE)

def data_dirs():
    dirs = [os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")]
    extra = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    dirs.extend(d for d in extra.split(":") if d)
    return dirs

THUMBNAILER_DIRS = ("/usr/local/share/thumbnailers", "/usr/share/thumbnailers")

def trusted_thumbnailer(path):
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and trusted_node(st) and trusted_directory_chain(os.path.dirname(path))

def thumbnail_program(name):
    program = trusted_program(os.path.basename(name))
    if "/" in name and name != program:
        raise FileNotFoundError(errno.ENOENT, "untrusted thumbnailer program", name)
    return program

def parse_thumbnailer(path):
    if not trusted_thumbnailer(path):
        return None
    fields = {}
    in_entry = False
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    in_entry = line == "[Thumbnailer Entry]"
                    continue
                if in_entry and "=" in line:
                    key, value = line.split("=", 1)
                    fields[key.strip()] = value.strip()
    except OSError:
        return None
    command = fields.get("Exec", "")
    if not command:
        return None
    try_exec = fields.get("TryExec", "")
    try:
        args = shlex.split(command)
        if not args:
            return None
        thumbnail_program(args[0])
        if try_exec:
            thumbnail_program(try_exec)
    except (OSError, ValueError):
        return None
    mimes = [m.strip() for m in fields.get("MimeType", "").split(";") if m.strip()]
    return {"exec": command, "mimes": mimes}

def load_mime_globs(dirs):
    best = {}
    for d in reversed(dirs):
        try:
            with open(os.path.join(d, "mime", "globs2"), "r", encoding="utf-8", errors="replace") as f:
                for raw in f:
                    parts = raw.strip().split(":")
                    if len(parts) < 3 or parts[0].startswith("#"):
                        continue
                    glob = parts[2]
                    if not glob.startswith("*.") or any(c in glob[2:] for c in "*?[]"):
                        continue
                    try:
                        weight = int(parts[0])
                    except ValueError:
                        continue
                    ext = glob[2:].lower()
                    if ext not in best or weight > best[ext][0]:
                        best[ext] = (weight, parts[1])
        except OSError:
            continue
    return {ext: mime for ext, (weight, mime) in best.items()}

def load_mime_aliases(dirs):
    aliases = {}
    for d in dirs:
        try:
            with open(os.path.join(d, "mime", "aliases"), "r", encoding="utf-8", errors="replace") as f:
                for raw in f:
                    parts = raw.split()
                    if len(parts) == 2:
                        aliases.setdefault(parts[0], parts[1])
        except OSError:
            continue
    return aliases

def thumb_tables():
    global THUMB_TABLES
    with THUMB_TABLES_LOCK:
        if THUMB_TABLES is not None:
            return THUMB_TABLES
        dirs = data_dirs()
        commands = {}
        seen = set()
        for folder in THUMBNAILER_DIRS:
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for name in names:
                if not name.endswith(".thumbnailer") or name in seen:
                    continue
                seen.add(name)
                entry = parse_thumbnailer(os.path.join(folder, name))
                if not entry:
                    continue
                for mime in entry["mimes"]:
                    commands.setdefault(mime, entry["exec"])
        aliases = load_mime_aliases(dirs)
        for alias, canonical in aliases.items():
            if alias in commands and canonical not in commands:
                commands[canonical] = commands[alias]
            elif canonical in commands and alias not in commands:
                commands[alias] = commands[canonical]
        globs = load_mime_globs(dirs)
        if not mimetypes.inited:
            mimetypes.init()
        for ext, mime in mimetypes.types_map.items():
            globs.setdefault(ext.lstrip(".").lower(), mime)
        THUMB_TABLES = {"commands": commands, "globs": globs, "aliases": aliases}
        return THUMB_TABLES

def guess_mime(name):
    tables = thumb_tables()
    lower = name.lower()
    parts = lower.split(".")
    for i in range(1, len(parts)):
        mime = tables["globs"].get(".".join(parts[i:]))
        if mime:
            return tables["aliases"].get(mime, mime)
    return None

def thumbnailer_for(name):
    mime = guess_mime(name)
    if not mime:
        return None, None
    return thumb_tables()["commands"].get(mime), mime

def png_chunk(kind, body):
    return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xffffffff)

def png_chunks(data):
    if not data.startswith(PNG_MAGIC):
        return None
    chunks = []
    pos = 8
    while pos + 8 <= len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        end = pos + 12 + length
        if end > len(data):
            return None
        chunks.append((kind, data[pos + 8:pos + 8 + length]))
        pos = end
        if kind == b"IEND":
            return chunks
    return None

def png_scan(f, max_read):
    size = os.fstat(f.fileno()).st_size
    if size > max_read or f.read(8) != PNG_MAGIC:
        return None
    chunks = []
    pos = 8
    while pos + 12 <= size:
        f.seek(pos)
        header = f.read(8)
        if len(header) != 8:
            return None
        length, kind = struct.unpack(">I4s", header)
        end = pos + 12 + length
        if end > size:
            return None
        if kind == b"tEXt" and length > THUMB_TEXT_LIMIT:
            return None
        body = b""
        if kind != b"IDAT" and length <= PNG_SMALL_CHUNK:
            body = f.read(length)
            if len(body) != length:
                return None
        chunks.append((kind, body, pos + 8, length))
        pos = end
        if kind == b"IEND":
            return chunks
    return None

def png_text(chunks):
    out = {}
    for chunk in chunks:
        kind, body = chunk[0], chunk[1]
        if kind == b"tEXt" and b"\0" in body:
            key, value = body.split(b"\0", 1)
            out[key.decode("latin-1")] = value.decode("latin-1")
    return out

def png_size(chunks):
    if not chunks or chunks[0][0] != b"IHDR" or len(chunks[0][1]) != 13:
        return None
    return struct.unpack(">II", chunks[0][1][:8])

def safe_thumb(chunks, max_side=THUMB_MAX_SIDE):
    size = png_size(chunks)
    if size is None or not (0 < size[0] <= max_side and 0 < size[1] <= max_side):
        return False
    text = 0
    for chunk in chunks:
        kind, body = chunk[0], chunk[1]
        if kind == b"tEXt":
            text += len(body)
        elif kind not in PIXEL_CHUNKS:
            return False
    return text <= THUMB_TEXT_LIMIT

def png_with_text(chunks, fields):
    kept = [(kind, body) for kind, body in chunks if kind in PIXEL_CHUNKS]
    text = [(b"tEXt", k.encode("latin-1") + b"\0" + v.encode("latin-1", errors="replace"))
            for k, v in fields.items()]
    ordered = kept[:1] + text + kept[1:]
    return PNG_MAGIC + b"".join(png_chunk(kind, body) for kind, body in ordered)

def blank_png():
    header = struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)
    pixels = zlib.compress(b"\x00\x00\x00\x00\x00")
    return [(b"IHDR", header), (b"IDAT", pixels), (b"IEND", b"")]

def thumb_matches(path, uri, mtime, max_side=THUMB_MAX_SIDE, max_read=THUMB_MAX_READ):
    try:
        with open(path, "rb", buffering=1 << 16) as f:
            chunks = png_scan(f, max_read)
    except OSError:
        return False
    if not chunks or not safe_thumb(chunks, max_side):
        return False
    meta = png_text(chunks)
    if meta.get("Thumb::URI") != uri:
        return False
    try:
        return int(float(meta.get("Thumb::MTime", ""))) == mtime
    except ValueError:
        return False

def find_thumb(root, name, uri, mtime, bucket):
    if bucket in PREVIEW_SIDES:
        folder, side, limit = thumb_place(root, bucket)
        candidate = os.path.join(folder, name)
        if not thumb_matches(candidate, uri, mtime, side, limit):
            return None
        try:
            os.utime(candidate)
        except OSError:
            pass
        return candidate
    start = [b for b, _ in THUMB_BUCKETS].index(bucket)
    for folder, _ in THUMB_BUCKETS[start:]:
        candidate = os.path.join(root, folder, name)
        if thumb_matches(candidate, uri, mtime):
            return candidate
    return None

def failed_before(root, name, uri, mtime):
    fail_root = os.path.join(root, "fail")
    try:
        apps = os.listdir(fail_root)
    except OSError:
        return False
    return any(thumb_matches(os.path.join(fail_root, app, name), uri, mtime) for app in apps)

def private_makedirs(folder):
    if os.path.isdir(folder):
        return
    parent = os.path.dirname(folder)
    if parent and parent != folder:
        private_makedirs(parent)
    try:
        os.mkdir(folder, 0o700)
    except FileExistsError:
        pass

def write_png(path, chunks, fields):
    folder = os.path.dirname(path)
    private_makedirs(folder)
    fd, tmp = tempfile.mkstemp(prefix=".omafile-", suffix=".png", dir=folder)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(png_with_text(chunks, fields))
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

def copy_png_chunk(out, src, kind, body, offset, length):
    out.write(struct.pack(">I", length) + kind)
    crc = zlib.crc32(kind)
    if len(body) == length:
        out.write(body)
        crc = zlib.crc32(body, crc)
    else:
        src.seek(offset)
        left = length
        while left > 0:
            piece = src.read(min(left, 1 << 20))
            if not piece:
                raise OSError(errno.EIO, "the thumbnail ended early")
            out.write(piece)
            crc = zlib.crc32(piece, crc)
            left -= len(piece)
    out.write(struct.pack(">I", crc & 0xffffffff))

def write_png_from(path, src, chunks, fields):
    folder = os.path.dirname(path)
    private_makedirs(folder)
    kept = [c for c in chunks if c[0] in PIXEL_CHUNKS]
    text = []
    for k, v in fields.items():
        body = k.encode("latin-1") + b"\0" + v.encode("latin-1", errors="replace")
        text.append((b"tEXt", body, 0, len(body)))
    fd, tmp = tempfile.mkstemp(prefix=".omafile-", suffix=".png", dir=folder)
    try:
        with os.fdopen(fd, "wb", buffering=1 << 20) as out:
            out.write(PNG_MAGIC)
            for kind, body, offset, length in kept[:1] + text + kept[1:]:
                copy_png_chunk(out, src, kind, body, offset, length)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

def expand_thumb_command(command, path, uri, out, size):
    try:
        args = shlex.split(command)
    except ValueError:
        return None
    subs = {"i": path, "u": uri, "o": out, "s": str(size), "%": "%"}
    result = []
    for arg in args:
        piece = []
        i = 0
        while i < len(arg):
            if arg[i] == "%" and i + 1 < len(arg) and arg[i + 1] in subs:
                piece.append(subs[arg[i + 1]])
                i += 2
            else:
                piece.append(arg[i])
                i += 1
        result.append("".join(piece))
    return result

def run_thumbnailer(args, cancel_event, timeout=THUMB_TIMEOUT):
    try:
        program = thumbnail_program(args[0])
        proc = subprocess.Popen([program] + args[1:], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, env=trusted_env(), start_new_session=True)
    except OSError:
        return "failed"
    try:
        os.setpriority(os.PRIO_PROCESS, proc.pid, 10)
    except OSError:
        pass
    deadline = time.monotonic() + timeout
    while True:
        try:
            code = proc.wait(timeout=0.2)
            return "ok" if code == 0 else "failed"
        except subprocess.TimeoutExpired:
            if cancel_event.is_set() or time.monotonic() > deadline:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
                proc.wait()
                return "cancelled" if cancel_event.is_set() else "timeout"

def acquire_thumb_worker(cancel_event):
    while not cancel_event.is_set():
        if THUMB_WORKERS.acquire(timeout=0.2):
            return True
    return False

def generate_thumb(root, name, src, uri, st, bucket, command, mime, cancel_event):
    folder, size, max_read = thumb_place(root, bucket)
    private_makedirs(folder)
    fd, out = tempfile.mkstemp(prefix=".omafile-", suffix=".png", dir=folder)
    os.close(fd)
    try:
        args = expand_thumb_command(command, to_str(src), uri, out, size)
        if not args:
            return "failed"
        status = run_thumbnailer(args, cancel_event, PREVIEW_TIMEOUT if bucket in PREVIEW_SIDES else THUMB_TIMEOUT)
        if status != "ok":
            return status
        fields = {"Thumb::URI": uri, "Thumb::MTime": str(int(st.st_mtime)),
                  "Thumb::Size": str(st.st_size), "Thumb::Mimetype": mime,
                  "Software": "Omafile " + VERSION}
        try:
            with open(out, "rb", buffering=1 << 16) as f:
                chunks = png_scan(f, max_read)
                if not chunks or png_size(chunks) is None or max(png_size(chunks)) > size:
                    return "failed"
                write_png_from(os.path.join(folder, name), f, chunks, fields)
        except FileNotFoundError:
            return "failed"
        if bucket in PREVIEW_SIDES:
            prune_previews(preview_root())
        return "ok"
    finally:
        try:
            os.unlink(out)
        except OSError:
            pass

def op_thumb(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    bucket = req.get("size")
    if bucket not in THUMB_BUCKET_SIZES and bucket not in PREVIEW_SIDES:
        bucket = "large"
    if not isinstance(path, str) or not path.startswith("/"):
        send_error(req_id, "EINVAL", "absolute path required")
        return
    src = to_bytes(path)
    try:
        st = os.stat(src)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    if not stat.S_ISREG(st.st_mode):
        send_error(req_id, "EINVAL", "not a regular file", path)
        return
    root = thumb_root()
    real = os.path.realpath(src)
    if real.startswith(to_bytes(root) + b"/") or real.startswith(to_bytes(preview_root()) + b"/"):
        send_error(req_id, "EUNSUPPORTED", "file is inside the thumbnail cache", path)
        return
    uri = thumb_uri(src)
    mtime = int(st.st_mtime)
    name = hashlib.md5(uri.encode("ascii")).hexdigest() + ".png"
    found = find_thumb(root, name, uri, mtime, bucket)
    if not found:
        command, mime = thumbnailer_for(os.path.basename(path))
        if not command:
            send_error(req_id, "EUNSUPPORTED", "no thumbnailer for this file type", path)
            return
        if failed_before(root, name, uri, mtime):
            send_error(req_id, "EUNSUPPORTED", "thumbnailer failed on this file before", path)
            return
        with THUMB_LOCKS_LOCK:
            lock = THUMB_LOCKS.setdefault(name + bucket, threading.Lock())
        with lock:
            found = find_thumb(root, name, uri, mtime, bucket)
            if not found:
                if not acquire_thumb_worker(cancel_event):
                    send_error(req_id, "ECANCELED", "cancelled")
                    return
                try:
                    status = generate_thumb(root, name, src, uri, st, bucket, command, mime, cancel_event)
                except OSError as e:
                    send_error(req_id, errno_code(e), e.strerror or str(e), path)
                    return
                finally:
                    THUMB_WORKERS.release()
                if status == "cancelled":
                    send_error(req_id, "ECANCELED", "cancelled")
                    return
                if status == "failed" and bucket not in PREVIEW_SIDES:
                    try:
                        marker = os.path.join(root, "fail", "omafile-" + VERSION, name)
                        write_png(marker, blank_png(), {"Thumb::URI": uri, "Thumb::MTime": str(mtime),
                                                        "Software": "Omafile " + VERSION})
                    except OSError:
                        pass
                if status != "ok":
                    send_error(req_id, "EUNSUPPORTED", "thumbnailer " + status, path)
                    return
                found = os.path.join(thumb_place(root, bucket)[0], name)
    emit({"id": req_id, "t": "thumb", "thumb": found})
    send_done(req_id)

def op_thumbtypes(req):
    req_id = req["id"]
    tables = thumb_tables()
    commands = tables["commands"]
    aliases = tables["aliases"]
    exts = sorted(ext for ext, mime in tables["globs"].items()
                  if "." not in ext and aliases.get(mime, mime) in commands)
    emit({"id": req_id, "t": "thumbtypes", "exts": exts})
    send_done(req_id)

def gtk_bookmarks_file():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    return os.path.join(base, "gtk-3.0", "bookmarks")

def read_bookmark_lines():
    try:
        with open(gtk_bookmarks_file(), "rb") as f:
            raw = f.read().decode("utf-8", "surrogateescape")
    except FileNotFoundError:
        return []
    out = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        uri, _, label = line.partition(" ")
        out.append({"uri": uri, "label": label.strip(), "path": uri_to_path(uri)})
    return out

def op_bookmarks(req):
    req_id = req["id"]
    try:
        os.makedirs(os.path.dirname(gtk_bookmarks_file()), exist_ok=True)
    except OSError:
        pass
    try:
        items = read_bookmark_lines()
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), gtk_bookmarks_file())
        return
    emit({"id": req_id, "t": "bookmarks", "file": gtk_bookmarks_file(),
          "dir": os.path.dirname(gtk_bookmarks_file()),
          "items": [{"path": i["path"], "label": i["label"]} for i in items if i["path"]]})
    send_done(req_id)

def op_setbookmarks(req):
    req_id = req["id"]
    items = req.get("items")
    if not isinstance(items, list):
        send_error(req_id, "EINVAL", "items required")
        return
    lines = []
    seen = set()
    for item in items:
        path = item.get("path") if isinstance(item, dict) else None
        if not isinstance(path, str) or not path.startswith("/") or path in seen:
            continue
        seen.add(path)
        uri = "file://" + urllib.parse.quote(to_bytes(os.path.normpath(path)), safe=THUMB_URI_SAFE)
        label = str(item.get("label") or "").replace("\n", " ").strip()
        lines.append(uri + (" " + label if label else ""))
    try:
        existing = read_bookmark_lines()
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), gtk_bookmarks_file())
        return
    for other in existing:
        if not other["path"]:
            lines.append(other["uri"] + (" " + other["label"] if other["label"] else ""))
    target = gtk_bookmarks_file()
    folder = os.path.dirname(target)
    try:
        os.makedirs(folder, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".bookmarks-", dir=folder)
        with os.fdopen(fd, "wb") as f:
            f.write(("\n".join(lines) + ("\n" if lines else "")).encode("utf-8", "surrogateescape"))
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), target)
        return
    send_done(req_id, count=len(lines))

COUNT_LIMIT = 100000

def op_counts(req, cancel_event):
    req_id = req["id"]
    paths = req.get("paths") or []
    hidden = bool(req.get("hidden", False))
    counts = {}
    for path in paths[:500]:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        if not isinstance(path, str):
            continue
        n = 0
        try:
            with os.scandir(to_bytes(path)) as it:
                for entry in it:
                    if not hidden and entry.name.startswith(b"."):
                        continue
                    n += 1
                    if n >= COUNT_LIMIT:
                        break
        except OSError:
            n = -1
        counts[path] = n
    emit({"id": req_id, "t": "counts", "counts": counts, "limit": COUNT_LIMIT})
    send_done(req_id)

def op_freespace(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        b = to_bytes(path)
        st = os.statvfs(b)
        total = st.f_frsize * st.f_blocks
        free = st.f_frsize * st.f_bavail
        used = total - st.f_frsize * st.f_bfree
        mount = to_str(find_mount_point(b))
        emit({"id": req_id, "t": "space", "total": total, "free": free, "used": used, "mount": mount})
        send_done(req_id)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def run_tool(argv):
    try:
        proc = subprocess.run([trusted_program(argv[0])] + list(argv[1:]), shell=False,
                              stdin=subprocess.DEVNULL, capture_output=True, timeout=5, env=trusted_env())
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout.decode("utf-8", "replace"))
    except ValueError:
        return None

def flatten_lsblk(devices):
    out = []
    for d in devices or []:
        out.append(d)
        out.extend(flatten_lsblk(d.get("children")))
    return out

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % os.getuid())
GVFS_ROOT = os.path.join(RUNTIME_DIR, "gvfs")

def is_gvfs_path(path_bytes):
    gvfs = to_bytes(GVFS_ROOT)
    return path_bytes == gvfs or path_bytes.startswith(gvfs + b"/")


def unquote_path(value):
    try:
        return to_str(percent_decode(value))
    except Exception:
        return value


def gvfs_fields(name):
    fields = {}
    if ":" in name:
        for part in name.split(":", 1)[1].split(","):
            if "=" in part:
                key, value = part.split("=", 1)
                fields[key] = unquote_path(value)
    return fields

def gvfs_label(name):
    scheme = name.split("-")[0] if "-" in name else name
    fields = {}
    if ":" in name:
        for part in name.split(":", 1)[1].split(","):
            if "=" in part:
                key, value = part.split("=", 1)
                fields[key] = unquote_path(value)
    share = fields.get("share") or fields.get("volume") or fields.get("path") or ""
    server = fields.get("server") or fields.get("host") or ""
    share = share.strip("/")
    if share and server:
        return share + " on " + server, scheme
    if server:
        return server, scheme
    return name, scheme


TRUSTED_BIN_DIRS = ("/usr/bin", "/bin", "/usr/local/bin")
MAX_CAPTURE_BYTES = 1 << 20
TRUSTED_ENV_PASSTHROUGH = (
    "DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")
UNSAFE_WRITE_BITS = stat.S_IWGRP | stat.S_IWOTH


def trusted_node(st):
    return st.st_uid == 0 and not (st.st_mode & UNSAFE_WRITE_BITS)


def trusted_directory_chain(directory):
    current = os.path.abspath(directory)
    while True:
        try:
            st = os.lstat(current)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            return False
        if not trusted_node(st):
            return False
        parent = os.path.dirname(current)
        if parent == current:
            return True
        current = parent


def trusted_program(name):
    program = str(name or "")
    if not program or "/" in program or program in (".", ".."):
        raise FileNotFoundError(errno.ENOENT, "invalid program name", program)
    for directory in TRUSTED_BIN_DIRS:
        candidate = os.path.join(directory, program)
        try:
            st = os.lstat(candidate)
        except OSError:
            continue
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
            continue
        if not trusted_node(st) or not (st.st_mode & stat.S_IXUSR):
            continue
        if os.path.realpath(candidate) != candidate:
            continue
        if not trusted_directory_chain(directory):
            continue
        return candidate
    raise FileNotFoundError(errno.ENOENT, "no trusted executable found", program)


def trusted_env():
    env = {"PATH": "/usr/bin:/bin", "HOME": HOME, "LC_ALL": "C.UTF-8"}
    for key in TRUSTED_ENV_PASSTHROUGH:
        value = os.environ.get(key)
        if value:
            env[key] = value
    return env


def kill_process_group(proc):
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.kill()
        except OSError:
            pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def run_trusted(name, args, stdin_text=None, timeout=30, limit=MAX_CAPTURE_BYTES, extra_env=None, raw=False):
    program = trusted_program(name)
    argv = [program] + list(args)
    env = trusted_env()
    if extra_env:
        env.update(extra_env)
    proc = subprocess.Popen(
        argv,
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        shell=False,
        close_fds=True,
        start_new_session=True)
    pending = stdin_text.encode("utf-8", "replace") if stdin_text is not None else b""
    captured_out = bytearray()
    captured_err = bytearray()
    buffers = {proc.stdout: captured_out, proc.stderr: captured_err}
    open_readers = [proc.stdout, proc.stderr]
    deadline = time.monotonic() + timeout
    try:
        while open_readers or pending:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            writers = [proc.stdin] if pending and proc.stdin else []
            readable, writable, _ = select.select(
                open_readers, writers, [], min(remaining, 0.5))
            for stream in writable:
                try:
                    written = os.write(stream.fileno(), pending)
                    pending = pending[written:]
                except (BrokenPipeError, OSError):
                    pending = b""
                if not pending:
                    try:
                        stream.close()
                    except OSError:
                        pass
                    proc.stdin = None
            for stream in readable:
                chunk = os.read(stream.fileno(), 65536)
                if not chunk:
                    open_readers.remove(stream)
                    continue
                buffer = buffers[stream]
                if len(buffer) < limit:
                    buffer.extend(chunk[:limit - len(buffer)])
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(argv, timeout)
        proc.wait(timeout=remaining)
    except BaseException:
        kill_process_group(proc)
        raise
    finally:
        pending = b""
        for stream in (proc.stdin, proc.stdout, proc.stderr):
            if stream is not None:
                try:
                    stream.close()
                except OSError:
                    pass
    if raw:
        return subprocess.CompletedProcess(argv, proc.returncode, bytes(captured_out), bytes(captured_err))
    return subprocess.CompletedProcess(
        argv, proc.returncode,
        captured_out.decode("utf-8", "replace"),
        captured_err.decode("utf-8", "replace"))


def gvfs_mounts():
    out = []
    try:
        entries = sorted(os.listdir(to_bytes(GVFS_ROOT)))
    except OSError:
        return out
    for raw in entries:
        name = to_str(raw)
        target = os.path.join(GVFS_ROOT, name)
        label, scheme = gvfs_label(name)
        fields = gvfs_fields(name)
        free = None
        total = None
        try:
            st = os.statvfs(to_bytes(target))
            total = st.f_frsize * st.f_blocks
            free = st.f_frsize * st.f_bavail
        except OSError:
            pass
        out.append({
            "name": label, "path": target, "label": label, "size": total,
            "fstype": scheme, "mount": target, "removable": False,
            "network": True, "gvfs": True, "free": free, "total": total,
            "host": fields.get("host") or fields.get("server") or "", "user": fields.get("user") or "",
            "port": fields.get("port") or "",
        })
    return out


DESKTOP_ID = "xyzlab.omafile.desktop"
DESKTOP_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "applications")
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OPEN_BIN = os.path.join(PLUGIN_DIR, "bin", "omafile-open")
ICON_FILE = os.path.join(PLUGIN_DIR, "icon.png")
DESKTOP_TEMPLATE = """[Desktop Entry]
Type=Application
Name=Omafile
Comment=Browse your files
Exec={open_bin} %f
Icon={icon}
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
StartupNotify=false
"""


def desktop_icon():
    if os.path.exists(ICON_FILE):
        return ICON_FILE
    return "system-file-manager"


def desktop_body():
    return DESKTOP_TEMPLATE.format(open_bin=OPEN_BIN, icon=desktop_icon())


def current_default_handler():
    return gio_default_app("inode/directory")


def set_folder_handler(handler):
    try:
        return run_gio_mime(["mime", "inode/directory", handler]).returncode == 0
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False


def refresh_desktop_database():
    try:
        subprocess.run(
            ["update-desktop-database", DESKTOP_DIR],
            capture_output=True, text=True, timeout=20, shell=False)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


DBUS_SERVICE_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "dbus-1", "services")
DBUS_SERVICE_NAME = "org.freedesktop.FileManager1.service"
FILEMANAGER1_BIN = os.path.join(PLUGIN_DIR, "bin", "omafile-filemanager1")


def filemanager1_available():
    if not os.path.exists(FILEMANAGER1_BIN):
        return False
    try:
        subprocess.run(
            [sys.executable, "-c", "import gi; gi.require_version('Gio','2.0'); from gi.repository import Gio"],
            capture_output=True, timeout=10, shell=False, check=True)
    except (FileNotFoundError, subprocess.TimeoutExpired, subprocess.CalledProcessError):
        return False
    return True


def install_filemanager1():
    if not filemanager1_available():
        return False
    body = "[D-BUS Service]\nName=org.freedesktop.FileManager1\nExec=%s\n" % FILEMANAGER1_BIN
    try:
        os.makedirs(DBUS_SERVICE_DIR, exist_ok=True)
        with open(os.path.join(DBUS_SERVICE_DIR, DBUS_SERVICE_NAME), "w", encoding="utf-8") as f:
            f.write(body)
    except OSError:
        return False
    return True


def remove_filemanager1():
    try:
        os.unlink(os.path.join(DBUS_SERVICE_DIR, DBUS_SERVICE_NAME))
    except OSError:
        pass


def filemanager1_installed():
    return os.path.exists(os.path.join(DBUS_SERVICE_DIR, DBUS_SERVICE_NAME))


def refresh_stale_desktop_entry():
    desktop_path = os.path.join(DESKTOP_DIR, DESKTOP_ID)
    wanted = desktop_body()
    try:
        with open(desktop_path, "r", encoding="utf-8") as f:
            if f.read() == wanted:
                return
    except OSError:
        return
    try:
        with open(desktop_path, "w", encoding="utf-8") as f:
            f.write(wanted)
    except OSError:
        return
    refresh_desktop_database()


def op_defaultfm(req):
    req_id = req["id"]
    refresh_stale_desktop_entry()
    handler = current_default_handler()
    if (handler != DESKTOP_ID
            and os.path.exists(os.path.join(DESKTOP_DIR, DESKTOP_ID))
            and set_folder_handler(DESKTOP_ID)):
        handler = current_default_handler()
    emit({
        "id": req_id, "t": "done",
        "handler": handler,
        "isOmafile": handler == DESKTOP_ID,
        "installed": os.path.exists(os.path.join(DESKTOP_DIR, DESKTOP_ID)),
        "showItems": filemanager1_installed(),
        "showItemsAvailable": filemanager1_available(),
    })


def op_setdefaultfm(req, cancel_event):
    req_id = req["id"]
    enabled = bool(req.get("enabled", False))
    previous = req.get("previous")
    if not isinstance(previous, str) or not DESKTOP_ID_RE.match(previous):
        previous = ""
    desktop_path = os.path.join(DESKTOP_DIR, DESKTOP_ID)
    try:
        trusted_program("gio")
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    if enabled:
        was = current_default_handler()
        try:
            os.makedirs(DESKTOP_DIR, exist_ok=True)
            with open(desktop_path, "w", encoding="utf-8") as f:
                f.write(desktop_body())
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), desktop_path)
            return
        refresh_desktop_database()
        if not set_folder_handler(DESKTOP_ID):
            send_error(req_id, "EUNSUPPORTED", "could not set the default handler")
            return
        show_items = install_filemanager1()
        emit({"id": req_id, "t": "done", "handler": current_default_handler(),
              "isOmafile": current_default_handler() == DESKTOP_ID,
              "showItems": show_items,
              "showItemsAvailable": filemanager1_available(),
              "previous": was if was != DESKTOP_ID else previous})
        return
    restore = previous if previous and previous != DESKTOP_ID else "org.gnome.Nautilus.desktop"
    set_folder_handler(restore)
    try:
        os.unlink(desktop_path)
    except OSError:
        pass
    remove_filemanager1()
    refresh_desktop_database()
    emit({"id": req_id, "t": "done", "handler": current_default_handler(),
          "isOmafile": current_default_handler() == DESKTOP_ID,
          "showItems": False, "previous": ""})


RECENT_FILE = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "recently-used.xbel")


def recent_rows(limit):
    try:
        tree = xml.etree.ElementTree.parse(RECENT_FILE)
    except (OSError, xml.etree.ElementTree.ParseError):
        return []
    marks = []
    for bookmark in tree.getroot().findall("bookmark"):
        href = bookmark.get("href") or ""
        if not href.startswith("file://"):
            continue
        raw = percent_decode(href[7:])
        marks.append((bookmark.get("visited") or bookmark.get("modified") or "", raw))
    marks.sort(key=lambda item: item[0], reverse=True)
    rows = []
    seen = set()
    for visited, path_bytes in marks:
        if path_bytes in seen:
            continue
        seen.add(path_bytes)
        try:
            lst = os.lstat(path_bytes)
        except OSError:
            continue
        path_str = to_str(path_bytes)
        kind, size, link_target = classify(path_bytes, lst)
        rows.append([
            os.path.basename(path_str) or path_str, kind, size,
            int(lst.st_mtime), lst.st_mode, link_target, path_str,
        ])
        if len(rows) >= limit:
            break
    return rows


def op_recent(req, cancel_event):
    req_id = req["id"]
    try:
        limit = int(req.get("limit") or 200)
    except (TypeError, ValueError):
        limit = 200
    rows = recent_rows(max(1, limit))
    chunk_size = 200
    for i in range(0, len(rows), chunk_size):
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        emit({"id": req_id, "t": "entries", "c": rows[i:i + chunk_size]})
    send_done(req_id, total=len(rows))


def op_netdiscover(req):
    req_id = req["id"]
    found = []
    try:
        proc = run_trusted("gio", ["list", "-u", "network:///"], timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        emit({"id": req_id, "t": "drives", "drives": found})
        send_done(req_id)
        return
    for line in (proc.stdout or "").splitlines():
        parts = line.split("\t")
        name = parts[0].strip()
        uri = parts[-1].strip() if len(parts) > 1 else ""
        if not name:
            continue
        if not uri or not uri.startswith(("smb://", "sftp://", "ftp://", "dav://", "davs://", "nfs://")):
            uri = "network:///" + name
        found.append({"name": name, "label": name, "uri": uri, "network": True})
    emit({"id": req_id, "t": "drives", "drives": found})
    send_done(req_id)


def op_netmounts(req):
    emit({"id": req["id"], "t": "drives", "drives": gvfs_mounts()})
    send_done(req["id"])


def gio_local_folder(uri):
    try:
        proc = run_trusted("gio", ["info", "-a", "standard::type", uri], timeout=15)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in (proc.stdout or "").splitlines():
        if line.startswith("local path:"):
            local = line.split(":", 1)[1].strip()
            local_bytes = to_bytes(local)
            if os.path.isdir(local_bytes):
                return local
            if os.path.exists(local_bytes):
                return to_str(os.path.dirname(local_bytes))
    return ""

def op_mounturi(req, cancel_event):
    req_id = req["id"]
    uri = req.get("uri")
    if not isinstance(uri, str) or not uri.strip():
        send_error(req_id, "EINVAL", "address required")
        return
    uri = uri.strip()
    anonymous = bool(req.get("anonymous", False))
    user = str(req.get("user") or "")
    domain = str(req.get("domain") or "")
    password = str(req.get("password") or "")
    before = set(m["mount"] for m in gvfs_mounts())
    if anonymous:
        answers = "\n\n\n\n"
    else:
        answers = user + "\n" + domain + "\n" + password + "\n"
    try:
        proc = run_trusted("gio", ["mount", uri], stdin_text=answers, timeout=40)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "the server did not respond")
        return
    message = (proc.stderr or proc.stdout or "").strip()
    after = gvfs_mounts()
    fresh = [m for m in after if m["mount"] not in before]
    if proc.returncode != 0 and not fresh:
        if "already mounted" in message.lower():
            match = [m for m in after if uri.rstrip("/").endswith(m["label"].split(" on ")[0])]
            target = gio_local_folder(uri) or (match[0]["mount"] if match else "")
            emit({"id": req_id, "t": "done", "path": target, "mounts": after, "message": "already connected"})
            return
        send_error(req_id, "EMOUNT", message or "could not connect")
        return
    target = gio_local_folder(uri) or (fresh[0]["mount"] if fresh else "")
    emit({"id": req_id, "t": "done", "path": target, "mounts": after, "message": message})


def op_unmounturi(req, cancel_event):
    req_id = req["id"]
    target = req.get("path") or req.get("uri")
    if not isinstance(target, str) or not target.strip():
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        proc = run_trusted("gio", ["mount", "-u", target.strip()], timeout=30)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "unmount timed out")
        return
    if proc.returncode != 0:
        send_error(req_id, "EMOUNT", (proc.stderr or proc.stdout or "could not disconnect").strip())
        return
    emit({"id": req_id, "t": "done", "mounts": gvfs_mounts()})


NETWORK_FILESYSTEMS = frozenset([
    "cifs", "smb3", "nfs", "nfs4", "sshfs", "fuse.sshfs", "davfs", "fuse.rclone",
    "fuse.gvfsd-fuse", "9p", "ceph", "glusterfs",
])

USER_VOLUME_ROOTS = ("/mnt", "/media", "/run/media")

PSEUDO_FILESYSTEMS = frozenset([
    "proc", "sysfs", "devtmpfs", "devpts", "cgroup", "cgroup2", "securityfs",
    "pstore", "bpf", "configfs", "debugfs", "tracefs", "fusectl", "mqueue",
    "hugetlbfs", "autofs", "binfmt_misc", "efivarfs", "ramfs", "squashfs",
])


def is_user_volume(target, fstype):
    if not target or target == "/":
        return False
    if fstype in PSEUDO_FILESYSTEMS:
        return False
    for root in USER_VOLUME_ROOTS:
        if target == root:
            return False
        if target.startswith(root + "/"):
            return True
    return False


CLIP_TIMEOUT = 3.0
CLIP_IMAGE_TYPES = ("image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp")
CLIP_IMAGE_EXT = {"image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "image/gif": "gif", "image/bmp": "bmp"}

CLIP_LIST_LIMIT = 1024 * 1024
CLIP_PATH_LIMIT = 20000
CLIP_TEXT_LIMIT = 64 * 1024
CLIP_TEXT_TYPES = ("text/plain;charset=utf-8", "UTF8_STRING", "text/plain", "TEXT", "STRING")


def wl_paste(args, limit=16 * 1024 * 1024):
    try:
        out = run_trusted("wl-paste", args, timeout=CLIP_TIMEOUT, limit=limit + 1, raw=True)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return b""
    if len(out.stdout) > limit:
        return None
    return out.stdout


def clip_types():
    listed = wl_paste(["--list-types"], limit=64 * 1024)
    if listed is None:
        return None
    return listed.decode("utf-8", "replace").split()

def unique_child(dest, stem, ext):
    candidate = os.path.join(dest, "%s.%s" % (stem, ext))
    n = 2
    while os.path.lexists(candidate):
        candidate = os.path.join(dest, "%s %d.%s" % (stem, n, ext))
        n += 1
    return candidate

def op_clipimage(req):
    req_id = req["id"]
    dest = req.get("dest")
    mime = req.get("type")
    if not isinstance(dest, str) or mime not in CLIP_IMAGE_EXT:
        send_error(req_id, "EINVAL", "dest and an image type are required")
        return
    if not os.path.isdir(to_bytes(dest)):
        send_error(req_id, "ENOTDIR", "dest is not a directory", dest)
        return
    data = wl_paste(["--type", mime], limit=256 * 1024 * 1024)
    if not data:
        send_error(req_id, "ENOENT", "the clipboard has no image")
        return
    target = unique_child(dest, "Pasted image", CLIP_IMAGE_EXT[mime])
    try:
        fd = os.open(to_bytes(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), target)
        return
    emit({"id": req_id, "t": "clipimage", "path": target})
    send_done(req_id)


def file_uri(path):
    from urllib.parse import quote
    return "file://" + quote(path, safe="/-._~!$&'()*+,;=:@")


def uri_to_path(uri):
    from urllib.parse import unquote, urlsplit
    uri = uri.strip()
    if not uri or uri.startswith("#"):
        return None
    parts = urlsplit(uri)
    if parts.scheme != "file" or parts.netloc not in ("", "localhost"):
        return None
    return unquote(parts.path)


def clipboard_payload(mode, paths):
    uris = [file_uri(x) for x in paths if isinstance(x, str)]
    if mode == "cut":
        return "x-special/gnome-copied-files", "cut\n" + "\n".join(uris)
    return "text/uri-list", "\r\n".join(uris) + "\r\n"


def parse_gnome_copied_files(text):
    lines = text.splitlines()
    mode = "copy"
    if lines and lines[0].strip() in ("copy", "cut"):
        mode = lines[0].strip()
        lines = lines[1:]
    return mode, [x for x in (uri_to_path(u) for u in lines) if x]


def op_clipset(req):
    req_id = req["id"]
    mode = req.get("mode")
    paths = req.get("paths") or []
    if mode not in ("copy", "cut") or not paths:
        send_error(req_id, "EINVAL", "mode and paths are required")
        return
    mime, data = clipboard_payload(mode, paths)
    try:
        subprocess.run([trusted_program("wl-copy"), "--type", mime], input=data.encode("utf-8"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=trusted_env(), timeout=5)
    except (OSError, FileNotFoundError, subprocess.TimeoutExpired) as e:
        send_error(req_id, "EUNSUPPORTED", str(e))
        return
    send_done(req_id)


def op_clipget(req):
    req_id = req["id"]
    types = clip_types()
    if types is None:
        send_error(req_id, "EUNSUPPORTED", "the clipboard did not answer")
        return
    mode = "copy"
    paths = []
    body = None
    if "x-special/gnome-copied-files" in types:
        body = wl_paste(["--no-newline", "--type", "x-special/gnome-copied-files"], limit=CLIP_LIST_LIMIT)
    elif "text/uri-list" in types:
        body = wl_paste(["--no-newline", "--type", "text/uri-list"], limit=CLIP_LIST_LIMIT)
    if body is None and ("x-special/gnome-copied-files" in types or "text/uri-list" in types):
        send_error(req_id, "E2BIG", "the copied file list is too large")
        return
    if body:
        text = body.decode("utf-8", "replace")
        if "x-special/gnome-copied-files" in types:
            mode, paths = parse_gnome_copied_files(text)
        else:
            paths = [x for x in (uri_to_path(u) for u in text.splitlines()) if x]
    if len(paths) > CLIP_PATH_LIMIT:
        send_error(req_id, "E2BIG", "the copied file list is too large")
        return
    send_done(req_id, mode=mode, paths=paths,
              image="" if paths else next((mime for mime in CLIP_IMAGE_TYPES if mime in types), ""))


def op_cliptext(req):
    req_id = req["id"]
    types = clip_types()
    if types is None:
        send_error(req_id, "EUNSUPPORTED", "the clipboard did not answer")
        return
    mime = next((t for t in CLIP_TEXT_TYPES if t in types), None)
    if mime is None:
        send_done(req_id, text="")
        return
    try:
        limit = max(1, min(int(req.get("limit") or CLIP_TEXT_LIMIT), EDIT_LIMIT))
    except (TypeError, ValueError):
        limit = CLIP_TEXT_LIMIT
    data = wl_paste(["--no-newline", "--type", mime], limit=limit)
    if data is None:
        send_error(req_id, "E2BIG", "the copied text is too long to paste here")
        return
    send_done(req_id, text=data.decode("utf-8", "replace"))


def op_clipclear(req):
    try:
        subprocess.run([trusted_program("wl-copy"), "--clear"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, env=trusted_env(), timeout=3)
    except (OSError, FileNotFoundError, subprocess.TimeoutExpired):
        pass
    send_done(req["id"])


def op_samedev(req):
    req_id = req["id"]
    try:
        a = os.lstat(to_bytes(req.get("path") or ""))
        b = os.stat(to_bytes(req.get("dest") or ""))
        send_done(req_id, same=a.st_dev == b.st_dev)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e))


UNMOUNTABLE_FSTYPES = frozenset([
    "swap", "crypto_LUKS", "LVM2_member", "linux_raid_member", "zfs_member",
    "bcache", "ddf_raid_member", "isw_raid_member", "BitLocker",
])
SYSTEM_PARTITION_TYPES = {
    "efi_system": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b",
    "microsoft_reserved": "e3c9e316-0b5c-4db8-817d-f92df00215ae",
    "windows_recovery": "de94bba4-06d1-4d40-a16a-bfd50179d6ac",
    "bios_boot": "21686148-6449-6e6f-744e-656564454649",
}
HIDDEN_PARTTYPES = frozenset(SYSTEM_PARTITION_TYPES.values())


def mountable_device(dev):
    fstype = dev.get("fstype")
    if not fstype or fstype in UNMOUNTABLE_FSTYPES:
        return False
    if str(dev.get("parttype") or "").lower() in HIDDEN_PARTTYPES:
        return False
    return str(dev.get("path") or "").startswith("/dev/")


def locked_container(dev):
    if dev.get("fstype") != "crypto_LUKS" or dev.get("children"):
        return False
    if str(dev.get("parttype") or "").lower() in HIDDEN_PARTTYPES:
        return False
    return str(dev.get("path") or "").startswith("/dev/")


def crypto_container(blockdevices, device):
    target = os.path.realpath(device)
    for dev in flatten_lsblk(blockdevices):
        if dev.get("fstype") != "crypto_LUKS":
            continue
        for child in dev.get("children") or []:
            path = str(child.get("path") or "")
            if path and (path == device or os.path.realpath(path) == target):
                return str(dev.get("path") or "")
    return ""


UNLOCKED_AS = re.compile(
    r"^Unlocked (/dev/\S+) as (/dev/\S+?)\.?$|Device (/dev/\S+) is already unlocked as (/dev/\S+?)\.?$", re.M)
WRONG_PASSPHRASE = ("incorrect passphrase", "no key available")


def unlocked_device(text, device):
    target = os.path.realpath(device)
    for match in UNLOCKED_AS.finditer(str(text or "")):
        source = match.group(1) or match.group(3)
        if source == device or os.path.realpath(source) == target:
            return match.group(2) or match.group(4)
    return ""


def udisks_message(text, fallback):
    message = str(text or "").strip()
    match = re.search(r"GDBus\.Error:[\w.]+: (.+)", message, re.S)
    if match:
        message = match.group(1).strip()
    return message or fallback


def valid_block_device(value):
    return isinstance(value, str) and value.startswith("/dev/") and ".." not in value


def udisks_mount(device):
    proc = run_trusted("udisksctl", ["mount", "-b", device], timeout=90)
    out = (proc.stdout or "").strip()
    if proc.returncode != 0:
        return None, (proc.stderr or out or "could not mount").strip()
    return (out.split(" at ", 1)[1].strip().rstrip(".") if " at " in out else ""), ""


def op_mountdev(req, cancel_event):
    req_id = req["id"]
    device = req.get("device")
    if not valid_block_device(device):
        send_error(req_id, "EINVAL", "block device required")
        return
    try:
        path, message = udisks_mount(device)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "udisksctl is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "mount timed out")
        return
    if path is None:
        send_error(req_id, "EMOUNT", message)
        return
    emit({"id": req_id, "t": "done", "path": path})


def op_unlockdev(req, cancel_event):
    req_id = req["id"]
    device = req.get("device")
    passphrase = req.get("passphrase")
    if not valid_block_device(device):
        send_error(req_id, "EINVAL", "block device required")
        return
    if not isinstance(passphrase, str) or not passphrase:
        send_error(req_id, "EINVAL", "passphrase required")
        return
    try:
        proc = run_trusted("udisksctl", ["unlock", "-b", device, "--key-file", "/dev/stdin"],
                           stdin_text=passphrase, timeout=120)
        cleartext = unlocked_device((proc.stdout or "") + "\n" + (proc.stderr or ""), device)
        if not valid_block_device(cleartext):
            message = udisks_message(proc.stderr or proc.stdout, "could not unlock")
            if any(hint in message.lower() for hint in WRONG_PASSPHRASE):
                send_error(req_id, "EPASSPHRASE", "wrong passphrase")
            else:
                send_error(req_id, "EUNLOCK", message)
            return
        path, message = udisks_mount(cleartext)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "udisksctl is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "unlock timed out")
        return
    emit({"id": req_id, "t": "done", "device": cleartext, "path": path or "",
          "message": udisks_message(message, "") if path is None else ""})


def op_unmountdev(req, cancel_event):
    req_id = req["id"]
    device = req.get("device")
    power_off = req.get("powerOff") is True
    if not valid_block_device(device):
        send_error(req_id, "EINVAL", "block device required")
        return
    try:
        proc = run_trusted("udisksctl", ["unmount", "-b", device], timeout=60)
        if proc.returncode != 0:
            send_error(req_id, "EMOUNT", (proc.stderr or proc.stdout or "could not unmount").strip())
            return
        tree = run_tool(["lsblk", "-J", "-o", "NAME,PATH,FSTYPE"])
        if not tree and os.path.realpath(device).startswith("/dev/dm-"):
            send_error(req_id, "ELOCK", "could not check whether the drive needs locking")
            return
        container = crypto_container(tree.get("blockdevices") if tree else None, device)
        if container:
            proc = run_trusted("udisksctl", ["lock", "-b", container], timeout=60)
            if proc.returncode != 0:
                send_error(req_id, "ELOCK", udisks_message(proc.stderr or proc.stdout, "could not lock"))
                return
        if power_off:
            proc = run_trusted("udisksctl", ["power-off", "-b", container or device], timeout=60)
            if proc.returncode != 0:
                send_error(req_id, "EMOUNT", udisks_message(proc.stderr or proc.stdout, "could not power off"))
                return
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "udisksctl is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "unmount timed out")
        return
    emit({"id": req_id, "t": "done", "locked": bool(container)})


SPACE_LOCK = threading.Lock()
SPACE_PENDING = {}
SPACE_CACHE = {}
SPACE_TIMEOUT = 1.5


def guarded_space(targets):
    waits = []
    with SPACE_LOCK:
        for target in dict.fromkeys(targets):
            worker = SPACE_PENDING.get(target)
            if worker is None:
                worker = threading.Thread(target=space_worker, args=(target,), daemon=True)
                SPACE_PENDING[target] = worker
                try:
                    worker.start()
                except RuntimeError:
                    SPACE_PENDING.pop(target, None)
                    continue
            waits.append(worker)
    deadline = time.monotonic() + SPACE_TIMEOUT
    for worker in waits:
        worker.join(max(0, deadline - time.monotonic()))
    result = {}
    with SPACE_LOCK:
        for target in targets:
            if target not in SPACE_PENDING and SPACE_CACHE.get(target):
                result[target] = SPACE_CACHE[target]
        if len(SPACE_CACHE) > 4096:
            SPACE_CACHE.clear()
    return result


def space_worker(target):
    try:
        st = os.statvfs(to_bytes(target))
        value = (st.f_frsize * st.f_blocks, st.f_frsize * st.f_bavail)
    except OSError:
        value = None
    with SPACE_LOCK:
        SPACE_CACHE[target] = value
        SPACE_PENDING.pop(target, None)


def op_drives(req):
    req_id = req["id"]
    drives = []
    lsblk_data = run_tool(["lsblk", "-J", "-b", "-o", "NAME,PATH,LABEL,SIZE,FSTYPE,MOUNTPOINT,RM,PARTTYPE"])
    findmnt_data = run_tool(["findmnt", "-J", "-b"])
    space_by_mount = {}
    mounted_volumes = []
    if findmnt_data:
        def walk(fs_list, depth):
            if depth > 64:
                return
            for fs in fs_list or []:
                tgt = fs.get("target")
                if isinstance(tgt, str) and tgt:
                    mounted_volumes.append((tgt, fs.get("source"), fs.get("fstype")))
                walk(fs.get("children"), depth + 1)
        walk(findmnt_data.get("filesystems"), 0)
        space_by_mount = guarded_space([t for t, _, _ in mounted_volumes])
    if lsblk_data:
        for dev in flatten_lsblk(lsblk_data.get("blockdevices")):
            mount = dev.get("mountpoint")
            if dev.get("fstype") == "crypto_LUKS" and dev.get("rm"):
                for child in dev.get("children") or []:
                    child["rm"] = True
            total = None
            free = None
            if mount and mount in space_by_mount:
                total, free = space_by_mount[mount]
            drives.append({
                "name": dev.get("name"), "path": dev.get("path"), "label": dev.get("label"),
                "size": dev.get("size"), "fstype": dev.get("fstype"), "mount": mount,
                "removable": bool(dev.get("rm")), "free": free, "total": total,
                "mountable": not mount and mountable_device(dev),
                "locked": not mount and locked_container(dev),
            })
    seen_mounts = set(d["mount"] for d in drives if d.get("mount"))
    for target, source, fstype in mounted_volumes:
        if target in seen_mounts:
            continue
        if not is_user_volume(target, fstype):
            continue
        total = None
        free = None
        if target in space_by_mount:
            total, free = space_by_mount[target]
        drives.append({
            "name": os.path.basename(target) or target, "path": target,
            "label": os.path.basename(target) or target, "size": total,
            "fstype": fstype, "mount": target, "removable": False,
            "network": fstype in NETWORK_FILESYSTEMS,
            "free": free, "total": total,
        })
        seen_mounts.add(target)
    for share in gvfs_mounts():
        if share["mount"] in seen_mounts:
            continue
        drives.append(share)
        seen_mounts.add(share["mount"])
    emit({"id": req_id, "t": "drives", "drives": drives})
    send_done(req_id)

XDG_DEFAULTS = {
    "desktop": "Desktop", "documents": "Documents", "downloads": "Downloads",
    "music": "Music", "pictures": "Pictures", "videos": "Videos",
    "templates": "Templates", "publicshare": "Public",
}
XDG_KEYS = {
    "XDG_DESKTOP_DIR": "desktop", "XDG_DOCUMENTS_DIR": "documents",
    "XDG_DOWNLOAD_DIR": "downloads", "XDG_MUSIC_DIR": "music",
    "XDG_PICTURES_DIR": "pictures", "XDG_VIDEOS_DIR": "videos",
    "XDG_TEMPLATES_DIR": "templates", "XDG_PUBLICSHARE_DIR": "publicshare",
}

def op_dirs(req):
    req_id = req["id"]
    result = {}
    for key, name in XDG_DEFAULTS.items():
        result[key] = os.path.join(HOME, name)
    config_file = os.path.join(HOME, ".config", "user-dirs.dirs")
    try:
        with open(config_file, "r", encoding="utf-8", errors="surrogateescape") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                if k not in XDG_KEYS:
                    continue
                v = v.strip().strip('"')
                v = v.replace("$HOME", HOME)
                result[XDG_KEYS[k]] = v
    except OSError:
        pass
    dirs = {}
    for key, path in result.items():
        try:
            if os.path.exists(to_bytes(path)):
                dirs[key] = path
        except OSError:
            pass
    emit({"id": req_id, "t": "dirs", "dirs": dirs})
    send_done(req_id)

def op_ping(req):
    send_done(req["id"], version=VERSION, pid=os.getpid(), inotify=INOTIFY_AVAILABLE)

def op_cancel(req):
    req_id = req["id"]
    target = req.get("target")
    ev = None
    with INFLIGHT_LOCK:
        info = INFLIGHT.get(target)
        if info:
            ev = info["cancel"]
    if ev is not None:
        ev.set()
    else:
        handle = None
        key = None
        with WATCH_LOCK:
            for pth, h in WATCHES.items():
                if h.req_id == target:
                    handle = h
                    key = pth
                    break
            if key is not None:
                del WATCHES[key]
        if handle:
            stop_watch(handle, cancelled=True)
    send_done(req_id)

PLUGIN_ENTRY_ID = "xyzlab.omafile"
SHELL_CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
    "omarchy", "shell.json")
BAR_SECTIONS = ("left", "center", "right")


def read_shell_config():
    with open(SHELL_CONFIG_PATH, "r", encoding="utf-8") as f:
        config = json.load(f)
    if not isinstance(config, dict):
        raise ValueError("shell.json is not an object")
    return config


def write_shell_config(config):
    directory = os.path.dirname(SHELL_CONFIG_PATH)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".omafile-shell-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, SHELL_CONFIG_PATH)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def bar_sections(config):
    bar = config.get("bar")
    if not isinstance(bar, dict):
        return []
    layout = bar.get("layout")
    if not isinstance(layout, dict):
        return []
    out = []
    for name in BAR_SECTIONS:
        arr = layout.get(name)
        if isinstance(arr, list):
            out.append((name, arr))
    return out


def omafile_entries(config):
    found = []
    for name, arr in bar_sections(config):
        for index, entry in enumerate(arr):
            if isinstance(entry, dict) and entry.get("id") == PLUGIN_ENTRY_ID:
                found.append((name, arr, index, entry))
    return found


TRASH_ENTRY_KEYS = ("trashConfirm",)


def is_trash_entry(entry):
    return str(entry.get("mode", "")).lower() == "trash"


def bar_state(config):
    entries = omafile_entries(config)
    return {
        "present": bool(entries),
        "trashIcon": any(is_trash_entry(e) for _, _, _, e in entries),
        "count": len(entries),
    }


SHELL_CONFIG_LOCK = threading.Lock()


def op_baricon(req):
    with SHELL_CONFIG_LOCK:
        update_bar_icon(req)


def op_barsettings(req):
    with SHELL_CONFIG_LOCK:
        update_bar_settings(req)


def update_bar_icon(req):
    req_id = req["id"]
    action = str(req.get("action") or "status")
    try:
        config = read_shell_config()
    except (OSError, ValueError) as e:
        send_error(req_id, "ENOENT", "could not read shell.json: %s" % e, SHELL_CONFIG_PATH)
        return

    if action == "status":
        state = bar_state(config)
        emit(dict({"id": req_id, "t": "baricon"}, **state))
        send_done(req_id)
        return

    if action not in ("add", "remove"):
        send_error(req_id, "EINVAL", "unknown action: %s" % action)
        return

    entries = omafile_entries(config)
    changed = False

    if action == "add":
        if not any(is_trash_entry(e) for _, _, _, e in entries):
            anchor = None
            for name, arr, index, entry in entries:
                if not is_trash_entry(entry):
                    anchor = (arr, index)
            new_entry = {"id": PLUGIN_ENTRY_ID, "mode": "trash", "trashConfirm": True}
            if anchor:
                anchor[0].insert(anchor[1] + 1, new_entry)
            else:
                sections = bar_sections(config)
                if not sections:
                    send_error(req_id, "EINVAL", "shell.json has no bar layout")
                    return
                sections[-1][1].append(new_entry)
            changed = True
    else:
        for name, arr, index, entry in reversed(entries):
            if is_trash_entry(entry):
                del arr[index]
                changed = True

    if changed:
        try:
            write_shell_config(config)
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), SHELL_CONFIG_PATH)
            return

    state = bar_state(config)
    emit(dict({"id": req_id, "t": "baricon", "changed": changed}, **state))
    send_done(req_id)


def update_bar_settings(req):
    req_id = req["id"]
    settings = req.get("settings")
    if not isinstance(settings, dict):
        send_error(req_id, "EINVAL", "settings must be an object")
        return
    try:
        config = read_shell_config()
    except (OSError, ValueError) as e:
        send_error(req_id, "ENOENT", "could not read shell.json: %s" % e, SHELL_CONFIG_PATH)
        return

    changed = False
    for name, arr, index, entry in omafile_entries(config):
        trash = is_trash_entry(entry)
        merged = dict(entry)
        for key, value in settings.items():
            if key in ("id", "mode"):
                continue
            if trash and key not in TRASH_ENTRY_KEYS:
                continue
            merged[key] = value
        if merged != entry:
            arr[index] = merged
            changed = True

    if changed:
        try:
            write_shell_config(config)
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), SHELL_CONFIG_PATH)
            return

    emit({"id": req_id, "t": "barsettings", "changed": changed})
    send_done(req_id)


ARCHIVE_SUFFIXES = (".tar.gz", ".tar.xz", ".tar.bz2", ".tar.zst", ".tar.lz", ".tar",
                    ".tgz", ".txz", ".tbz", ".tbz2", ".tzst", ".zip", ".7z", ".rar")


def archive_stem(name):
    lower = name.lower()
    for suffix in ARCHIVE_SUFFIXES:
        if lower.endswith(suffix) and len(name) > len(suffix):
            return name[:-len(suffix)]
    return os.path.splitext(name)[0] or name


def extract_argv(work_fd):
    return [trusted_program("bsdtar"), "-xvf", "-", "-C", "/proc/self/fd/%d" % work_fd]


def make_work_dir(dir_fd, prefix):
    while True:
        name = prefix + os.urandom(6).hex().encode()
        try:
            os.mkdir(name, 0o700, dir_fd=dir_fd)
            return name
        except FileExistsError:
            continue


def place_unique(src_name, src_fd, want, dst_fd, pick=None):
    while True:
        candidate = (pick or unique_name_at)(dst_fd, want)
        try:
            rename_noreplace(src_name, src_fd, candidate, dst_fd)
            return candidate
        except FileExistsError:
            continue


def archive_read_position(pid, archive):
    fd_dir = "/proc/%d/fd" % pid
    try:
        names = os.listdir(fd_dir)
    except OSError:
        return None
    best = None
    for name in names:
        try:
            if os.readlink(os.path.join(fd_dir, name)) != archive:
                continue
            with open("/proc/%d/fdinfo/%s" % (pid, name)) as f:
                for line in f:
                    if line.startswith("pos:"):
                        pos = int(line.split()[1])
                        best = pos if best is None else max(best, pos)
                        break
        except (OSError, ValueError, IndexError):
            continue
    return best


def run_bsdtar(argv, req_id, cancel_event, total, measure, on_entry=None, stdin_data=None,
               stdin_fd=None, stdout_fd=None, pass_fds=()):
    if stdin_data is not None:
        stdin = subprocess.PIPE
    elif stdin_fd is not None:
        stdin = stdin_fd
    else:
        stdin = subprocess.DEVNULL
    proc = subprocess.Popen(argv, stdin=stdin,
                            stdout=subprocess.DEVNULL if stdout_fd is None else stdout_fd,
                            stderr=subprocess.PIPE, env=trusted_env(),
                            close_fds=True, pass_fds=tuple(pass_fds), start_new_session=True)
    if stdin_data is not None:
        def feed():
            try:
                proc.stdin.write(stdin_data)
            except OSError:
                pass
            finally:
                try:
                    proc.stdin.close()
                except OSError:
                    pass
        threading.Thread(target=feed, daemon=True).start()
    stream = proc.stderr.fileno()
    pending = b""
    errors = []
    error_bytes = 0
    files = 0
    current = ""
    done_bytes = 0
    started = time.monotonic()
    last_report = started
    reading = True

    def take(line):
        nonlocal files, current, error_bytes
        text = line.decode("utf-8", "replace").rstrip("\r")
        if text.startswith("x ") or text.startswith("a "):
            files += 1
            current = text[2:]
            if on_entry:
                on_entry(current)
        elif text and error_bytes < MAX_CAPTURE_BYTES:
            errors.append(text)
            error_bytes += len(text)

    try:
        while True:
            if cancel_event.is_set():
                kill_process_group(proc)
                proc.wait()
                return -1, "cancelled"
            if reading:
                ready, _, _ = select.select([stream], [], [], 0.25)
                if ready:
                    chunk = os.read(stream, 65536)
                    if chunk:
                        lines = (pending + chunk).split(b"\n")
                        pending = lines.pop()
                        for line in lines:
                            take(line)
                    else:
                        reading = False
            elif proc.poll() is not None:
                break
            else:
                time.sleep(0.05)
            now = time.monotonic()
            if now - last_report >= 0.25:
                last_report = now
                measured = measure(proc.pid)
                if measured is not None:
                    done_bytes = max(done_bytes, min(measured, total))
                elapsed = now - started
                if pending.startswith(b"x ") or pending.startswith(b"a "):
                    current = pending[2:].decode("utf-8", "replace")
                emit({"id": req_id, "t": "progress", "bytes": done_bytes, "total": total,
                      "files": files, "filesTotal": 0, "current": current,
                      "rate": done_bytes / elapsed if elapsed > 0 else 0})
        if pending:
            take(pending)
        return proc.returncode, "\n".join(errors).strip()
    except BaseException:
        kill_process_group(proc)
        raise
    finally:
        proc.stderr.close()


def op_extract(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "an archive file is required")
        return
    try:
        pfd, arch_name = open_parent_safely(to_bytes(path))
    except OSError as e:
        send_error(req_id, "EINVAL" if e.errno == errno.ENOENT else errno_code(e), e.strerror or str(e), path)
        return
    arch_fd = None
    work_fd = None
    work_name = None

    def drop_work():
        nonlocal work_name
        if work_name is not None:
            try:
                shutil.rmtree(work_name, dir_fd=pfd)
            except OSError:
                pass
            work_name = None

    try:
        st = None
        try:
            arch_fd = os.open(arch_name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=pfd)
            st = os.fstat(arch_fd)
        except OSError:
            pass
        if st is None or not stat.S_ISREG(st.st_mode):
            send_error(req_id, "EINVAL", "an archive file is required", path)
            return
        os.set_blocking(arch_fd, True)
        work_name = make_work_dir(pfd, b".omafile-extract-")
        work_fd = os.open(work_name, PATH_OPEN_FLAGS | os.O_NOFOLLOW, dir_fd=pfd)
        try:
            argv = extract_argv(work_fd)
        except FileNotFoundError:
            send_error(req_id, "EUNSUPPORTED", "bsdtar is not installed", path)
            return
        real = os.readlink("/proc/self/fd/%d" % arch_fd)
        code, err = run_bsdtar(argv, req_id, cancel_event, st.st_size,
                               lambda pid: archive_read_position(pid, real),
                               stdin_fd=arch_fd, pass_fds=(work_fd,))
        if code != 0:
            drop_work()
            send_error(req_id, "ECANCELED" if code == -1 else "EFAIL", err or "could not extract", path)
            return
        items = os.listdir(fd_path(work_fd, b"."))
        if len(items) == 1:
            final = place_unique(items[0], work_fd, items[0], pfd)
        else:
            final = place_unique(work_name, pfd, to_bytes(archive_stem(os.path.basename(path))), pfd)
            work_name = None
        drop_work()
        send_done(req_id, path=to_str(os.path.join(to_bytes(os.path.dirname(path)), final)))
    except OSError as e:
        drop_work()
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
    finally:
        for fd in (arch_fd, work_fd):
            if fd is not None:
                os.close(fd)
        drop_work()
        os.close(pfd)


COMPRESS_SUFFIXES = (".zip", ".tar.xz", ".tar.gz", ".7z")


def compress_suffix(name):
    lower = name.lower()
    for suffix in COMPRESS_SUFFIXES:
        if lower.endswith(suffix) and len(name) > len(suffix):
            return name[-len(suffix):]
    return ""


COMPRESS_FORMATS = {
    ".zip": ["--format", "zip"],
    ".tar.xz": ["--format", "paxr", "-J"],
    ".tar.gz": ["--format", "paxr", "-z"],
    ".7z": ["--format", "7zip"],
}


def unique_archive_name(dir_fd, name):
    text = to_str(name)
    suffix = compress_suffix(text)
    stem = text[:-len(suffix)]
    candidate = text
    n = 1
    while lstat_at(dir_fd, to_bytes(candidate)) is not None:
        candidate = "%s (%d)%s" % (stem, n, suffix)
        n += 1
    return to_bytes(candidate)


def compress_sizes(parent_fd, names):
    sizes = {}
    for name in names:
        lst = os.lstat(name, dir_fd=parent_fd)
        sizes[to_str(name)] = lst.st_size if stat.S_ISREG(lst.st_mode) else 0
        if not stat.S_ISDIR(lst.st_mode):
            continue
        for dirpath, _, filenames, dirfd in os.fwalk(name, dir_fd=parent_fd, follow_symlinks=False):
            for child in filenames:
                child_lst = lstat_at(dirfd, child)
                if child_lst is not None and stat.S_ISREG(child_lst.st_mode):
                    sizes[to_str(os.path.join(dirpath, child))] = child_lst.st_size
    return sizes


def op_compress(req, cancel_event):
    req_id = req["id"]
    paths = req.get("paths")
    name = req.get("name")
    if (not isinstance(paths, list) or not paths or not all(isinstance(p, str) and os.path.isabs(p) for p in paths)
            or not isinstance(name, str) or not valid_leaf(to_bytes(name)) or not compress_suffix(name)):
        send_error(req_id, "EINVAL", "absolute paths and an archive name ending in .zip, .tar.xz, .tar.gz or .7z are required")
        return
    parent = os.path.dirname(os.path.normpath(paths[0]))
    names = []
    for p in paths:
        p = os.path.normpath(p)
        leaf = to_bytes(os.path.basename(p))
        if os.path.dirname(p) != parent or p == parent or not valid_leaf(leaf):
            send_error(req_id, "EINVAL", "every item must be in the same folder", p)
            return
        names.append(leaf)
    try:
        pfd = open_dir_safely(to_bytes(parent))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), parent)
        return
    work = None
    out_fd = None
    try:
        for leaf, p in zip(names, paths):
            if lstat_at(pfd, leaf) is None:
                send_error(req_id, "ENOENT", "no such file or directory", os.path.normpath(p))
                return
        suffix = compress_suffix(name)
        try:
            program = trusted_program("bsdtar")
        except FileNotFoundError:
            send_error(req_id, "EUNSUPPORTED", "bsdtar is not installed", parent)
            return
        sizes = compress_sizes(pfd, names)
        while True:
            work = b".omafile-compress-" + os.urandom(6).hex().encode() + to_bytes(suffix)
            try:
                out_fd = os.open(work, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=pfd)
                break
            except FileExistsError:
                continue
        argv = [program, "-cv"] + COMPRESS_FORMATS[suffix.lower()] + [
            "-f", "-", "-C", "/proc/self/fd/%d" % pfd, "--null", "-T", "-"]
        done = [0]

        def counted(entry):
            done[0] += sizes.get(entry, 0)

        code, err = run_bsdtar(argv, req_id, cancel_event, sum(sizes.values()), lambda pid: done[0],
                               on_entry=counted, stdin_data=b"".join(n + b"\0" for n in names),
                               stdout_fd=out_fd, pass_fds=(pfd,))
        os.close(out_fd)
        out_fd = None
        if code != 0:
            try:
                os.unlink(work, dir_fd=pfd)
            except OSError:
                pass
            work = None
            send_error(req_id, "ECANCELED" if code == -1 else "EFAIL", err or "could not compress", parent)
            return
        final = place_unique(work, pfd, to_bytes(name), pfd, pick=unique_archive_name)
        work = None
        send_done(req_id, path=to_str(os.path.join(to_bytes(parent), final)))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), parent)
    finally:
        if out_fd is not None:
            os.close(out_fd)
        if work is not None:
            try:
                os.unlink(work, dir_fd=pfd)
            except OSError:
                pass
        os.close(pfd)


TRANSCODE_TIMEOUT = 6 * 3600.0
TRANSCODE_PICTURE_SIZES = {"high": "3160x>", "medium": "2160x>", "low": "1080x>", "original": None, "lossless": None}
JXL_CODESTREAM = b"\xff\x0a"
JXL_CONTAINER = b"\0\0\0\x0cJXL \r\n\x87\n"
TRANSCODE_VIDEO_SIZES = {"4k": 2160, "1080p": 1080, "720p": 720, "original": None}
TRANSCODE_EVEN_SIZE = "scale=trunc(iw/2)*2:trunc(ih/2)*2"
TRANSCODE_FORMATS = {"picture": ("jpg", "png", "webp", "avif", "jxl"), "video": ("mp4", "gif")}
TRANSCODE_DEMUXERS = "mov,matroska,avi,mpegts,flv,mpeg"
TRANSCODE_IMAGE_LIMITS = ["-limit", "memory", "1GiB", "-limit", "map", "2GiB", "-limit", "disk", "4GiB",
                          "-limit", "area", "256MP", "-limit", "time", "900"]
HEIF_BRANDS = {b"heic": "HEIC", b"heix": "HEIC", b"hevc": "HEIC", b"hevx": "HEIC", b"heim": "HEIC",
               b"heis": "HEIC", b"mif1": "HEIC", b"msf1": "HEIC", b"avif": "AVIF", b"avis": "AVIF"}


def media_kind(head):
    if head.startswith(PNG_MAGIC):
        return "picture", "PNG"
    if head.startswith(b"\xff\xd8\xff"):
        return "picture", "JPEG"
    if head[:6] in (b"GIF87a", b"GIF89a"):
        return "picture", "GIF"
    if head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "picture", "WEBP"
    if head[:4] in (b"II*\0", b"MM\0*"):
        return "picture", "TIFF"
    if head[:2] == b"BM":
        return "picture", "BMP"
    if head.startswith(JXL_CODESTREAM) or head.startswith(JXL_CONTAINER):
        return "picture", "JXL"
    if head[4:8] == b"ftyp":
        brand = head[8:12]
        if brand in HEIF_BRANDS:
            return "picture", HEIF_BRANDS[brand]
        return "video", None
    if head[:4] == b"\x1aE\xdf\xa3" or (head[:4] == b"RIFF" and head[8:12] == b"AVI ") or head[:3] == b"FLV":
        return "video", None
    if head[:4] == b"\0\0\1\xba" or (len(head) > 188 and head[0] == 0x47 and head[188] == 0x47):
        return "video", None
    return None, None


def transcode_argv(kind, coder, fmt, resolution, in_fd, out_fd, programs):
    source = "/proc/self/fd/%d" % in_fd
    target = "/proc/self/fd/%d" % out_fd
    if kind == "picture" and resolution == "lossless":
        return [programs["cjxl"], source, target, "--lossless_jpeg=1", "--quiet"]
    if kind == "picture":
        argv = [programs["magick"]] + TRANSCODE_IMAGE_LIMITS + ["%s:%s[0]" % (coder, source), "-auto-orient"]
        if TRANSCODE_PICTURE_SIZES[resolution]:
            argv += ["-resize", TRANSCODE_PICTURE_SIZES[resolution]]
        if fmt == "jpg":
            return argv + ["-quality", "85", "-strip", "JPEG:" + target]
        if fmt == "webp":
            return argv + ["-quality", "82", "-define", "webp:method=6", "-strip", "WEBP:" + target]
        if fmt == "avif":
            return argv + ["-quality", "60", "-define", "heic:speed=6", "-strip", "AVIF:" + target]
        if fmt == "jxl":
            return argv + ["-quality", "85", "-strip", "JXL:" + target]
        return argv + ["-strip", "-define", "png:compression-filter=5", "-define", "png:compression-level=9",
                       "-define", "png:compression-strategy=1", "-define", "png:exclude-chunk=all", "PNG:" + target]
    height = TRANSCODE_VIDEO_SIZES[resolution]
    scale = "scale=-2:%d" % height if height else TRANSCODE_EVEN_SIZE
    argv = [programs["ffmpeg"], "-nostdin", "-v", "error", "-protocol_whitelist", "file",
            "-format_whitelist", TRANSCODE_DEMUXERS, "-i", source, "-map_metadata", "-1", "-map_chapters", "-1"]
    if fmt == "gif":
        return argv + ["-vf", "fps=10,%s:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" % scale,
                       "-f", "gif", "-y", target]
    if resolution == "4k":
        codec = ["-c:v", "libx265", "-preset", "slow", "-crf", "24"]
    else:
        codec = ["-c:v", "libx264", "-preset", "fast", "-crf", "23"]
    return argv + ["-vf", scale] + codec + ["-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart",
                                             "-f", "mp4", "-y", target]


def transcode_one(path, fmt, resolution, programs, cancel_event):
    real = resolve_trusted_leaf(to_bytes(path))
    pfd, leaf = open_parent_safely(to_bytes(path))
    in_fd = None
    out_fd = None
    work = None
    try:
        src_fd, src_leaf = open_parent_safely(real)
        try:
            in_fd = os.open(src_leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=src_fd)
        finally:
            os.close(src_fd)
        if not stat.S_ISREG(os.fstat(in_fd).st_mode):
            raise ValueError("not a regular file")
        os.set_blocking(in_fd, True)
        kind, coder = media_kind(os.pread(in_fd, 512, 0))
        if kind is None:
            raise ValueError("not a picture or video")
        if fmt not in TRANSCODE_FORMATS[kind]:
            raise ValueError("a %s cannot be made into %s" % (kind, fmt))
        if resolution not in (TRANSCODE_PICTURE_SIZES if kind == "picture" else TRANSCODE_VIDEO_SIZES):
            raise ValueError("%s is not a %s size" % (resolution, kind))
        if resolution == "lossless" and (fmt != "jxl" or coder != "JPEG"):
            raise ValueError("only a JPG can be repacked losslessly, and only as JPEG XL")
        if resolution == "lossless" and programs.get("cjxl") is None:
            raise FileNotFoundError(errno.ENOENT, "cjxl from libjxl is not installed")
        if resolution != "lossless" and programs.get("magick" if kind == "picture" else "ffmpeg") is None:
            raise FileNotFoundError(errno.ENOENT, "%s is not installed" % ("ImageMagick" if kind == "picture" else "ffmpeg"))
        while True:
            work = b".omafile-transcode-" + os.urandom(6).hex().encode() + b"." + fmt.encode()
            try:
                out_fd = os.open(work, os.O_CREAT | os.O_EXCL | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=pfd)
                break
            except FileExistsError:
                continue
        argv = transcode_argv(kind, coder, fmt, resolution, in_fd, out_fd, programs)
        code, _ = run_media(argv, (in_fd, out_fd), cancel_event, TRANSCODE_TIMEOUT, limit=0)
        if code is None:
            return None
        if code != 0 or os.fstat(out_fd).st_size == 0:
            raise ValueError("could not transcode this file")
        stem = os.path.splitext(to_str(leaf))[0] or to_str(leaf)
        final = place_unique(work, pfd, to_bytes("%s-%s.%s" % (stem, resolution, fmt)), pfd)
        work = None
        return to_str(os.path.join(os.path.dirname(to_bytes(os.path.normpath(path))), final))
    finally:
        for fd in (in_fd, out_fd):
            if fd is not None:
                os.close(fd)
        if work is not None:
            try:
                os.unlink(work, dir_fd=pfd)
            except OSError:
                pass
        os.close(pfd)


def op_transcode(req, cancel_event):
    req_id = req["id"]
    paths = req.get("paths")
    fmt = req.get("format")
    resolution = req.get("resolution")
    if (not isinstance(paths, list) or not paths or not all(isinstance(p, str) and os.path.isabs(p) for p in paths)
            or fmt not in ("jpg", "png", "webp", "avif", "jxl", "mp4", "gif")
            or resolution not in TRANSCODE_PICTURE_SIZES and resolution not in TRANSCODE_VIDEO_SIZES):
        send_error(req_id, "EINVAL", "absolute paths, a format and a size are required")
        return
    programs = {}
    for name in ("magick", "ffmpeg", "cjxl"):
        try:
            programs[name] = trusted_program(name)
        except FileNotFoundError:
            programs[name] = None
    outputs = []
    failures = []
    for index, path in enumerate(paths):
        if cancel_event.is_set():
            break
        emit({"id": req_id, "t": "progress", "files": index, "filesTotal": len(paths), "current": path})
        try:
            made = transcode_one(path, fmt, resolution, programs, cancel_event)
        except (OSError, ValueError) as e:
            failures.append({"path": path, "message": str(getattr(e, "strerror", None) or e)})
            continue
        if made is None:
            break
        outputs.append(made)
    if cancel_event.is_set():
        send_error(req_id, "ECANCELED", "stopped", paths[0])
        return
    emit({"id": req_id, "t": "progress", "files": len(paths), "filesTotal": len(paths), "current": ""})
    if not outputs:
        send_error(req_id, "EFAIL", failures[0]["message"] if failures else "nothing was transcoded", paths[0])
        return
    send_done(req_id, outputs=outputs, failures=failures)


OMARCHY_EDITOR_FILE = os.path.join(HOME, ".local", "state", "omarchy", "defaults", "editor")
OMARCHY_AGENT_FILE = os.path.join(HOME, ".config", "omarchy", "defaults", "agent")
OMARCHY_DEFAULT_EDITOR = "nvim"
DEFAULT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$")
PROGRAM_CHECK_LIMIT = 64


def read_omarchy_default(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return ""
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return ""
        data = os.read(fd, 4096)
    except OSError:
        return ""
    finally:
        os.close(fd)
    lines = data.decode("utf-8", "replace").splitlines()
    value = lines[0].strip() if lines else ""
    return value if DEFAULT_NAME_RE.match(value) else ""


def program_found(name, search_path):
    if not isinstance(name, str) or not name or len(name) > 4096 or "\0" in name:
        return False
    if name.startswith("~/"):
        name = os.path.join(HOME, name[2:])
    if "/" in name:
        return os.path.isabs(name) and os.path.isfile(name) and os.access(name, os.X_OK)
    return shutil.which(name, path=search_path) is not None


def op_defaults(req):
    req_id = req["id"]
    names = req.get("names") or []
    if not isinstance(names, list) or len(names) > PROGRAM_CHECK_LIMIT or not all(isinstance(n, str) for n in names):
        send_error(req_id, "EINVAL", "names must be a list of at most %d strings" % PROGRAM_CHECK_LIMIT)
        return
    search_path = os.environ.get("PATH") or "/usr/bin:/bin"
    agent = read_omarchy_default(OMARCHY_AGENT_FILE)
    emit({"id": req_id, "t": "defaults",
          "editor": read_omarchy_default(OMARCHY_EDITOR_FILE) or OMARCHY_DEFAULT_EDITOR,
          "agent": agent, "agentFound": bool(agent) and program_found(agent, search_path),
          "found": {name: program_found(name, search_path) for name in names}})
    send_done(req_id)


EDIT_LIMIT = 1 << 20
EDIT_WRITE_LIMIT = 8 << 20
EDIT_LINE_LIMIT = 20000
UTF8_BOM = b"\xef\xbb\xbf"


def file_identity(st):
    return {"ino": str(st.st_ino), "dev": str(st.st_dev), "mtimeNs": str(st.st_mtime_ns), "size": st.st_size}


def same_identity(st, expect):
    return (isinstance(expect, dict) and str(st.st_ino) == str(expect.get("ino"))
            and str(st.st_dev) == str(expect.get("dev")) and str(st.st_mtime_ns) == str(expect.get("mtimeNs"))
            and st.st_size == expect.get("size"))


def resolve_trusted_leaf(path_bytes):
    mounts = None
    current = os.path.normpath(path_bytes)
    for _ in range(MAX_LINK_HOPS):
        pfd, leaf = open_parent_safely(current)
        try:
            lst = lstat_at(pfd, leaf)
            base = real_dir(pfd)
            if lst is None or not stat.S_ISLNK(lst.st_mode):
                return os.path.join(base, leaf)
            if mounts is None:
                mounts = mount_entries()
            target = trusted_link_target(pfd, leaf, mounts, "this is a link Omafile will not follow", current)
            if target is None:
                return os.path.join(base, leaf)
        finally:
            os.close(pfd)
        current = os.path.normpath(target if target.startswith(b"/") else os.path.join(base, target))
    raise OSError(errno.ELOOP, "too many links", to_str(path_bytes))


def op_readtext(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str) or not path.startswith("/"):
        send_error(req_id, "EINVAL", "absolute path required")
        return
    try:
        real = resolve_trusted_leaf(to_bytes(path))
        pfd, leaf = open_parent_safely(real)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    try:
        fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=pfd)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                send_error(req_id, "EINVAL", "not a regular file", path)
                return
            if st.st_size > EDIT_LIMIT:
                send_error(req_id, "EFBIG", "this file is over 1 MB, too big to edit here", path)
                return
            os.set_blocking(fd, True)
            chunks = []
            got = 0
            while got <= EDIT_LIMIT:
                chunk = os.read(fd, EDIT_LIMIT + 1 - got)
                if not chunk:
                    break
                chunks.append(chunk)
                got += len(chunk)
        finally:
            os.close(fd)
        data = b"".join(chunks)
        if len(data) > EDIT_LIMIT:
            send_error(req_id, "EFBIG", "this file is over 1 MB, too big to edit here", path)
            return
        bom = data.startswith(UTF8_BOM)
        if bom:
            data = data[len(UTF8_BOM):]
        if b"\0" in data:
            send_error(req_id, "EBINARY", "this is not a text file", path)
            return
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            send_error(req_id, "EBINARY", "this file is not UTF-8 text", path)
            return
        crlf_count = text.count("\r\n")
        crlf = crlf_count > 0 and crlf_count >= text.count("\n") - crlf_count
        if crlf_count:
            text = text.replace("\r\n", "\n")
        if "\r" in text:
            send_error(req_id, "EBINARY", "this file has carriage returns the editor would change", path)
            return
        if max(len(line) for line in text.split("\n")) > EDIT_LINE_LIMIT:
            send_error(req_id, "ELONGLINE", "this file has a line over 20,000 characters, too long to edit here", path)
            return
        writable = os.access(real, os.W_OK)
        emit(dict({"id": req_id, "t": "text", "text": text, "path": to_str(real), "crlf": crlf, "bom": bom,
                   "writable": writable}, **file_identity(st)))
        send_done(req_id)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
    finally:
        os.close(pfd)


def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        view = view[written:]


def replace_contents(pfd, leaf, data, mode, gid):
    mode &= ~(stat.S_ISUID | stat.S_ISGID)
    stem = leaf[:180]
    while True:
        work = b"." + stem + b".omafile-" + os.urandom(4).hex().encode()
        try:
            fd = os.open(work, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=pfd)
            break
        except FileExistsError:
            continue
    try:
        try:
            if os.fstat(fd).st_gid != gid:
                try:
                    os.fchown(fd, -1, gid)
                except OSError:
                    raise PermissionError(errno.EPERM, "could not keep the file's group")
            write_all(fd, data)
            os.fchmod(fd, mode)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(work, leaf, src_dir_fd=pfd, dst_dir_fd=pfd)
    except BaseException:
        try:
            os.unlink(work, dir_fd=pfd)
        except OSError:
            pass
        raise


def overwrite_contents(pfd, leaf, data, lst):
    fd = os.open(leaf, os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=pfd)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_ino != lst.st_ino or st.st_dev != lst.st_dev:
            raise OSError(errno.EAGAIN, "the file changed while saving")
        os.set_blocking(fd, True)
        os.lseek(fd, 0, os.SEEK_SET)
        write_all(fd, data)
        os.ftruncate(fd, len(data))
        os.fsync(fd)
    finally:
        os.close(fd)


def op_writetext(req):
    req_id = req["id"]
    path = req.get("path")
    text = req.get("text")
    if not isinstance(path, str) or not path.startswith("/") or not isinstance(text, str):
        send_error(req_id, "EINVAL", "absolute path and text required")
        return
    if len(text) > EDIT_WRITE_LIMIT:
        send_error(req_id, "EFBIG", "the text is too long to save here", path)
        return
    try:
        data = text.encode("utf-8")
    except UnicodeEncodeError:
        send_error(req_id, "EINVAL", "the text has characters that cannot be saved as UTF-8", path)
        return
    if req.get("crlf") is True:
        data = data.replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
    if req.get("bom") is True:
        data = UTF8_BOM + data
    force = req.get("force") is True
    try:
        pfd, leaf = open_parent_safely(to_bytes(path))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    try:
        lst = lstat_at(pfd, leaf)
        if lst is not None and not stat.S_ISREG(lst.st_mode):
            send_error(req_id, "EINVAL", "this is no longer a regular file", path)
            return
        if not force and (lst is None or not same_identity(lst, req.get("expect"))):
            send_error(req_id, "ECONFLICT", "deleted" if lst is None else "changed", path)
            return
        if lst is None:
            fd = os.open(leaf, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=pfd)
            try:
                write_all(fd, data)
                os.fsync(fd)
            finally:
                os.close(fd)
        elif lst.st_nlink == 1 and lst.st_uid == os.geteuid():
            try:
                replace_contents(pfd, leaf, data, stat.S_IMODE(lst.st_mode), lst.st_gid)
            except PermissionError:
                overwrite_contents(pfd, leaf, data, lst)
        else:
            overwrite_contents(pfd, leaf, data, lst)
        st = os.lstat(leaf, dir_fd=pfd)
        send_done(req_id, path=path, **file_identity(st))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
    finally:
        os.close(pfd)


DUP_FILE_LIMIT = 300000
DUP_GROUP_LIMIT = 2000
DUP_PART = 65536
DUP_PROGRESS_SECONDS = 0.3
DUP_MAX_DEPTH = 64
DUP_DIR_LIMIT = 100000
DUP_ENTRY_LIMIT = 3000000


def dup_digest(path, size, partial, cancel_event):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size != size:
            return None
        os.set_blocking(fd, True)
        h = hashlib.blake2b(digest_size=20)
        if partial and size > 2 * DUP_PART:
            h.update(os.pread(fd, DUP_PART, 0))
            h.update(os.pread(fd, DUP_PART, size - DUP_PART))
            return h.digest()
        while True:
            if cancel_event.is_set():
                return None
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                return h.digest()
            h.update(chunk)
    except OSError:
        return None
    finally:
        os.close(fd)


def dup_item(item, size):
    return {"path": to_str(item[0]), "mtime": int(item[3]), "size": size, "dev": item[1], "ino": item[2]}


def dup_split(items, size, partial, cancel_event, progress):
    buckets = {}
    for item in items:
        if cancel_event.is_set():
            return []
        digest = dup_digest(item[0], size, partial, cancel_event)
        progress()
        if digest is not None:
            buckets.setdefault(digest, []).append(item)
    return [b for b in buckets.values() if len(b) > 1]


def dup_matches(items, size, cancel_event, progress):
    out = []
    for bucket in dup_split(items, size, True, cancel_event, progress):
        if size <= 2 * DUP_PART:
            out.append(bucket)
        else:
            out.extend(dup_split(bucket, size, False, cancel_event, progress))
    return out


def op_duplicates(req, cancel_event):
    req_id = req["id"]
    root = req.get("root")
    target = req.get("path")
    hidden = req.get("hidden") is True
    if not isinstance(root, str) or not root.startswith("/") or (target is not None and (
            not isinstance(target, str) or not target.startswith("/"))):
        send_error(req_id, "EINVAL", "absolute root required")
        return
    root_bytes = to_bytes(root)
    try:
        root_st = os.stat(root_bytes)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), root)
        return
    if not stat.S_ISDIR(root_st.st_mode):
        send_error(req_id, "ENOTDIR", "not a folder", root)
        return
    want_size = None
    target_key = None
    target_item = None
    if target is not None:
        try:
            tst = os.stat(to_bytes(target))
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), target)
            return
        if not stat.S_ISREG(tst.st_mode):
            send_error(req_id, "EINVAL", "not a regular file", target)
            return
        if tst.st_size == 0:
            send_error(req_id, "EINVAL", "this file is empty, so every empty file would match", target)
            return
        want_size = tst.st_size
        target_key = (tst.st_dev, tst.st_ino)
        target_item = (to_bytes(target), tst.st_dev, tst.st_ino, tst.st_mtime)
    trash = os.path.realpath(to_bytes(os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "Trash")))
    by_size = {}
    scanned = 0
    kept = 0
    truncated = False
    last = [0.0]

    def tick(phase, current, done=0, total=0, force=False):
        now = time.monotonic()
        if not force and now - last[0] < DUP_PROGRESS_SECONDS:
            return
        last[0] = now
        emit({"id": req_id, "t": "progress", "phase": phase, "files": scanned, "current": to_str(current),
              "done": done, "total": total})

    stack = [(root_bytes, 0)]
    folders = 0
    entries = 0
    while stack and not truncated:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        current, depth = stack.pop()
        folders += 1
        if folders > DUP_DIR_LIMIT:
            truncated = True
            break
        tick("looking", current)
        try:
            with os.scandir(current) as it:
                for entry in it:
                    entries += 1
                    if entries % 512 == 0 and cancel_event.is_set():
                        send_error(req_id, "ECANCELED", "cancelled")
                        return
                    if entries > DUP_ENTRY_LIMIT:
                        truncated = True
                        break
                    if entry.name == b".Trash" or entry.name.startswith(b".Trash-"):
                        continue
                    if not hidden and entry.name.startswith(b"."):
                        continue
                    try:
                        lst = entry.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(lst.st_mode):
                        if lst.st_dev != root_st.st_dev or (entry.name == b"Trash" and os.path.realpath(entry.path) == trash):
                            continue
                        if depth >= DUP_MAX_DEPTH:
                            truncated = True
                            continue
                        stack.append((entry.path, depth + 1))
                        continue
                    if not stat.S_ISREG(lst.st_mode) or lst.st_size == 0:
                        continue
                    scanned += 1
                    if want_size is not None and lst.st_size != want_size:
                        continue
                    by_size.setdefault(lst.st_size, []).append((entry.path, lst.st_dev, lst.st_ino, lst.st_mtime))
                    kept += 1
                    if kept >= DUP_FILE_LIMIT:
                        truncated = True
                        break
        except OSError:
            continue
    if target_key is not None and not any((i[1], i[2]) == target_key for i in by_size.get(want_size, [])):
        by_size.setdefault(want_size, []).insert(0, target_item)
    candidates = []
    for size, items in by_size.items():
        seen = set()
        unique = []
        for item in items:
            key = (item[1], item[2])
            if key in seen:
                continue
            seen.add(key)
            unique.append(target_item if key == target_key else item)
        if len(unique) > 1:
            candidates.append((size, unique))
    total = sum(len(items) for _, items in candidates)
    done = [0]

    def progress():
        done[0] += 1
        tick("comparing", b"", done[0], total)

    groups = []
    if target is not None:
        for size, items in candidates:
            if not any((i[1], i[2]) == target_key for i in items):
                continue
            for bucket in dup_matches(items, size, cancel_event, progress):
                if any((i[1], i[2]) == target_key for i in bucket):
                    first = [i for i in bucket if (i[1], i[2]) == target_key]
                    rest = sorted((i for i in bucket if (i[1], i[2]) != target_key), key=lambda i: i[0])
                    groups.append({"size": size, "items": [dup_item(i, size) for i in first + rest]})
    else:
        for size, items in sorted(candidates, key=lambda c: -c[0]):
            for bucket in dup_matches(items, size, cancel_event, progress):
                bucket.sort(key=lambda i: (i[3], i[0]))
                groups.append({"size": size, "items": [dup_item(i, size) for i in bucket]})
            if len(groups) >= DUP_GROUP_LIMIT:
                truncated = True
                break
    if cancel_event.is_set():
        send_error(req_id, "ECANCELED", "cancelled")
        return
    groups.sort(key=lambda g: -g["size"] * (len(g["items"]) - 1))
    tick("comparing", b"", total, total, force=True)
    send_done(req_id, groups=groups[:DUP_GROUP_LIMIT], scanned=scanned, truncated=truncated)


CANCELLABLE_OPS = {
    "list": op_list,
    "search": op_search,
    "du": op_du,
    "copy": lambda r, c: op_copy_move(r, c, False),
    "move": lambda r, c: op_copy_move(r, c, True),
    "mounturi": op_mounturi,
    "mountdev": op_mountdev,
    "unlockdev": op_unlockdev,
    "unmountdev": op_unmountdev,
    "recent": op_recent,
    "setdefaultfm": op_setdefaultfm,
    "unmounturi": op_unmounturi,
    "thumb": op_thumb,
    "audiopreview": op_audiopreview,
    "counts": op_counts,
    "extract": op_extract,
    "compress": op_compress,
    "transcode": op_transcode,
    "duplicates": op_duplicates,
}

SIMPLE_OPS = {
    "clipset": op_clipset,
    "clipget": op_clipget,
    "cliptext": op_cliptext,
    "clipimage": op_clipimage,
    "clipclear": op_clipclear,
    "samedev": op_samedev,
    "stat": op_stat,
    "peek": op_peek,
    "thumbtypes": op_thumbtypes,
    "defaults": op_defaults,
    "readtext": op_readtext,
    "writetext": op_writetext,
    "bookmarks": op_bookmarks,
    "setbookmarks": op_setbookmarks,
    "trash": op_trash,
    "delete": op_delete,
    "restore": op_restore,
    "trashinfo": op_trashinfo,
    "emptytrash": op_emptytrash,
    "mkdir": op_mkdir,
    "mkfile": op_mkfile,
    "rename": op_rename,
    "identity": op_identity,
    "opener": op_opener,
    "setopener": op_setopener,
    "chmod": op_chmod,
    "chown": op_chown,
    "symlink": op_symlink,
    "freespace": op_freespace,
    "drives": op_drives,
    "netmounts": op_netmounts,
    "netdiscover": op_netdiscover,
    "defaultfm": op_defaultfm,
    "dirs": op_dirs,
    "ping": op_ping,
    "watch": op_watch,
    "unwatch": op_unwatch,
    "baricon": op_baricon,
    "barsettings": op_barsettings,
}

def dispatch(req):
    req_id = req.get("id")
    op = req.get("op")
    try:
        if op == "cancel":
            op_cancel(req)
            return
        if op == "resolve":
            op_resolve(req)
            return
        if op in CANCELLABLE_OPS:
            handler = CANCELLABLE_OPS[op]
            ev = register_inflight(req_id, op)
            if ev is None:
                send_error(req_id, "EBUSY", "a request with this id is already running")
                return
            try:
                handler(req, ev)
            finally:
                unregister_inflight(req_id)
            return
        if op in SIMPLE_OPS:
            SIMPLE_OPS[op](req)
            return
        send_error(req_id, "EUNSUPPORTED", "unknown op: %s" % op)
    except Exception as e:
        try:
            send_error(req_id, "EINTERNAL", str(e))
        except Exception:
            pass

ACTIVE_THREADS_LOCK = threading.Lock()
ACTIVE_THREADS = []

def run_and_untrack(req):
    t = threading.current_thread()
    try:
        dispatch(req)
    finally:
        with ACTIVE_THREADS_LOCK:
            if t in ACTIVE_THREADS:
                ACTIVE_THREADS.remove(t)

def handle_line(raw):
    line = raw.decode("utf-8", "surrogatepass").strip()
    if not line:
        return
    try:
        req = json.loads(line)
    except ValueError:
        sys.stderr.write("malformed request line\n")
        sys.stderr.flush()
        return
    if not isinstance(req, dict) or "op" not in req or "id" not in req:
        if isinstance(req, dict) and "id" in req:
            send_error(req["id"], "EINVAL", "missing op")
        return
    t = threading.Thread(target=run_and_untrack, args=(req,), daemon=True)
    with ACTIVE_THREADS_LOCK:
        ACTIVE_THREADS.append(t)
    try:
        t.start()
    except RuntimeError:
        with ACTIVE_THREADS_LOCK:
            if t in ACTIVE_THREADS:
                ACTIVE_THREADS.remove(t)
        send_error(req["id"], "EAGAIN", "the helper is too busy, try again")

def main():
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="strict")
    except AttributeError:
        pass
    for raw in sys.stdin.buffer:
        try:
            handle_line(raw)
        except Exception as e:
            sys.stderr.write("bad request line: %s\n" % e)
            sys.stderr.flush()
    deadline = time.monotonic() + 15.0
    while time.monotonic() < deadline:
        with ACTIVE_THREADS_LOCK:
            remaining = list(ACTIVE_THREADS)
        if not remaining:
            break
        for t in remaining:
            t.join(timeout=0.1)
            if time.monotonic() >= deadline:
                break

if __name__ == "__main__":
    main()
