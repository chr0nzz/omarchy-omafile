VERSION = "1.0.0"
HOME = os.path.expanduser("~")

STDOUT_LOCK = threading.Lock()

def emit(obj):
    line = json.dumps(obj, ensure_ascii=True)
    with STDOUT_LOCK:
        sys.stdout.write(line)
        sys.stdout.write("\n")
        sys.stdout.flush()

def send_error(req_id, code, message, path=None):
    obj = {"id": req_id, "t": "error", "code": code, "message": message}
    if path is not None:
        obj["path"] = path
    emit(obj)

def send_done(req_id, **fields):
    obj = {"id": req_id, "t": "done"}
    obj.update(fields)
    emit(obj)

def errno_code(e):
    if isinstance(e, OSError) and e.errno:
        return errno.errorcode.get(e.errno, "EINTERNAL")
    return "EINTERNAL"

def to_bytes(p):
    return os.fsencode(p)

def to_str(b):
    return os.fsdecode(b)

INFLIGHT_LOCK = threading.Lock()
INFLIGHT = {}

def register_inflight(req_id, kind):
    ev = threading.Event()
    with INFLIGHT_LOCK:
        INFLIGHT[req_id] = {"cancel": ev, "kind": kind}
    return ev

def unregister_inflight(req_id):
    with INFLIGHT_LOCK:
        INFLIGHT.pop(req_id, None)

CONFLICT_LOCK = threading.Lock()
PENDING_CONFLICTS = {}

WATCH_LOCK = threading.Lock()
WATCHES = {}

class Cancelled(Exception):
    pass

def classify(full_path_bytes, lst):
    mode = lst.st_mode
    if stat.S_ISLNK(mode):
        try:
            target = os.readlink(full_path_bytes)
        except OSError:
            target = b""
        link_target_str = to_str(target)
        try:
            st = os.stat(full_path_bytes)
        except OSError:
            return "b", 0, link_target_str
        if stat.S_ISDIR(st.st_mode):
            return "L", 0, link_target_str
        return "l", st.st_size, link_target_str
    if stat.S_ISDIR(mode):
        return "d", 0, None
    if stat.S_ISREG(mode):
        return "f", lst.st_size, None
    return "o", getattr(lst, "st_size", 0), None

NATURAL_SPLIT = re.compile(r"(\d+)")


def natural_key(name):
    parts = NATURAL_SPLIT.split(name.lower())
    key = []
    for index, part in enumerate(parts):
        if index % 2:
            key.append((1, int(part), ""))
        else:
            key.append((0, 0, part))
    return key


def list_sort_key(entry):
    directory_first = 0 if entry[1] in ("d", "L") else 1
    return (directory_first, natural_key(entry[0]), entry[0])


PEEK_LIMIT = 262144

def op_list(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    hidden = bool(req.get("hidden", False))
    chunk_size = req.get("chunk") or 500
    try:
        chunk_size = int(chunk_size)
        if chunk_size <= 0:
            chunk_size = 500
    except (TypeError, ValueError):
        chunk_size = 500
    path_bytes = to_bytes(path)
    collected = []
    try:
        with os.scandir(path_bytes) as it:
            for entry in it:
                if cancel_event.is_set():
                    send_error(req_id, "ECANCELED", "cancelled")
                    return
                name_str = to_str(entry.name)
                if not hidden and name_str.startswith("."):
                    continue
                try:
                    lst = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                kind, size, link_target = classify(entry.path, lst)
                collected.append([name_str, kind, size, int(lst.st_mtime), lst.st_mode, link_target])
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    collected.sort(key=list_sort_key)
    total = len(collected)
    for i in range(0, total, chunk_size):
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        emit({"id": req_id, "t": "entries", "c": collected[i:i + chunk_size]})
    send_done(req_id, total=total)

INOTIFY_LIB = None
INOTIFY_AVAILABLE = False
IN_CLOEXEC = 0o2000000
IN_NONBLOCK = 0o4000
IN_CREATE = 0x100
IN_DELETE = 0x200
IN_DELETE_SELF = 0x400
IN_MODIFY = 0x2
IN_MOVE_SELF = 0x800
IN_MOVED_FROM = 0x40
IN_MOVED_TO = 0x80
IN_ATTRIB = 0x4
IN_CLOSE_WRITE = 0x8
IN_Q_OVERFLOW = 0x4000
WATCH_MASK = (IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MODIFY | IN_MOVE_SELF |
              IN_MOVED_FROM | IN_MOVED_TO | IN_ATTRIB | IN_CLOSE_WRITE)
EVENT_FMT = "iIII"
EVENT_SIZE = struct.calcsize(EVENT_FMT)

try:
    INOTIFY_LIB = ctypes.CDLL("libc.so.6", use_errno=True)
    INOTIFY_LIB.inotify_init1.restype = ctypes.c_int
    INOTIFY_LIB.inotify_init1.argtypes = [ctypes.c_int]
    INOTIFY_LIB.inotify_add_watch.restype = ctypes.c_int
    INOTIFY_LIB.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    INOTIFY_LIB.inotify_rm_watch.restype = ctypes.c_int
    INOTIFY_LIB.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
except (OSError, AttributeError):
    INOTIFY_LIB = None

def try_inotify_init():
    if INOTIFY_LIB is None:
        return None
    fd = INOTIFY_LIB.inotify_init1(IN_CLOEXEC | IN_NONBLOCK)
    if fd < 0:
        return None
    return fd

_probe_fd = try_inotify_init()
INOTIFY_AVAILABLE = _probe_fd is not None
if _probe_fd is not None:
    os.close(_probe_fd)

class WatchHandle:
    def __init__(self, req_id, path_bytes):
        self.req_id = req_id
        self.path_bytes = path_bytes
        self.stop_event = threading.Event()
        self.thread = None
        self.fd = -1
        self.wd = -1
        self.mode = None

def inotify_loop(handle):
    pending = set()
    first_pending_time = None
    fd = handle.fd
    while not handle.stop_event.is_set():
        try:
            r, _, _ = select.select([fd], [], [], 0.05)
        except (OSError, ValueError):
            break
        if handle.stop_event.is_set():
            break
        if r:
            try:
                data = os.read(fd, 65536)
            except OSError:
                break
            offset = 0
            overflow = False
            while offset + EVENT_SIZE <= len(data):
                wd, mask, cookie, length = struct.unpack_from(EVENT_FMT, data, offset)
                name = b""
                if length:
                    raw = data[offset + EVENT_SIZE:offset + EVENT_SIZE + length]
                    name = raw.split(b"\0", 1)[0]
                offset += EVENT_SIZE + length
                if mask & IN_Q_OVERFLOW:
                    overflow = True
                    continue
                if name:
                    pending.add(name)
                if first_pending_time is None:
                    first_pending_time = time.monotonic()
            if overflow:
                pending.clear()
                first_pending_time = None
                emit({"id": handle.req_id, "t": "changed", "path": to_str(handle.path_bytes), "names": []})
        if pending and first_pending_time is not None and time.monotonic() - first_pending_time >= 0.12:
            names = sorted(to_str(n) for n in pending)
            emit({"id": handle.req_id, "t": "changed", "path": to_str(handle.path_bytes), "names": names})
            pending.clear()
            first_pending_time = None
    try:
        if handle.wd >= 0:
            INOTIFY_LIB.inotify_rm_watch(handle.fd, handle.wd)
    except OSError:
        pass
    try:
        os.close(handle.fd)
    except OSError:
        pass

def poll_loop(handle):
    last_snapshot = None
    while not handle.stop_event.wait(2.0):
        snap = None
        try:
            snap = {}
            with os.scandir(handle.path_bytes) as it:
                for e in it:
                    try:
                        st = e.stat(follow_symlinks=False)
                        snap[e.name] = (st.st_mtime, st.st_size)
                    except OSError:
                        pass
        except OSError:
            snap = None
        if last_snapshot is not None and snap is not None and snap != last_snapshot:
            changed = [n for n in set(snap) | set(last_snapshot) if snap.get(n) != last_snapshot.get(n)]
            names = sorted(to_str(n) for n in changed) if len(changed) <= 200 else []
            emit({"id": handle.req_id, "t": "changed", "path": to_str(handle.path_bytes), "names": names})
        if snap is not None:
            last_snapshot = snap

def start_watch(req_id, path_bytes):
    handle = WatchHandle(req_id, path_bytes)
    fd = try_inotify_init() if INOTIFY_AVAILABLE else None
    if fd is not None:
        wd = INOTIFY_LIB.inotify_add_watch(fd, path_bytes, WATCH_MASK)
        if wd >= 0:
            handle.fd = fd
            handle.wd = wd
            handle.mode = "inotify"
            handle.thread = threading.Thread(target=inotify_loop, args=(handle,), daemon=True)
        else:
            os.close(fd)
    if handle.mode is None:
        handle.mode = "poll"
        handle.thread = threading.Thread(target=poll_loop, args=(handle,), daemon=True)
    handle.thread.start()
    return handle

def stop_watch(handle, cancelled=False):
    handle.stop_event.set()
    if handle.thread:
        handle.thread.join(timeout=1.0)
    if cancelled:
        send_error(handle.req_id, "ECANCELED", "cancelled")
    else:
        send_done(handle.req_id)

def op_watch(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    path_bytes = to_bytes(path)
    try:
        if not os.path.isdir(path_bytes):
            send_error(req_id, "ENOTDIR", "not a directory", path)
            return
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    old = None
    with WATCH_LOCK:
        old = WATCHES.get(path)
        handle = start_watch(req_id, path_bytes)
        WATCHES[path] = handle
    if old:
        stop_watch(old)

def op_unwatch(req):
    path = req.get("path")
    with WATCH_LOCK:
        handle = WATCHES.pop(path, None)
    if handle:
        stop_watch(handle)
    else:
        send_error(req["id"], "EINVAL", "no such watch", path)

def op_stat(req):
    req_id = req["id"]
    paths = req.get("paths") or []
    items = []
    for p in paths:
        item = {"path": p}
        try:
            pb = to_bytes(p)
            lst = os.lstat(pb)
            kind, size, link_target = classify(pb, lst)
            name = to_str(os.path.basename(pb))
            try:
                owner = pwd.getpwuid(lst.st_uid).pw_name
            except KeyError:
                owner = str(lst.st_uid)
            try:
                group = grp.getgrgid(lst.st_gid).gr_name
            except KeyError:
                group = str(lst.st_gid)
            mime, _ = mimetypes.guess_type(name)
            item.update({
                "name": name, "kind": kind, "size": size,
                "mtime": int(lst.st_mtime), "atime": int(lst.st_atime),
                "ctime": int(lst.st_ctime), "mode": lst.st_mode,
                "uid": lst.st_uid, "gid": lst.st_gid, "owner": owner, "group": group,
                "nlink": lst.st_nlink, "disk": lst.st_blocks * 512, "inode": lst.st_ino, "dev": lst.st_dev,
                "mime": mime, "linkTarget": link_target,
            })
        except OSError as e:
            item["error"] = errno_code(e)
        items.append(item)
    emit({"id": req_id, "t": "stat", "items": items})
    send_done(req_id)

def op_du(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    path_bytes = to_bytes(path)
    total_bytes = 0
    files = 0
    dirs = 0
    last_emit = [time.monotonic()]

    def maybe_emit(final=False):
        now = time.monotonic()
        if final or now - last_emit[0] >= 0.25:
            emit({"id": req_id, "t": "du", "bytes": total_bytes, "files": files, "dirs": dirs, "partial": not final})
            last_emit[0] = now

    try:
        root_lst = os.lstat(path_bytes)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    if stat.S_ISDIR(root_lst.st_mode) and not stat.S_ISLNK(root_lst.st_mode):
        pass
    else:
        total_bytes += root_lst.st_size
        files += 1
        maybe_emit(final=True)
        send_done(req_id)
        return
    stack = [path_bytes]
    while stack:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        current = stack.pop()
        try:
            with os.scandir(current) as it:
                for entry in it:
                    if cancel_event.is_set():
                        send_error(req_id, "ECANCELED", "cancelled")
                        return
                    try:
                        lst = entry.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    if stat.S_ISDIR(lst.st_mode):
                        dirs += 1
                        stack.append(entry.path)
                    else:
                        total_bytes += lst.st_size
                        files += 1
                    maybe_emit()
        except OSError:
            continue
    maybe_emit(final=True)
    send_done(req_id)

def copy_file_data(src_bytes, dst_bytes, progress_cb, cancel_event):
    src_fd = os.open(src_bytes, os.O_RDONLY)
    try:
        dst_fd = os.open(dst_bytes, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o666)
        try:
            copied = 0
            use_cfr = hasattr(os, "copy_file_range")
            while True:
                if cancel_event.is_set():
                    raise Cancelled()
                if use_cfr:
                    try:
                        n = os.copy_file_range(src_fd, dst_fd, 1024 * 1024)
                    except OSError:
                        use_cfr = False
                        continue
                    if n == 0:
                        break
                    copied += n
                else:
                    buf = os.read(src_fd, 1024 * 1024)
                    if not buf:
                        break
                    os.write(dst_fd, buf)
                    copied += len(buf)
                progress_cb(copied)
            return copied
        finally:
            os.close(dst_fd)
    finally:
        os.close(src_fd)

def copy_meta(dst_bytes, lst):
    try:
        os.chmod(dst_bytes, stat.S_IMODE(lst.st_mode))
    except OSError:
        pass
    try:
        os.utime(dst_bytes, ns=(lst.st_atime_ns, lst.st_mtime_ns))
    except OSError:
        pass

def same_file(a, b):
    try:
        return os.path.samefile(a, b)
    except OSError:
        return False


def unique_dest_name(dest_dir_bytes, name_bytes):
    if not os.path.lexists(os.path.join(dest_dir_bytes, name_bytes)):
        return name_bytes
    stem, ext = os.path.splitext(to_str(name_bytes))
    n = 1
    while True:
        candidate_bytes = to_bytes("%s (%d)%s" % (stem, n, ext))
        if not os.path.lexists(os.path.join(dest_dir_bytes, candidate_bytes)):
            return candidate_bytes
        n += 1

def resolve_conflict(req_id, cancel_event, source_str, dest_str, dest_bytes, conflict_mode, job_state):
    if job_state.get("applyAll"):
        return job_state["applyAll"]
    if conflict_mode != "ask":
        return conflict_mode
    try:
        dlst = os.lstat(dest_bytes)
        dkind, dsize, _ = classify(dest_bytes, dlst)
        dmtime = int(dlst.st_mtime)
    except OSError:
        dkind, dsize, dmtime = "f", 0, 0
    ev = threading.Event()
    with CONFLICT_LOCK:
        PENDING_CONFLICTS[req_id] = {"event": ev, "action": None, "applyAll": False}
    emit({"id": req_id, "t": "conflict", "source": source_str, "dest": dest_str,
          "destKind": dkind, "destSize": dsize, "destMtime": dmtime})
    while True:
        if cancel_event.is_set():
            with CONFLICT_LOCK:
                PENDING_CONFLICTS.pop(req_id, None)
            return "cancel"
        if ev.wait(timeout=0.1):
            break
    with CONFLICT_LOCK:
        info = PENDING_CONFLICTS.pop(req_id, None)
    action = info["action"] if info else "cancel"
    if info and info.get("applyAll") and action in ("overwrite", "skip", "rename"):
        job_state["applyAll"] = action
    return action

def op_resolve(req):
    req_id = req["id"]
    action = req.get("action")
    apply_all = bool(req.get("applyAll", False))
    with CONFLICT_LOCK:
        info = PENDING_CONFLICTS.get(req_id)
        if info:
            info["action"] = action
            info["applyAll"] = apply_all
            info["event"].set()

def op_copy_move(req, cancel_event, is_move):
    req_id = req["id"]
    sources = req.get("sources") or []
    dest = req.get("dest")
    conflict_mode = req.get("conflict", "ask")
    if not sources or not isinstance(dest, str):
        send_error(req_id, "EINVAL", "sources and dest required")
        return
    dest_bytes = to_bytes(dest)
    try:
        dest_lst = os.lstat(dest_bytes)
        if not stat.S_ISDIR(dest_lst.st_mode):
            send_error(req_id, "EINVAL", "dest is not a directory", dest)
            return
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), dest)
        return

    total_bytes = 0
    total_files = 0

    def prescan(p):
        nonlocal total_bytes, total_files
        try:
            lst = os.lstat(p)
        except OSError:
            return
        total_files += 1
        if stat.S_ISLNK(lst.st_mode):
            return
        if stat.S_ISDIR(lst.st_mode):
            try:
                with os.scandir(p) as it:
                    for e in it:
                        if cancel_event.is_set():
                            return
                        prescan(e.path)
            except OSError:
                pass
        else:
            total_bytes += lst.st_size

    for s in sources:
        prescan(to_bytes(s))
    if cancel_event.is_set():
        send_error(req_id, "ECANCELED", "cancelled")
        return

    copied = 0
    skipped = 0
    errors = []
    bytes_done = [0]
    files_done = [0]
    start_time = time.monotonic()
    last_progress = [0.0]
    job_state = {}

    def emit_progress(current_str, force=False):
        now = time.monotonic()
        if force or now - last_progress[0] >= 0.1:
            elapsed = now - start_time
            rate = bytes_done[0] / elapsed if elapsed > 0 else 0
            emit({"id": req_id, "t": "progress", "bytes": bytes_done[0], "total": total_bytes,
                  "files": files_done[0], "filesTotal": total_files, "current": current_str, "rate": rate})
            last_progress[0] = now

    def copy_one(src_bytes, dst_bytes):
        nonlocal copied, skipped
        if cancel_event.is_set():
            raise Cancelled()
        try:
            lst = os.lstat(src_bytes)
        except OSError as e:
            errors.append({"path": to_str(src_bytes), "message": e.strerror or str(e)})
            return
        src_str = to_str(src_bytes)
        final_dst = dst_bytes
        if os.path.lexists(dst_bytes):
            if same_file(src_bytes, dst_bytes):
                action = "rename"
            else:
                action = resolve_conflict(req_id, cancel_event, src_str, to_str(dst_bytes), dst_bytes, conflict_mode, job_state)
            if action == "cancel":
                raise Cancelled()
            if action == "skip":
                skipped += 1
                return
            if action == "rename":
                parent = os.path.dirname(dst_bytes)
                base = os.path.basename(dst_bytes)
                final_dst = os.path.join(parent, unique_dest_name(parent, base))
            elif action == "overwrite":
                try:
                    if os.path.isdir(final_dst) and not os.path.islink(final_dst) and not stat.S_ISDIR(lst.st_mode):
                        shutil.rmtree(final_dst)
                    elif not (os.path.isdir(final_dst) and not os.path.islink(final_dst)):
                        os.remove(final_dst)
                except OSError:
                    pass
        emit_progress(src_str)
        if stat.S_ISLNK(lst.st_mode):
            try:
                target = os.readlink(src_bytes)
                if os.path.lexists(final_dst):
                    os.remove(final_dst)
                os.symlink(target, final_dst)
            except OSError as e:
                errors.append({"path": src_str, "message": e.strerror or str(e)})
                return
            files_done[0] += 1
            copied += 1
        elif stat.S_ISDIR(lst.st_mode):
            try:
                os.makedirs(final_dst, exist_ok=True)
            except OSError as e:
                errors.append({"path": src_str, "message": e.strerror or str(e)})
                return
            try:
                with os.scandir(src_bytes) as it:
                    children = list(it)
            except OSError as e:
                errors.append({"path": src_str, "message": e.strerror or str(e)})
                children = []
            for child in children:
                if cancel_event.is_set():
                    raise Cancelled()
                copy_one(child.path, os.path.join(final_dst, child.name))
            copy_meta(final_dst, lst)
            files_done[0] += 1
            copied += 1
        else:
            base = bytes_done[0]

            def progress_cb(n):
                bytes_done[0] = base + n
                emit_progress(src_str)

            try:
                copy_file_data(src_bytes, final_dst, progress_cb, cancel_event)
                copy_meta(final_dst, lst)
            except Cancelled:
                raise
            except OSError as e:
                errors.append({"path": src_str, "message": e.strerror or str(e)})
                bytes_done[0] = base
                return
            bytes_done[0] = base + lst.st_size
            files_done[0] += 1
            copied += 1

    def move_one(src_bytes, dst_bytes):
        nonlocal copied, skipped
        if cancel_event.is_set():
            raise Cancelled()
        try:
            lst = os.lstat(src_bytes)
        except OSError as e:
            errors.append({"path": to_str(src_bytes), "message": e.strerror or str(e)})
            return
        src_str = to_str(src_bytes)
        final_dst = dst_bytes
        if os.path.lexists(dst_bytes):
            if same_file(src_bytes, dst_bytes):
                action = "skip"
            else:
                action = resolve_conflict(req_id, cancel_event, src_str, to_str(dst_bytes), dst_bytes, conflict_mode, job_state)
            if action == "cancel":
                raise Cancelled()
            if action == "skip":
                skipped += 1
                return
            if action == "rename":
                parent = os.path.dirname(dst_bytes)
                base = os.path.basename(dst_bytes)
                final_dst = os.path.join(parent, unique_dest_name(parent, base))
            elif action == "overwrite":
                try:
                    if os.path.isdir(dst_bytes) and not os.path.islink(dst_bytes):
                        shutil.rmtree(dst_bytes)
                    else:
                        os.remove(dst_bytes)
                except OSError:
                    pass
        emit_progress(src_str)
        try:
            os.rename(src_bytes, final_dst)
            size = 0 if stat.S_ISDIR(lst.st_mode) and not stat.S_ISLNK(lst.st_mode) else lst.st_size
            bytes_done[0] += size
            files_done[0] += 1
            copied += 1
        except OSError as e:
            if e.errno == errno.EXDEV:
                copy_one(src_bytes, final_dst)
                try:
                    if stat.S_ISDIR(lst.st_mode) and not stat.S_ISLNK(lst.st_mode):
                        shutil.rmtree(src_bytes)
                    else:
                        os.unlink(src_bytes)
                except OSError as e2:
                    errors.append({"path": src_str, "message": e2.strerror or str(e2)})
            else:
                errors.append({"path": src_str, "message": e.strerror or str(e)})

    try:
        for s in sources:
            if cancel_event.is_set():
                raise Cancelled()
            src_bytes = to_bytes(s)
            name = os.path.basename(src_bytes)
            dst_bytes = os.path.join(dest_bytes, name)
            if is_move:
                move_one(src_bytes, dst_bytes)
            else:
                copy_one(src_bytes, dst_bytes)
    except Cancelled:
        send_error(req_id, "ECANCELED", "cancelled")
        return
    emit_progress("", force=True)
    send_done(req_id, copied=copied, skipped=skipped, errors=errors)

def xdg_data_home_bytes():
    v = os.environ.get("XDG_DATA_HOME")
    if v:
        return to_bytes(v)
    return to_bytes(os.path.join(HOME, ".local", "share"))

def home_trash_dirs():
    base = os.path.join(xdg_data_home_bytes(), b"Trash")
    files_dir = os.path.join(base, b"files")
    info_dir = os.path.join(base, b"info")
    os.makedirs(files_dir, mode=0o700, exist_ok=True)
    os.makedirs(info_dir, mode=0o700, exist_ok=True)
    return files_dir, info_dir

def percent_encode(path_bytes):
    safe = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~/"
    out = []
    for b in path_bytes:
        if b in safe:
            out.append(chr(b))
        else:
            out.append("%%%02X" % b)
    return "".join(out)

def percent_decode(s):
    out = bytearray()
    i = 0
    n = len(s)
    while i < n:
        c = s[i]
        if c == "%" and i + 2 < n:
            try:
                out.append(int(s[i + 1:i + 3], 16))
                i += 3
                continue
            except ValueError:
                pass
        out.extend(c.encode("utf-8", "surrogateescape"))
        i += 1
    return bytes(out)

def find_mount_point(path_bytes):
    p = path_bytes
    if not p:
        p = b"/"
    try:
        dev = os.stat(p).st_dev
    except OSError:
        p = os.path.dirname(p) or b"/"
        try:
            dev = os.stat(p).st_dev
        except OSError:
            return b"/"
    while True:
        parent = os.path.dirname(p)
        if parent == p or parent == b"":
            return p
        try:
            pdev = os.stat(parent).st_dev
        except OSError:
            return p
        if pdev != dev:
            return p
        p = parent

def volume_trash_name():
    return (".Trash-%d" % os.getuid()).encode()

def owned_real_dir(path_bytes):
    try:
        st = os.lstat(path_bytes)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid()

def checked_volume_trash(top):
    vol = os.path.join(top, volume_trash_name())
    files_dir = os.path.join(vol, b"files")
    info_dir = os.path.join(vol, b"info")
    if owned_real_dir(vol) and owned_real_dir(files_dir) and owned_real_dir(info_dir):
        return files_dir, info_dir
    return None

def make_private_dir(path_bytes):
    try:
        os.mkdir(path_bytes, 0o700)
    except FileExistsError:
        pass
    if not owned_real_dir(path_bytes):
        raise OSError(errno.EPERM, "the trash on this drive is not a folder you own", to_str(path_bytes))

def volume_trash_dirs(path_bytes):
    top = find_mount_point(os.path.dirname(path_bytes) or b"/")
    vol = os.path.join(top, volume_trash_name())
    make_private_dir(vol)
    files_dir = os.path.join(vol, b"files")
    info_dir = os.path.join(vol, b"info")
    make_private_dir(files_dir)
    make_private_dir(info_dir)
    return files_dir, info_dir, top

def trash_dirs_for(path_bytes):
    hf, hi = home_trash_dirs()
    home_dev = os.stat(os.path.dirname(hf)).st_dev
    try:
        src_dev = os.stat(os.path.dirname(path_bytes) or b"/").st_dev
    except OSError:
        src_dev = home_dev
    if src_dev == home_dev:
        return hf, hi, None
    vf, vi, top = volume_trash_dirs(path_bytes)
    return vf, vi, top

def reserve_trash_name(info_dir, base_bytes):
    stem, ext = os.path.splitext(to_str(base_bytes))
    n = 0
    while True:
        candidate = base_bytes if n == 0 else to_bytes("%s.%d%s" % (stem, n, ext))
        info_path = os.path.join(info_dir, candidate + b".trashinfo")
        try:
            fd = os.open(info_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            return candidate, fd
        except FileExistsError:
            n += 1

def move_across(src_bytes, dst_bytes):
    lst = os.lstat(src_bytes)
    if stat.S_ISLNK(lst.st_mode):
        target = os.readlink(src_bytes)
        os.symlink(target, dst_bytes)
        os.unlink(src_bytes)
    elif stat.S_ISDIR(lst.st_mode):
        shutil.copytree(src_bytes, dst_bytes, symlinks=True, copy_function=shutil.copy2)
        shutil.rmtree(src_bytes)
    else:
        shutil.copy2(src_bytes, dst_bytes)
        os.unlink(src_bytes)

def op_trash(req):
    req_id = req["id"]
    paths = req.get("paths") or []
    results = []
    for p in paths:
        try:
            src = to_bytes(p)
            files_dir, info_dir, top = trash_dirs_for(src)
            base = os.path.basename(src)
            candidate, fd = reserve_trash_name(info_dir, base)
            path_for_info = src if top is None else os.path.relpath(src, top)
            deletion_date = time.strftime("%Y-%m-%dT%H:%M:%S")
            content = "[Trash Info]\nPath=%s\nDeletionDate=%s\n" % (percent_encode(path_for_info), deletion_date)
            os.write(fd, content.encode("utf-8"))
            os.close(fd)
            dest_path = os.path.join(files_dir, candidate)
            try:
                os.rename(src, dest_path)
            except OSError as e:
                if e.errno == errno.EXDEV:
                    move_across(src, dest_path)
                else:
                    raise
            results.append({"path": p, "ok": True, "trashinfo": to_str(candidate)})
        except OSError as e:
            results.append({"path": p, "ok": False, "message": e.strerror or str(e)})
    send_done(req_id, results=results)

def trash_info_for(path_bytes, files_dirs):
    parent = os.path.dirname(path_bytes)
    if os.path.basename(parent) != b"files":
        return None
    if files_dirs[0] is None:
        files_dirs[0] = {os.path.realpath(f): i for f, i in list_trash_roots()}
    info_dir = files_dirs[0].get(os.path.realpath(parent))
    if info_dir is None:
        return None
    return os.path.join(info_dir, os.path.basename(path_bytes) + b".trashinfo")

def op_delete(req):
    req_id = req["id"]
    paths = req.get("paths") or []
    results = []
    files_dirs = [None]
    for p in paths:
        try:
            b = to_bytes(p)
            lst = os.lstat(b)
            if stat.S_ISDIR(lst.st_mode) and not stat.S_ISLNK(lst.st_mode):
                shutil.rmtree(b)
            else:
                os.unlink(b)
            info_path = trash_info_for(b, files_dirs)
            if info_path is not None:
                try:
                    os.unlink(info_path)
                except OSError:
                    pass
            results.append({"path": p, "ok": True})
        except OSError as e:
            results.append({"path": p, "ok": False, "message": e.strerror or str(e)})
    send_done(req_id, results=results)

def volume_mounts():
    mounts = []
    try:
        with open("/proc/mounts", "rb") as f:
            for line in f:
                parts = line.split()
                if len(parts) < 2:
                    continue
                mnt = parts[1].replace(rb"\040", b" ")
                if mnt not in mounts:
                    mounts.append(mnt)
    except OSError:
        pass
    return mounts

def list_trash_roots():
    roots = [home_trash_dirs()]
    seen = {os.path.dirname(roots[0][0])}
    for mnt in volume_mounts():
        cand = os.path.join(mnt, volume_trash_name())
        if cand in seen:
            continue
        seen.add(cand)
        checked = checked_volume_trash(mnt)
        if checked:
            roots.append(checked)
    return roots

def op_restore(req):
    req_id = req["id"]
    items = req.get("items") or []
    results = []
    roots = list_trash_roots()
    for item in items:
        item_bytes = to_bytes(item)
        if not item_bytes.endswith(b".trashinfo"):
            item_bytes = item_bytes + b".trashinfo"
        found = False
        for files_dir, info_dir in roots:
            info_path = os.path.join(info_dir, item_bytes)
            if not os.path.exists(info_path):
                continue
            found = True
            try:
                raw = open(info_path, "rb").read().decode("utf-8", "surrogateescape")
                path_val = None
                for line in raw.splitlines():
                    if line.startswith("Path="):
                        path_val = line[len("Path="):]
                        break
                if path_val is None:
                    results.append({"path": item, "ok": False, "message": "invalid trashinfo"})
                    break
                orig_bytes = percent_decode(path_val)
                if not orig_bytes.startswith(b"/"):
                    top = find_mount_point(files_dir)
                    orig_bytes = os.path.join(top, orig_bytes)
                name_in_trash = item_bytes[:-len(".trashinfo")]
                src_in_files = os.path.join(files_dir, name_in_trash)
                parent = os.path.dirname(orig_bytes)
                if parent:
                    os.makedirs(parent, exist_ok=True)
                os.rename(src_in_files, orig_bytes)
                os.remove(info_path)
                results.append({"path": to_str(orig_bytes), "ok": True})
            except OSError as e:
                results.append({"path": item, "ok": False, "message": e.strerror or str(e)})
            break
        if not found:
            results.append({"path": item, "ok": False, "message": "not found"})
    send_done(req_id, results=results)

def op_trashinfo(req):
    req_id = req["id"]
    roots = list_trash_roots()
    items = []
    count = 0
    total_bytes = 0
    for files_dir, info_dir in roots:
        try:
            names = os.listdir(info_dir)
        except OSError:
            continue
        for n in names:
            if not n.endswith(b".trashinfo"):
                continue
            info_path = os.path.join(info_dir, n)
            try:
                raw = open(info_path, "rb").read().decode("utf-8", "surrogateescape")
            except OSError:
                continue
            path_val = None
            deleted = None
            for line in raw.splitlines():
                if line.startswith("Path="):
                    path_val = line[len("Path="):]
                elif line.startswith("DeletionDate="):
                    deleted = line[len("DeletionDate="):]
            stem = n[:-len(".trashinfo")]
            file_path = os.path.join(files_dir, stem)
            try:
                lst = os.lstat(file_path)
                kind, size, _ = classify(file_path, lst)
            except OSError:
                kind, size = "f", 0
            if path_val:
                orig_bytes = percent_decode(path_val)
                if not orig_bytes.startswith(b"/"):
                    top = find_mount_point(files_dir)
                    orig_bytes = os.path.join(top, orig_bytes)
            else:
                orig_bytes = stem
            items.append({
                "name": to_str(stem), "original": to_str(orig_bytes),
                "deleted": deleted, "size": size, "kind": kind,
            })
            count += 1
            total_bytes += size
    watch_dirs = [to_str(info_dir) for _, info_dir in roots]
    emit({"id": req_id, "t": "trash", "count": count, "bytes": total_bytes,
          "items": items, "infoDirs": watch_dirs})
    send_done(req_id)

DIR_OPEN_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC

def open_dir_chain(base, names):
    fd = os.open(base, DIR_OPEN_FLAGS)
    try:
        for name in names:
            nxt = os.open(name, DIR_OPEN_FLAGS | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nxt
            if os.fstat(fd).st_uid != os.getuid():
                raise OSError(errno.EPERM, "trash folder is not yours", to_str(name))
        return fd
    except BaseException:
        os.close(fd)
        raise

def empty_dir_fd(fd):
    for name in os.listdir(fd):
        try:
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISDIR(st.st_mode):
                shutil.rmtree(name, dir_fd=fd)
            else:
                os.unlink(name, dir_fd=fd)
        except OSError:
            pass

def trash_dir_chains():
    home_files, home_info = home_trash_dirs()
    chains = [(home_files, []), (home_info, [])]
    seen = {os.path.dirname(home_files)}
    for mnt in volume_mounts():
        cand = os.path.join(mnt, volume_trash_name())
        if cand in seen:
            continue
        seen.add(cand)
        if checked_volume_trash(mnt):
            chains.append((mnt, [volume_trash_name(), b"files"]))
            chains.append((mnt, [volume_trash_name(), b"info"]))
    return chains

def op_emptytrash(req):
    req_id = req["id"]
    for base, names in trash_dir_chains():
        try:
            fd = open_dir_chain(base, names)
        except OSError:
            continue
        try:
            empty_dir_fd(fd)
        finally:
            os.close(fd)
    send_done(req_id)

def op_mkdir(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        os.makedirs(to_bytes(path), exist_ok=False)
        send_done(req_id, path=path)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def op_mkfile(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        fd = os.open(to_bytes(path), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o666)
        os.close(fd)
        send_done(req_id, path=path)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def op_rename(req):
    req_id = req["id"]
    path = req.get("path")
    new_name = req.get("newName")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    if not isinstance(new_name, str) or not new_name or "/" in new_name or new_name in (".", ".."):
        send_error(req_id, "EINVAL", "invalid newName", path)
        return
    try:
        src = to_bytes(path)
        dst = os.path.join(os.path.dirname(src), to_bytes(new_name))
        os.rename(src, dst)
        send_done(req_id, path=to_str(dst))
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def walk_targets(path_bytes, recursive):
    yield path_bytes
    if not recursive:
        return
    try:
        if not stat.S_ISDIR(os.lstat(path_bytes).st_mode):
            return
    except OSError:
        return
    for dirpath, dirnames, filenames in os.walk(path_bytes, followlinks=False):
        for name in dirnames + filenames:
            yield os.path.join(dirpath, name)

def op_identity(req):
    req_id = req["id"]
    uid = os.geteuid()
    try:
        user = pwd.getpwuid(uid).pw_name
    except KeyError:
        user = str(uid)
    groups = []
    for gid in list(os.getgroups()) + [os.getegid()]:
        try:
            groups.append(grp.getgrgid(gid).gr_name)
        except KeyError:
            groups.append(str(gid))
    reply = {"id": req_id, "t": "identity", "uid": uid, "user": user,
             "groups": sorted(set(groups)), "root": uid == 0}
    if uid == 0:
        reply["users"] = sorted(p.pw_name for p in pwd.getpwall())
        reply["groups"] = sorted(g.gr_name for g in grp.getgrall())
    emit(reply)
    send_done(req_id)

def op_chmod(req):
    req_id = req["id"]
    path = req.get("path")
    add = req.get("set")
    drop = req.get("clear")
    if not isinstance(path, str) or not isinstance(add, int) or not isinstance(drop, int):
        send_error(req_id, "EINVAL", "path, set and clear required")
        return
    mask = 0o7777
    add &= mask
    drop &= mask
    changed = 0
    try:
        for target in walk_targets(to_bytes(path), bool(req.get("recursive"))):
            fd = os.open(target, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC)
            try:
                lst = os.fstat(fd)
                if stat.S_ISLNK(lst.st_mode):
                    continue
                current = stat.S_IMODE(lst.st_mode)
                updated = (current | add) & ~drop & mask
                if updated != current:
                    os.chmod("/proc/self/fd/%d" % fd, updated)
                    changed += 1
            finally:
                os.close(fd)
        send_done(req_id, path=path, changed=changed)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def lookup_owner(name):
    if isinstance(name, int):
        return name
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        if name.isdigit():
            return int(name)
        raise OSError(errno.EINVAL, "unknown user " + name)

def lookup_group(name):
    if isinstance(name, int):
        return name
    try:
        return grp.getgrnam(name).gr_gid
    except KeyError:
        if name.isdigit():
            return int(name)
        raise OSError(errno.EINVAL, "unknown group " + name)

def op_chown(req):
    req_id = req["id"]
    path = req.get("path")
    owner = req.get("owner")
    group = req.get("group")
    if not isinstance(path, str) or (owner is None and group is None):
        send_error(req_id, "EINVAL", "path and owner or group required")
        return
    try:
        uid = lookup_owner(owner) if owner is not None else -1
        gid = lookup_group(group) if group is not None else -1
        changed = 0
        for target in walk_targets(to_bytes(path), bool(req.get("recursive"))):
            os.lchown(target, uid, gid)
            changed += 1
        send_done(req_id, path=path, changed=changed)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

MIME_TYPE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]*/[A-Za-z0-9][A-Za-z0-9.+_-]*$")
DESKTOP_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]*\.desktop$")
MIME_ENV_PASSTHROUGH = ("XDG_CONFIG_HOME", "XDG_CONFIG_DIRS", "XDG_DATA_HOME", "XDG_DATA_DIRS")


def run_gio_mime(args):
    extra = {key: os.environ[key] for key in MIME_ENV_PASSTHROUGH if os.environ.get(key)}
    return run_trusted("gio", args, timeout=10, extra_env=extra)


def gio_content_type(path):
    try:
        proc = run_gio_mime(["info", "-a", "standard::content-type", path])
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in (proc.stdout or "").splitlines():
        key, _, value = line.strip().partition(": ")
        if key == "standard::content-type" and MIME_TYPE_RE.match(value.strip()):
            return value.strip()
    return ""


def gio_default_app(mime):
    try:
        proc = run_gio_mime(["mime", mime])
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in (proc.stdout or "").splitlines():
        if line.startswith("Default application for"):
            handler = line.rpartition(": ")[2].strip()
            return handler if DESKTOP_ID_RE.match(handler) else ""
    return ""


def op_opener(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str) or not os.path.isabs(path):
        send_error(req_id, "EINVAL", "absolute path required")
        return
    mime = gio_content_type(path)
    if not mime:
        mime = mimetypes.guess_type(to_str(os.path.basename(to_bytes(path))))[0] or ""
    handler = gio_default_app(mime) if mime else ""
    emit({"id": req_id, "t": "opener", "mime": mime, "handler": handler})
    send_done(req_id)


def op_setopener(req):
    req_id = req["id"]
    mime = req.get("mime")
    handler = req.get("handler")
    if (not isinstance(mime, str) or not isinstance(handler, str)
            or not MIME_TYPE_RE.match(mime) or not DESKTOP_ID_RE.match(handler)
            or mime == "inode/directory"):
        send_error(req_id, "EINVAL", "mime and handler required")
        return
    try:
        proc = run_gio_mime(["mime", mime, handler])
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "gio mime timed out")
        return
    if proc.returncode != 0:
        send_error(req_id, "EINTERNAL", (proc.stderr or proc.stdout or "gio mime failed").strip())
        return
    send_done(req_id, mime=mime, handler=handler)

def op_symlink(req):
    req_id = req["id"]
    target = req.get("target")
    path = req.get("path")
    if not isinstance(target, str) or not isinstance(path, str):
        send_error(req_id, "EINVAL", "target and path required")
        return
    try:
        os.symlink(to_bytes(target), to_bytes(path))
        send_done(req_id, path=path)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def op_search(req, cancel_event):
    req_id = req["id"]
    root = req.get("root")
    query = req.get("query", "")
    mode = req.get("mode", "substring")
    max_results = req.get("maxResults") or 2000
    max_depth = req.get("maxDepth")
    if max_depth is None:
        max_depth = 64
    hidden = bool(req.get("hidden", False))
    if not isinstance(root, str):
        send_error(req_id, "EINVAL", "root required")
        return
    root_bytes = to_bytes(root)
    try:
        root_dev = os.stat(root_bytes).st_dev
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), root)
        return
    pattern = None
    if mode == "regex":
        try:
            pattern = re.compile(query)
        except re.error as e:
            send_error(req_id, "EINVAL", str(e))
            return
    query_lower = query.lower()
    matched = 0
    scanned = 0
    stack = [(root_bytes, 0)]
    while stack:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        current, depth = stack.pop()
        try:
            with os.scandir(current) as it:
                for entry in it:
                    if cancel_event.is_set():
                        send_error(req_id, "ECANCELED", "cancelled")
                        return
                    name_str = to_str(entry.name)
                    if name_str == ".git":
                        continue
                    if not hidden and name_str.startswith("."):
                        continue
                    scanned += 1
                    if mode == "substring":
                        is_match = query_lower in name_str.lower()
                    elif mode == "glob":
                        is_match = fnmatch.fnmatch(name_str.lower(), query_lower)
                    elif mode == "regex":
                        is_match = pattern.search(name_str) is not None
                    else:
                        is_match = False
                    if is_match:
                        try:
                            lst = entry.stat(follow_symlinks=False)
                            kind, size, _ = classify(entry.path, lst)
                            mtime = int(lst.st_mtime)
                        except OSError:
                            kind, size, mtime = "o", 0, 0
                        emit({"id": req_id, "t": "hit", "path": to_str(entry.path), "name": name_str,
                              "dir": to_str(current), "kind": kind, "size": size, "mtime": mtime})
                        matched += 1
                        if matched >= max_results:
                            send_done(req_id, truncated=True, scanned=scanned)
                            return
                    try:
                        is_dir = entry.is_dir(follow_symlinks=False)
                        is_symlink = entry.is_symlink()
                    except OSError:
                        is_dir = False
                        is_symlink = False
                    if is_dir and not is_symlink and depth < max_depth:
                        try:
                            st = entry.stat(follow_symlinks=False)
                            if st.st_dev == root_dev:
                                stack.append((entry.path, depth + 1))
                        except OSError:
                            pass
        except OSError:
            continue
    send_done(req_id, truncated=False, scanned=scanned)

def op_peek(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        limit = max(1, min(int(req.get("limit") or PEEK_LIMIT), PEEK_LIMIT))
    except (TypeError, ValueError):
        limit = PEEK_LIMIT
    try:
        b = to_bytes(path)
        if os.path.isdir(b):
            send_error(req_id, "EISDIR", "is a directory", path)
            return
        with open(b, "rb") as f:
            data = f.read(limit + 1)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    truncated = len(data) > limit
    data = data[:limit]
    binary = b"\0" in data[:8192]
    text = ""
    if not binary:
        text = data.decode("utf-8", errors="replace")
        if truncated and text.endswith("\ufffd"):
            text = text.rstrip("\ufffd")
        sample = text[:8192]
        if sample and sample.count("\ufffd") * 10 > len(sample):
            binary = True
            text = ""
    emit({"id": req_id, "t": "peek", "text": text, "binary": binary,
          "truncated": truncated, "size": len(data)})
    send_done(req_id)

THUMB_BUCKETS = (("normal", 128), ("large", 256), ("x-large", 512), ("xx-large", 1024))
THUMB_BUCKET_SIZES = dict(THUMB_BUCKETS)
THUMB_URI_SAFE = "/!$&'()*+,;=:@"
THUMB_TIMEOUT = 20.0
THUMB_MAX_READ = 16 * 1024 * 1024
THUMB_WORKERS = threading.BoundedSemaphore(2)
THUMB_LOCKS_LOCK = threading.Lock()
THUMB_LOCKS = {}
THUMB_TABLES_LOCK = threading.Lock()
THUMB_TABLES = None
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"

def thumb_root():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
    return os.path.join(base, "thumbnails")

def thumb_uri(path_bytes):
    return "file://" + urllib.parse.quote(path_bytes, safe=THUMB_URI_SAFE)

def data_dirs():
    dirs = [os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share")]
    extra = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    dirs.extend(d for d in extra.split(":") if d)
    return dirs

THUMBNAILER_DIRS = ("/usr/local/share/thumbnailers", "/usr/share/thumbnailers")

def trusted_thumbnailer(path):
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and trusted_node(st) and trusted_directory_chain(os.path.dirname(path))

def thumbnail_program(name):
    program = trusted_program(os.path.basename(name))
    if "/" in name and name != program:
        raise FileNotFoundError(errno.ENOENT, "untrusted thumbnailer program", name)
    return program

def parse_thumbnailer(path):
    if not trusted_thumbnailer(path):
        return None
    fields = {}
    in_entry = False
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("["):
                    in_entry = line == "[Thumbnailer Entry]"
                    continue
                if in_entry and "=" in line:
                    key, value = line.split("=", 1)
                    fields[key.strip()] = value.strip()
    except OSError:
        return None
    command = fields.get("Exec", "")
    if not command:
        return None
    try_exec = fields.get("TryExec", "")
    try:
        args = shlex.split(command)
        if not args:
            return None
        thumbnail_program(args[0])
        if try_exec:
            thumbnail_program(try_exec)
    except (OSError, ValueError):
        return None
    mimes = [m.strip() for m in fields.get("MimeType", "").split(";") if m.strip()]
    return {"exec": command, "mimes": mimes}

def load_mime_globs(dirs):
    best = {}
    for d in reversed(dirs):
        try:
            with open(os.path.join(d, "mime", "globs2"), "r", encoding="utf-8", errors="replace") as f:
                for raw in f:
                    parts = raw.strip().split(":")
                    if len(parts) < 3 or parts[0].startswith("#"):
                        continue
                    glob = parts[2]
                    if not glob.startswith("*.") or any(c in glob[2:] for c in "*?[]"):
                        continue
                    try:
                        weight = int(parts[0])
                    except ValueError:
                        continue
                    ext = glob[2:].lower()
                    if ext not in best or weight > best[ext][0]:
                        best[ext] = (weight, parts[1])
        except OSError:
            continue
    return {ext: mime for ext, (weight, mime) in best.items()}

def load_mime_aliases(dirs):
    aliases = {}
    for d in dirs:
        try:
            with open(os.path.join(d, "mime", "aliases"), "r", encoding="utf-8", errors="replace") as f:
                for raw in f:
                    parts = raw.split()
                    if len(parts) == 2:
                        aliases.setdefault(parts[0], parts[1])
        except OSError:
            continue
    return aliases

def thumb_tables():
    global THUMB_TABLES
    with THUMB_TABLES_LOCK:
        if THUMB_TABLES is not None:
            return THUMB_TABLES
        dirs = data_dirs()
        commands = {}
        seen = set()
        for folder in THUMBNAILER_DIRS:
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for name in names:
                if not name.endswith(".thumbnailer") or name in seen:
                    continue
                seen.add(name)
                entry = parse_thumbnailer(os.path.join(folder, name))
                if not entry:
                    continue
                for mime in entry["mimes"]:
                    commands.setdefault(mime, entry["exec"])
        aliases = load_mime_aliases(dirs)
        for alias, canonical in aliases.items():
            if alias in commands and canonical not in commands:
                commands[canonical] = commands[alias]
            elif canonical in commands and alias not in commands:
                commands[alias] = commands[canonical]
        globs = load_mime_globs(dirs)
        if not mimetypes.inited:
            mimetypes.init()
        for ext, mime in mimetypes.types_map.items():
            globs.setdefault(ext.lstrip(".").lower(), mime)
        THUMB_TABLES = {"commands": commands, "globs": globs, "aliases": aliases}
        return THUMB_TABLES

def guess_mime(name):
    tables = thumb_tables()
    lower = name.lower()
    parts = lower.split(".")
    for i in range(1, len(parts)):
        mime = tables["globs"].get(".".join(parts[i:]))
        if mime:
            return tables["aliases"].get(mime, mime)
    return None

def thumbnailer_for(name):
    mime = guess_mime(name)
    if not mime:
        return None, None
    return thumb_tables()["commands"].get(mime), mime

def png_chunk(kind, body):
    return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xffffffff)

def png_chunks(data):
    if not data.startswith(PNG_MAGIC):
        return None
    chunks = []
    pos = 8
    while pos + 8 <= len(data):
        length, kind = struct.unpack(">I4s", data[pos:pos + 8])
        end = pos + 12 + length
        if end > len(data):
            return None
        chunks.append((kind, data[pos + 8:pos + 8 + length]))
        pos = end
        if kind == b"IEND":
            return chunks
    return None

def png_text(chunks):
    out = {}
    for kind, body in chunks:
        if kind == b"tEXt" and b"\0" in body:
            key, value = body.split(b"\0", 1)
            out[key.decode("latin-1")] = value.decode("latin-1")
    return out

def png_with_text(chunks, fields):
    kept = []
    for kind, body in chunks:
        if kind == b"tEXt" and b"\0" in body:
            key = body.split(b"\0", 1)[0].decode("latin-1")
            if key in fields:
                continue
        kept.append((kind, body))
    text = [(b"tEXt", k.encode("latin-1") + b"\0" + v.encode("latin-1", errors="replace"))
            for k, v in fields.items()]
    ordered = kept[:1] + text + kept[1:]
    return PNG_MAGIC + b"".join(png_chunk(kind, body) for kind, body in ordered)

def blank_png():
    header = struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)
    pixels = zlib.compress(b"\x00\x00\x00\x00\x00")
    return [(b"IHDR", header), (b"IDAT", pixels), (b"IEND", b"")]

def thumb_matches(path, uri, mtime):
    try:
        if os.path.getsize(path) > THUMB_MAX_READ:
            return False
        with open(path, "rb") as f:
            chunks = png_chunks(f.read())
    except OSError:
        return False
    if not chunks:
        return False
    meta = png_text(chunks)
    if meta.get("Thumb::URI") != uri:
        return False
    try:
        return int(float(meta.get("Thumb::MTime", ""))) == mtime
    except ValueError:
        return False

def find_thumb(root, name, uri, mtime, bucket):
    start = [b for b, _ in THUMB_BUCKETS].index(bucket)
    for folder, _ in THUMB_BUCKETS[start:]:
        candidate = os.path.join(root, folder, name)
        if thumb_matches(candidate, uri, mtime):
            return candidate
    return None

def failed_before(root, name, uri, mtime):
    fail_root = os.path.join(root, "fail")
    try:
        apps = os.listdir(fail_root)
    except OSError:
        return False
    return any(thumb_matches(os.path.join(fail_root, app, name), uri, mtime) for app in apps)

def private_makedirs(folder):
    if os.path.isdir(folder):
        return
    parent = os.path.dirname(folder)
    if parent and parent != folder:
        private_makedirs(parent)
    try:
        os.mkdir(folder, 0o700)
    except FileExistsError:
        pass

def write_png(path, chunks, fields):
    folder = os.path.dirname(path)
    private_makedirs(folder)
    fd, tmp = tempfile.mkstemp(prefix=".omafile-", suffix=".png", dir=folder)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(png_with_text(chunks, fields))
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

def expand_thumb_command(command, path, uri, out, size):
    try:
        args = shlex.split(command)
    except ValueError:
        return None
    subs = {"i": path, "u": uri, "o": out, "s": str(size), "%": "%"}
    result = []
    for arg in args:
        piece = []
        i = 0
        while i < len(arg):
            if arg[i] == "%" and i + 1 < len(arg) and arg[i + 1] in subs:
                piece.append(subs[arg[i + 1]])
                i += 2
            else:
                piece.append(arg[i])
                i += 1
        result.append("".join(piece))
    return result

def run_thumbnailer(args, cancel_event):
    try:
        program = thumbnail_program(args[0])
        proc = subprocess.Popen([program] + args[1:], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, env=trusted_env(), start_new_session=True)
    except OSError:
        return "failed"
    try:
        os.setpriority(os.PRIO_PROCESS, proc.pid, 10)
    except OSError:
        pass
    deadline = time.monotonic() + THUMB_TIMEOUT
    while True:
        try:
            code = proc.wait(timeout=0.2)
            return "ok" if code == 0 else "failed"
        except subprocess.TimeoutExpired:
            if cancel_event.is_set() or time.monotonic() > deadline:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass
                proc.wait()
                return "cancelled" if cancel_event.is_set() else "timeout"

def acquire_thumb_worker(cancel_event):
    while not cancel_event.is_set():
        if THUMB_WORKERS.acquire(timeout=0.2):
            return True
    return False

def generate_thumb(root, name, src, uri, st, bucket, command, mime, cancel_event):
    size = THUMB_BUCKET_SIZES[bucket]
    folder = os.path.join(root, bucket)
    private_makedirs(folder)
    fd, out = tempfile.mkstemp(prefix=".omafile-", suffix=".png", dir=folder)
    os.close(fd)
    try:
        args = expand_thumb_command(command, to_str(src), uri, out, size)
        if not args:
            return "failed"
        status = run_thumbnailer(args, cancel_event)
        if status != "ok":
            return status
        try:
            with open(out, "rb") as f:
                chunks = png_chunks(f.read(THUMB_MAX_READ))
        except OSError:
            chunks = None
        if not chunks:
            return "failed"
        fields = {"Thumb::URI": uri, "Thumb::MTime": str(int(st.st_mtime)),
                  "Thumb::Size": str(st.st_size), "Thumb::Mimetype": mime,
                  "Software": "Omafile " + VERSION}
        write_png(os.path.join(folder, name), chunks, fields)
        return "ok"
    finally:
        try:
            os.unlink(out)
        except OSError:
            pass

def op_thumb(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    bucket = req.get("size")
    if bucket not in THUMB_BUCKET_SIZES:
        bucket = "large"
    if not isinstance(path, str) or not path.startswith("/"):
        send_error(req_id, "EINVAL", "absolute path required")
        return
    src = to_bytes(path)
    try:
        st = os.stat(src)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
        return
    if not stat.S_ISREG(st.st_mode):
        send_error(req_id, "EINVAL", "not a regular file", path)
        return
    root = thumb_root()
    real = os.path.realpath(src)
    if real.startswith(to_bytes(root) + b"/"):
        send_error(req_id, "EUNSUPPORTED", "file is inside the thumbnail cache", path)
        return
    uri = thumb_uri(src)
    mtime = int(st.st_mtime)
    name = hashlib.md5(uri.encode("ascii")).hexdigest() + ".png"
    found = find_thumb(root, name, uri, mtime, bucket)
    if not found:
        command, mime = thumbnailer_for(os.path.basename(path))
        if not command:
            send_error(req_id, "EUNSUPPORTED", "no thumbnailer for this file type", path)
            return
        if failed_before(root, name, uri, mtime):
            send_error(req_id, "EUNSUPPORTED", "thumbnailer failed on this file before", path)
            return
        with THUMB_LOCKS_LOCK:
            lock = THUMB_LOCKS.setdefault(name + bucket, threading.Lock())
        with lock:
            found = find_thumb(root, name, uri, mtime, bucket)
            if not found:
                if not acquire_thumb_worker(cancel_event):
                    send_error(req_id, "ECANCELED", "cancelled")
                    return
                try:
                    status = generate_thumb(root, name, src, uri, st, bucket, command, mime, cancel_event)
                except OSError as e:
                    send_error(req_id, errno_code(e), e.strerror or str(e), path)
                    return
                finally:
                    THUMB_WORKERS.release()
                if status == "cancelled":
                    send_error(req_id, "ECANCELED", "cancelled")
                    return
                if status == "failed":
                    try:
                        marker = os.path.join(root, "fail", "omafile-" + VERSION, name)
                        write_png(marker, blank_png(), {"Thumb::URI": uri, "Thumb::MTime": str(mtime),
                                                        "Software": "Omafile " + VERSION})
                    except OSError:
                        pass
                if status != "ok":
                    send_error(req_id, "EUNSUPPORTED", "thumbnailer " + status, path)
                    return
                found = os.path.join(root, bucket, name)
    emit({"id": req_id, "t": "thumb", "thumb": found})
    send_done(req_id)

def op_thumbtypes(req):
    req_id = req["id"]
    tables = thumb_tables()
    commands = tables["commands"]
    aliases = tables["aliases"]
    exts = sorted(ext for ext, mime in tables["globs"].items()
                  if "." not in ext and aliases.get(mime, mime) in commands)
    emit({"id": req_id, "t": "thumbtypes", "exts": exts})
    send_done(req_id)

def gtk_bookmarks_file():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    return os.path.join(base, "gtk-3.0", "bookmarks")

def read_bookmark_lines():
    try:
        with open(gtk_bookmarks_file(), "rb") as f:
            raw = f.read().decode("utf-8", "surrogateescape")
    except FileNotFoundError:
        return []
    out = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        uri, _, label = line.partition(" ")
        out.append({"uri": uri, "label": label.strip(), "path": uri_to_path(uri)})
    return out

def op_bookmarks(req):
    req_id = req["id"]
    try:
        os.makedirs(os.path.dirname(gtk_bookmarks_file()), exist_ok=True)
    except OSError:
        pass
    try:
        items = read_bookmark_lines()
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), gtk_bookmarks_file())
        return
    emit({"id": req_id, "t": "bookmarks", "file": gtk_bookmarks_file(),
          "dir": os.path.dirname(gtk_bookmarks_file()),
          "items": [{"path": i["path"], "label": i["label"]} for i in items if i["path"]]})
    send_done(req_id)

def op_setbookmarks(req):
    req_id = req["id"]
    items = req.get("items")
    if not isinstance(items, list):
        send_error(req_id, "EINVAL", "items required")
        return
    lines = []
    seen = set()
    for item in items:
        path = item.get("path") if isinstance(item, dict) else None
        if not isinstance(path, str) or not path.startswith("/") or path in seen:
            continue
        seen.add(path)
        uri = "file://" + urllib.parse.quote(to_bytes(os.path.normpath(path)), safe=THUMB_URI_SAFE)
        label = str(item.get("label") or "").replace("\n", " ").strip()
        lines.append(uri + (" " + label if label else ""))
    try:
        existing = read_bookmark_lines()
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), gtk_bookmarks_file())
        return
    for other in existing:
        if not other["path"]:
            lines.append(other["uri"] + (" " + other["label"] if other["label"] else ""))
    target = gtk_bookmarks_file()
    folder = os.path.dirname(target)
    try:
        os.makedirs(folder, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".bookmarks-", dir=folder)
        with os.fdopen(fd, "wb") as f:
            f.write(("\n".join(lines) + ("\n" if lines else "")).encode("utf-8", "surrogateescape"))
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), target)
        return
    send_done(req_id, count=len(lines))

COUNT_LIMIT = 100000

def op_counts(req, cancel_event):
    req_id = req["id"]
    paths = req.get("paths") or []
    hidden = bool(req.get("hidden", False))
    counts = {}
    for path in paths[:500]:
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        if not isinstance(path, str):
            continue
        n = 0
        try:
            with os.scandir(to_bytes(path)) as it:
                for entry in it:
                    if not hidden and entry.name.startswith(b"."):
                        continue
                    n += 1
                    if n >= COUNT_LIMIT:
                        break
        except OSError:
            n = -1
        counts[path] = n
    emit({"id": req_id, "t": "counts", "counts": counts, "limit": COUNT_LIMIT})
    send_done(req_id)

def op_freespace(req):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str):
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        b = to_bytes(path)
        st = os.statvfs(b)
        total = st.f_frsize * st.f_blocks
        free = st.f_frsize * st.f_bavail
        used = total - st.f_frsize * st.f_bfree
        mount = to_str(find_mount_point(b))
        emit({"id": req_id, "t": "space", "total": total, "free": free, "used": used, "mount": mount})
        send_done(req_id)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), path)

def run_tool(argv):
    try:
        proc = subprocess.run(argv, shell=False, capture_output=True, timeout=5)
    except (FileNotFoundError, OSError):
        return None
    if proc.returncode != 0:
        return None
    try:
        return json.loads(proc.stdout.decode("utf-8", "replace"))
    except ValueError:
        return None

def flatten_lsblk(devices):
    out = []
    for d in devices or []:
        out.append(d)
        out.extend(flatten_lsblk(d.get("children")))
    return out

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or ("/run/user/%d" % os.getuid())
GVFS_ROOT = os.path.join(RUNTIME_DIR, "gvfs")


def unquote_path(value):
    try:
        return to_str(percent_decode(value))
    except Exception:
        return value


def gvfs_fields(name):
    fields = {}
    if ":" in name:
        for part in name.split(":", 1)[1].split(","):
            if "=" in part:
                key, value = part.split("=", 1)
                fields[key] = unquote_path(value)
    return fields

def gvfs_label(name):
    scheme = name.split("-")[0] if "-" in name else name
    fields = {}
    if ":" in name:
        for part in name.split(":", 1)[1].split(","):
            if "=" in part:
                key, value = part.split("=", 1)
                fields[key] = unquote_path(value)
    share = fields.get("share") or fields.get("volume") or fields.get("path") or ""
    server = fields.get("server") or fields.get("host") or ""
    share = share.strip("/")
    if share and server:
        return share + " on " + server, scheme
    if server:
        return server, scheme
    return name, scheme


TRUSTED_BIN_DIRS = ("/usr/bin", "/bin", "/usr/local/bin")
MAX_CAPTURE_BYTES = 1 << 20
TRUSTED_ENV_PASSTHROUGH = (
    "DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS")
UNSAFE_WRITE_BITS = stat.S_IWGRP | stat.S_IWOTH


def trusted_node(st):
    return st.st_uid == 0 and not (st.st_mode & UNSAFE_WRITE_BITS)


def trusted_directory_chain(directory):
    current = os.path.abspath(directory)
    while True:
        try:
            st = os.lstat(current)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            return False
        if not trusted_node(st):
            return False
        parent = os.path.dirname(current)
        if parent == current:
            return True
        current = parent


def trusted_program(name):
    program = str(name or "")
    if not program or "/" in program or program in (".", ".."):
        raise FileNotFoundError(errno.ENOENT, "invalid program name", program)
    for directory in TRUSTED_BIN_DIRS:
        candidate = os.path.join(directory, program)
        try:
            st = os.lstat(candidate)
        except OSError:
            continue
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
            continue
        if not trusted_node(st) or not (st.st_mode & stat.S_IXUSR):
            continue
        if os.path.realpath(candidate) != candidate:
            continue
        if not trusted_directory_chain(directory):
            continue
        return candidate
    raise FileNotFoundError(errno.ENOENT, "no trusted executable found", program)


def trusted_env():
    env = {"PATH": "/usr/bin:/bin", "HOME": HOME, "LC_ALL": "C.UTF-8"}
    for key in TRUSTED_ENV_PASSTHROUGH:
        value = os.environ.get(key)
        if value:
            env[key] = value
    return env


def kill_process_group(proc):
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.kill()
        except OSError:
            pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass


def run_trusted(name, args, stdin_text=None, timeout=30, limit=MAX_CAPTURE_BYTES, extra_env=None):
    program = trusted_program(name)
    argv = [program] + list(args)
    env = trusted_env()
    if extra_env:
        env.update(extra_env)
    proc = subprocess.Popen(
        argv,
        stdin=subprocess.PIPE if stdin_text is not None else subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        shell=False,
        close_fds=True,
        start_new_session=True)
    pending = stdin_text.encode("utf-8", "replace") if stdin_text is not None else b""
    captured_out = bytearray()
    captured_err = bytearray()
    buffers = {proc.stdout: captured_out, proc.stderr: captured_err}
    open_readers = [proc.stdout, proc.stderr]
    deadline = time.monotonic() + timeout
    try:
        while open_readers or pending:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            writers = [proc.stdin] if pending and proc.stdin else []
            readable, writable, _ = select.select(
                open_readers, writers, [], min(remaining, 0.5))
            for stream in writable:
                try:
                    written = os.write(stream.fileno(), pending)
                    pending = pending[written:]
                except (BrokenPipeError, OSError):
                    pending = b""
                if not pending:
                    try:
                        stream.close()
                    except OSError:
                        pass
                    proc.stdin = None
            for stream in readable:
                chunk = os.read(stream.fileno(), 65536)
                if not chunk:
                    open_readers.remove(stream)
                    continue
                buffer = buffers[stream]
                if len(buffer) < limit:
                    buffer.extend(chunk[:limit - len(buffer)])
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise subprocess.TimeoutExpired(argv, timeout)
        proc.wait(timeout=remaining)
    except BaseException:
        kill_process_group(proc)
        raise
    finally:
        pending = b""
        for stream in (proc.stdin, proc.stdout, proc.stderr):
            if stream is not None:
                try:
                    stream.close()
                except OSError:
                    pass
    return subprocess.CompletedProcess(
        argv, proc.returncode,
        captured_out.decode("utf-8", "replace"),
        captured_err.decode("utf-8", "replace"))


def gvfs_mounts():
    out = []
    try:
        entries = sorted(os.listdir(to_bytes(GVFS_ROOT)))
    except OSError:
        return out
    for raw in entries:
        name = to_str(raw)
        target = os.path.join(GVFS_ROOT, name)
        label, scheme = gvfs_label(name)
        fields = gvfs_fields(name)
        free = None
        total = None
        try:
            st = os.statvfs(to_bytes(target))
            total = st.f_frsize * st.f_blocks
            free = st.f_frsize * st.f_bavail
        except OSError:
            pass
        out.append({
            "name": label, "path": target, "label": label, "size": total,
            "fstype": scheme, "mount": target, "removable": False,
            "network": True, "gvfs": True, "free": free, "total": total,
            "host": fields.get("host") or fields.get("server") or "", "user": fields.get("user") or "",
            "port": fields.get("port") or "",
        })
    return out


DESKTOP_ID = "xyzlab.omafile.desktop"
DESKTOP_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "applications")
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OPEN_BIN = os.path.join(PLUGIN_DIR, "bin", "omafile-open")
ICON_FILE = os.path.join(PLUGIN_DIR, "icon.png")
DESKTOP_TEMPLATE = """[Desktop Entry]
Type=Application
Name=Omafile
Comment=Browse your files
Exec={open_bin} %f
Icon={icon}
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
StartupNotify=false
"""


def desktop_icon():
    if os.path.exists(ICON_FILE):
        return ICON_FILE
    return "system-file-manager"


def desktop_body():
    return DESKTOP_TEMPLATE.format(open_bin=OPEN_BIN, icon=desktop_icon())


def current_default_handler():
    try:
        proc = subprocess.run(
            ["xdg-mime", "query", "default", "inode/directory"],
            capture_output=True, text=True, timeout=10, shell=False)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    return (proc.stdout or "").strip()


def refresh_desktop_database():
    try:
        subprocess.run(
            ["update-desktop-database", DESKTOP_DIR],
            capture_output=True, text=True, timeout=20, shell=False)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass


DBUS_SERVICE_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "dbus-1", "services")
DBUS_SERVICE_NAME = "org.freedesktop.FileManager1.service"
FILEMANAGER1_BIN = os.path.join(PLUGIN_DIR, "bin", "omafile-filemanager1")


def filemanager1_available():
    if not os.path.exists(FILEMANAGER1_BIN):
        return False
    try:
        subprocess.run(
            [sys.executable, "-c", "import gi; gi.require_version('Gio','2.0'); from gi.repository import Gio"],
            capture_output=True, timeout=10, shell=False, check=True)
    except (FileNotFoundError, subprocess.TimeoutExpired, subprocess.CalledProcessError):
        return False
    return True


def install_filemanager1():
    if not filemanager1_available():
        return False
    body = "[D-BUS Service]\nName=org.freedesktop.FileManager1\nExec=%s\n" % FILEMANAGER1_BIN
    try:
        os.makedirs(DBUS_SERVICE_DIR, exist_ok=True)
        with open(os.path.join(DBUS_SERVICE_DIR, DBUS_SERVICE_NAME), "w", encoding="utf-8") as f:
            f.write(body)
    except OSError:
        return False
    return True


def remove_filemanager1():
    try:
        os.unlink(os.path.join(DBUS_SERVICE_DIR, DBUS_SERVICE_NAME))
    except OSError:
        pass


def filemanager1_installed():
    return os.path.exists(os.path.join(DBUS_SERVICE_DIR, DBUS_SERVICE_NAME))


def refresh_stale_desktop_entry():
    desktop_path = os.path.join(DESKTOP_DIR, DESKTOP_ID)
    wanted = desktop_body()
    try:
        with open(desktop_path, "r", encoding="utf-8") as f:
            if f.read() == wanted:
                return
    except OSError:
        return
    try:
        with open(desktop_path, "w", encoding="utf-8") as f:
            f.write(wanted)
    except OSError:
        return
    refresh_desktop_database()


def op_defaultfm(req):
    req_id = req["id"]
    refresh_stale_desktop_entry()
    handler = current_default_handler()
    emit({
        "id": req_id, "t": "done",
        "handler": handler,
        "isOmafile": handler == DESKTOP_ID,
        "installed": os.path.exists(os.path.join(DESKTOP_DIR, DESKTOP_ID)),
        "showItems": filemanager1_installed(),
        "showItemsAvailable": filemanager1_available(),
    })


def op_setdefaultfm(req, cancel_event):
    req_id = req["id"]
    enabled = bool(req.get("enabled", False))
    previous = str(req.get("previous") or "")
    desktop_path = os.path.join(DESKTOP_DIR, DESKTOP_ID)
    if not shutil.which("xdg-mime"):
        send_error(req_id, "EUNSUPPORTED", "xdg-mime is not installed")
        return
    if enabled:
        was = current_default_handler()
        try:
            os.makedirs(DESKTOP_DIR, exist_ok=True)
            with open(desktop_path, "w", encoding="utf-8") as f:
                f.write(desktop_body())
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), desktop_path)
            return
        refresh_desktop_database()
        try:
            subprocess.run(
                ["xdg-mime", "default", DESKTOP_ID, "inode/directory"],
                capture_output=True, text=True, timeout=15, shell=False)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            send_error(req_id, "EUNSUPPORTED", "could not set the default handler")
            return
        show_items = install_filemanager1()
        emit({"id": req_id, "t": "done", "handler": current_default_handler(),
              "isOmafile": current_default_handler() == DESKTOP_ID,
              "showItems": show_items,
              "showItemsAvailable": filemanager1_available(),
              "previous": was if was != DESKTOP_ID else previous})
        return
    restore = previous if previous and previous != DESKTOP_ID else "org.gnome.Nautilus.desktop"
    try:
        subprocess.run(
            ["xdg-mime", "default", restore, "inode/directory"],
            capture_output=True, text=True, timeout=15, shell=False)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    try:
        os.unlink(desktop_path)
    except OSError:
        pass
    remove_filemanager1()
    refresh_desktop_database()
    emit({"id": req_id, "t": "done", "handler": current_default_handler(),
          "isOmafile": current_default_handler() == DESKTOP_ID,
          "showItems": False, "previous": ""})


RECENT_FILE = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"),
    "recently-used.xbel")


def recent_rows(limit):
    try:
        tree = xml.etree.ElementTree.parse(RECENT_FILE)
    except (OSError, xml.etree.ElementTree.ParseError):
        return []
    marks = []
    for bookmark in tree.getroot().findall("bookmark"):
        href = bookmark.get("href") or ""
        if not href.startswith("file://"):
            continue
        raw = percent_decode(href[7:])
        marks.append((bookmark.get("visited") or bookmark.get("modified") or "", raw))
    marks.sort(key=lambda item: item[0], reverse=True)
    rows = []
    seen = set()
    for visited, path_bytes in marks:
        if path_bytes in seen:
            continue
        seen.add(path_bytes)
        try:
            lst = os.lstat(path_bytes)
        except OSError:
            continue
        path_str = to_str(path_bytes)
        kind, size, link_target = classify(path_bytes, lst)
        rows.append([
            os.path.basename(path_str) or path_str, kind, size,
            int(lst.st_mtime), lst.st_mode, link_target, path_str,
        ])
        if len(rows) >= limit:
            break
    return rows


def op_recent(req, cancel_event):
    req_id = req["id"]
    try:
        limit = int(req.get("limit") or 200)
    except (TypeError, ValueError):
        limit = 200
    rows = recent_rows(max(1, limit))
    chunk_size = 200
    for i in range(0, len(rows), chunk_size):
        if cancel_event.is_set():
            send_error(req_id, "ECANCELED", "cancelled")
            return
        emit({"id": req_id, "t": "entries", "c": rows[i:i + chunk_size]})
    send_done(req_id, total=len(rows))


def op_netdiscover(req):
    req_id = req["id"]
    found = []
    try:
        proc = run_trusted("gio", ["list", "-u", "network:///"], timeout=10)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        emit({"id": req_id, "t": "drives", "drives": found})
        send_done(req_id)
        return
    for line in (proc.stdout or "").splitlines():
        parts = line.split("\t")
        name = parts[0].strip()
        uri = parts[-1].strip() if len(parts) > 1 else ""
        if not name:
            continue
        if not uri or not uri.startswith(("smb://", "sftp://", "ftp://", "dav://", "davs://", "nfs://")):
            uri = "network:///" + name
        found.append({"name": name, "label": name, "uri": uri, "network": True})
    emit({"id": req_id, "t": "drives", "drives": found})
    send_done(req_id)


def op_netmounts(req):
    emit({"id": req["id"], "t": "drives", "drives": gvfs_mounts()})
    send_done(req["id"])


def gio_local_folder(uri):
    try:
        proc = run_trusted("gio", ["info", "-a", "standard::type", uri], timeout=15)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    for line in (proc.stdout or "").splitlines():
        if line.startswith("local path:"):
            local = line.split(":", 1)[1].strip()
            local_bytes = to_bytes(local)
            if os.path.isdir(local_bytes):
                return local
            if os.path.exists(local_bytes):
                return to_str(os.path.dirname(local_bytes))
    return ""

def op_mounturi(req, cancel_event):
    req_id = req["id"]
    uri = req.get("uri")
    if not isinstance(uri, str) or not uri.strip():
        send_error(req_id, "EINVAL", "address required")
        return
    uri = uri.strip()
    anonymous = bool(req.get("anonymous", False))
    user = str(req.get("user") or "")
    domain = str(req.get("domain") or "")
    password = str(req.get("password") or "")
    before = set(m["mount"] for m in gvfs_mounts())
    if anonymous:
        answers = "\n\n\n\n"
    else:
        answers = user + "\n" + domain + "\n" + password + "\n"
    try:
        proc = run_trusted("gio", ["mount", uri], stdin_text=answers, timeout=40)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "the server did not respond")
        return
    message = (proc.stderr or proc.stdout or "").strip()
    after = gvfs_mounts()
    fresh = [m for m in after if m["mount"] not in before]
    if proc.returncode != 0 and not fresh:
        if "already mounted" in message.lower():
            match = [m for m in after if uri.rstrip("/").endswith(m["label"].split(" on ")[0])]
            target = gio_local_folder(uri) or (match[0]["mount"] if match else "")
            emit({"id": req_id, "t": "done", "path": target, "mounts": after, "message": "already connected"})
            return
        send_error(req_id, "EMOUNT", message or "could not connect")
        return
    target = gio_local_folder(uri) or (fresh[0]["mount"] if fresh else "")
    emit({"id": req_id, "t": "done", "path": target, "mounts": after, "message": message})


def op_unmounturi(req, cancel_event):
    req_id = req["id"]
    target = req.get("path") or req.get("uri")
    if not isinstance(target, str) or not target.strip():
        send_error(req_id, "EINVAL", "path required")
        return
    try:
        proc = run_trusted("gio", ["mount", "-u", target.strip()], timeout=30)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "gio is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "unmount timed out")
        return
    if proc.returncode != 0:
        send_error(req_id, "EMOUNT", (proc.stderr or proc.stdout or "could not disconnect").strip())
        return
    emit({"id": req_id, "t": "done", "mounts": gvfs_mounts()})


NETWORK_FILESYSTEMS = frozenset([
    "cifs", "smb3", "nfs", "nfs4", "sshfs", "fuse.sshfs", "davfs", "fuse.rclone",
    "fuse.gvfsd-fuse", "9p", "ceph", "glusterfs",
])

USER_VOLUME_ROOTS = ("/mnt", "/media", "/run/media")

PSEUDO_FILESYSTEMS = frozenset([
    "proc", "sysfs", "devtmpfs", "devpts", "cgroup", "cgroup2", "securityfs",
    "pstore", "bpf", "configfs", "debugfs", "tracefs", "fusectl", "mqueue",
    "hugetlbfs", "autofs", "binfmt_misc", "efivarfs", "ramfs", "squashfs",
])


def is_user_volume(target, fstype):
    if not target or target == "/":
        return False
    if fstype in PSEUDO_FILESYSTEMS:
        return False
    for root in USER_VOLUME_ROOTS:
        if target == root:
            return False
        if target.startswith(root + "/"):
            return True
    return False


CLIP_TIMEOUT = 3.0
CLIP_IMAGE_TYPES = ("image/png", "image/jpeg", "image/webp", "image/gif", "image/bmp")
CLIP_IMAGE_EXT = {"image/png": "png", "image/jpeg": "jpg", "image/webp": "webp", "image/gif": "gif", "image/bmp": "bmp"}

def wl_paste(args, limit=16 * 1024 * 1024):
    try:
        tool = trusted_program("wl-paste")
        out = subprocess.run([tool] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, env=trusted_env(), timeout=CLIP_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return b""
    return out.stdout[:limit]

def unique_child(dest, stem, ext):
    candidate = os.path.join(dest, "%s.%s" % (stem, ext))
    n = 2
    while os.path.lexists(candidate):
        candidate = os.path.join(dest, "%s %d.%s" % (stem, n, ext))
        n += 1
    return candidate

def op_clipimage(req):
    req_id = req["id"]
    dest = req.get("dest")
    mime = req.get("type")
    if not isinstance(dest, str) or mime not in CLIP_IMAGE_EXT:
        send_error(req_id, "EINVAL", "dest and an image type are required")
        return
    if not os.path.isdir(to_bytes(dest)):
        send_error(req_id, "ENOTDIR", "dest is not a directory", dest)
        return
    data = wl_paste(["--type", mime], limit=256 * 1024 * 1024)
    if not data:
        send_error(req_id, "ENOENT", "the clipboard has no image")
        return
    target = unique_child(dest, "Pasted image", CLIP_IMAGE_EXT[mime])
    try:
        fd = os.open(to_bytes(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), target)
        return
    emit({"id": req_id, "t": "clipimage", "path": target})
    send_done(req_id)


def file_uri(path):
    from urllib.parse import quote
    return "file://" + quote(path, safe="/-._~!$&'()*+,;=:@")


def uri_to_path(uri):
    from urllib.parse import unquote, urlsplit
    uri = uri.strip()
    if not uri or uri.startswith("#"):
        return None
    parts = urlsplit(uri)
    if parts.scheme != "file" or parts.netloc not in ("", "localhost"):
        return None
    return unquote(parts.path)


def clipboard_payload(mode, paths):
    uris = [file_uri(x) for x in paths if isinstance(x, str)]
    if mode == "cut":
        return "x-special/gnome-copied-files", "cut\n" + "\n".join(uris)
    return "text/uri-list", "\r\n".join(uris) + "\r\n"


def parse_gnome_copied_files(text):
    lines = text.splitlines()
    mode = "copy"
    if lines and lines[0].strip() in ("copy", "cut"):
        mode = lines[0].strip()
        lines = lines[1:]
    return mode, [x for x in (uri_to_path(u) for u in lines) if x]


def op_clipset(req):
    req_id = req["id"]
    mode = req.get("mode")
    paths = req.get("paths") or []
    if mode not in ("copy", "cut") or not paths:
        send_error(req_id, "EINVAL", "mode and paths are required")
        return
    mime, data = clipboard_payload(mode, paths)
    try:
        subprocess.run([trusted_program("wl-copy"), "--type", mime], input=data.encode("utf-8"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=trusted_env(), timeout=5)
    except (OSError, FileNotFoundError, subprocess.TimeoutExpired) as e:
        send_error(req_id, "EUNSUPPORTED", str(e))
        return
    send_done(req_id)


def op_clipget(req):
    req_id = req["id"]
    try:
        wl_paste = trusted_program("wl-paste")
        listed = subprocess.run([wl_paste, "--list-types"], capture_output=True, env=trusted_env(), timeout=3)
    except (OSError, FileNotFoundError, subprocess.TimeoutExpired) as e:
        send_error(req_id, "EUNSUPPORTED", str(e))
        return
    types = listed.stdout.decode("utf-8", "replace").split()
    mode = "copy"
    paths = []
    try:
        if "x-special/gnome-copied-files" in types:
            got = subprocess.run([wl_paste, "--no-newline", "--type", "x-special/gnome-copied-files"],
                                 capture_output=True, env=trusted_env(), timeout=3)
            mode, paths = parse_gnome_copied_files(got.stdout.decode("utf-8", "replace"))
        elif "text/uri-list" in types:
            got = subprocess.run([wl_paste, "--no-newline", "--type", "text/uri-list"],
                                 capture_output=True, env=trusted_env(), timeout=3)
            body = got.stdout.decode("utf-8", "replace")
            paths = [x for x in (uri_to_path(u) for u in body.splitlines()) if x]
    except (OSError, subprocess.TimeoutExpired) as e:
        send_error(req_id, "EFAIL", str(e))
        return
    send_done(req_id, mode=mode, paths=paths,
              image="" if paths else next((mime for mime in CLIP_IMAGE_TYPES if mime in types), ""))


def op_clipclear(req):
    try:
        subprocess.run([trusted_program("wl-copy"), "--clear"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, env=trusted_env(), timeout=3)
    except (OSError, FileNotFoundError, subprocess.TimeoutExpired):
        pass
    send_done(req["id"])


def op_samedev(req):
    req_id = req["id"]
    try:
        a = os.lstat(to_bytes(req.get("path") or ""))
        b = os.stat(to_bytes(req.get("dest") or ""))
        send_done(req_id, same=a.st_dev == b.st_dev)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e))


UNMOUNTABLE_FSTYPES = frozenset([
    "swap", "crypto_LUKS", "LVM2_member", "linux_raid_member", "zfs_member",
    "bcache", "ddf_raid_member", "isw_raid_member", "BitLocker",
])
SYSTEM_PARTITION_TYPES = {
    "efi_system": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b",
    "microsoft_reserved": "e3c9e316-0b5c-4db8-817d-f92df00215ae",
    "windows_recovery": "de94bba4-06d1-4d40-a16a-bfd50179d6ac",
    "bios_boot": "21686148-6449-6e6f-744e-656564454649",
}
HIDDEN_PARTTYPES = frozenset(SYSTEM_PARTITION_TYPES.values())


def mountable_device(dev):
    fstype = dev.get("fstype")
    if not fstype or fstype in UNMOUNTABLE_FSTYPES:
        return False
    if str(dev.get("parttype") or "").lower() in HIDDEN_PARTTYPES:
        return False
    return str(dev.get("path") or "").startswith("/dev/")


def valid_block_device(value):
    return isinstance(value, str) and value.startswith("/dev/") and ".." not in value


def op_mountdev(req, cancel_event):
    req_id = req["id"]
    device = req.get("device")
    if not valid_block_device(device):
        send_error(req_id, "EINVAL", "block device required")
        return
    try:
        proc = run_trusted("udisksctl", ["mount", "-b", device], timeout=90)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "udisksctl is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "mount timed out")
        return
    out = (proc.stdout or "").strip()
    if proc.returncode != 0:
        send_error(req_id, "EMOUNT", (proc.stderr or out or "could not mount").strip())
        return
    path = out.split(" at ", 1)[1].strip().rstrip(".") if " at " in out else ""
    emit({"id": req_id, "t": "done", "path": path})


def op_unmountdev(req, cancel_event):
    req_id = req["id"]
    device = req.get("device")
    if not valid_block_device(device):
        send_error(req_id, "EINVAL", "block device required")
        return
    try:
        proc = run_trusted("udisksctl", ["unmount", "-b", device], timeout=60)
    except FileNotFoundError:
        send_error(req_id, "EUNSUPPORTED", "udisksctl is not installed")
        return
    except subprocess.TimeoutExpired:
        send_error(req_id, "ETIMEDOUT", "unmount timed out")
        return
    if proc.returncode != 0:
        send_error(req_id, "EMOUNT", (proc.stderr or proc.stdout or "could not unmount").strip())
        return
    emit({"id": req_id, "t": "done"})


def op_drives(req):
    req_id = req["id"]
    drives = []
    lsblk_data = run_tool(["lsblk", "-J", "-b", "-o", "NAME,PATH,LABEL,SIZE,FSTYPE,MOUNTPOINT,RM,PARTTYPE"])
    findmnt_data = run_tool(["findmnt", "-J", "-b"])
    space_by_mount = {}
    mounted_volumes = []
    if findmnt_data:
        def walk(fs_list):
            for fs in fs_list or []:
                tgt = fs.get("target")
                if tgt:
                    try:
                        st = os.statvfs(to_bytes(tgt))
                        space_by_mount[tgt] = (st.f_frsize * st.f_blocks, st.f_frsize * st.f_bavail)
                    except OSError:
                        pass
                    mounted_volumes.append((tgt, fs.get("source"), fs.get("fstype")))
                walk(fs.get("children"))
        walk(findmnt_data.get("filesystems"))
    if lsblk_data:
        for dev in flatten_lsblk(lsblk_data.get("blockdevices")):
            mount = dev.get("mountpoint")
            total = None
            free = None
            if mount and mount in space_by_mount:
                total, free = space_by_mount[mount]
            drives.append({
                "name": dev.get("name"), "path": dev.get("path"), "label": dev.get("label"),
                "size": dev.get("size"), "fstype": dev.get("fstype"), "mount": mount,
                "removable": bool(dev.get("rm")), "free": free, "total": total,
                "mountable": not mount and mountable_device(dev),
            })
    seen_mounts = set(d["mount"] for d in drives if d.get("mount"))
    for target, source, fstype in mounted_volumes:
        if target in seen_mounts:
            continue
        if not is_user_volume(target, fstype):
            continue
        total = None
        free = None
        if target in space_by_mount:
            total, free = space_by_mount[target]
        drives.append({
            "name": os.path.basename(target) or target, "path": target,
            "label": os.path.basename(target) or target, "size": total,
            "fstype": fstype, "mount": target, "removable": False,
            "network": fstype in NETWORK_FILESYSTEMS,
            "free": free, "total": total,
        })
        seen_mounts.add(target)
    for share in gvfs_mounts():
        if share["mount"] in seen_mounts:
            continue
        drives.append(share)
        seen_mounts.add(share["mount"])
    emit({"id": req_id, "t": "drives", "drives": drives})
    send_done(req_id)

XDG_DEFAULTS = {
    "desktop": "Desktop", "documents": "Documents", "downloads": "Downloads",
    "music": "Music", "pictures": "Pictures", "videos": "Videos",
    "templates": "Templates", "publicshare": "Public",
}
XDG_KEYS = {
    "XDG_DESKTOP_DIR": "desktop", "XDG_DOCUMENTS_DIR": "documents",
    "XDG_DOWNLOAD_DIR": "downloads", "XDG_MUSIC_DIR": "music",
    "XDG_PICTURES_DIR": "pictures", "XDG_VIDEOS_DIR": "videos",
    "XDG_TEMPLATES_DIR": "templates", "XDG_PUBLICSHARE_DIR": "publicshare",
}

def op_dirs(req):
    req_id = req["id"]
    result = {}
    for key, name in XDG_DEFAULTS.items():
        result[key] = os.path.join(HOME, name)
    config_file = os.path.join(HOME, ".config", "user-dirs.dirs")
    try:
        with open(config_file, "r", encoding="utf-8", errors="surrogateescape") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                if k not in XDG_KEYS:
                    continue
                v = v.strip().strip('"')
                v = v.replace("$HOME", HOME)
                result[XDG_KEYS[k]] = v
    except OSError:
        pass
    dirs = {}
    for key, path in result.items():
        try:
            if os.path.exists(to_bytes(path)):
                dirs[key] = path
        except OSError:
            pass
    emit({"id": req_id, "t": "dirs", "dirs": dirs})
    send_done(req_id)

def op_ping(req):
    send_done(req["id"], version=VERSION, pid=os.getpid(), inotify=INOTIFY_AVAILABLE)

def op_cancel(req):
    req_id = req["id"]
    target = req.get("target")
    ev = None
    with INFLIGHT_LOCK:
        info = INFLIGHT.get(target)
        if info:
            ev = info["cancel"]
    if ev is not None:
        ev.set()
    else:
        handle = None
        key = None
        with WATCH_LOCK:
            for pth, h in WATCHES.items():
                if h.req_id == target:
                    handle = h
                    key = pth
                    break
            if key is not None:
                del WATCHES[key]
        if handle:
            stop_watch(handle, cancelled=True)
    send_done(req_id)

PLUGIN_ENTRY_ID = "xyzlab.omafile"
SHELL_CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
    "omarchy", "shell.json")
BAR_SECTIONS = ("left", "center", "right")


def read_shell_config():
    with open(SHELL_CONFIG_PATH, "r", encoding="utf-8") as f:
        config = json.load(f)
    if not isinstance(config, dict):
        raise ValueError("shell.json is not an object")
    return config


def write_shell_config(config):
    directory = os.path.dirname(SHELL_CONFIG_PATH)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".omafile-shell-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, SHELL_CONFIG_PATH)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def bar_sections(config):
    bar = config.get("bar")
    if not isinstance(bar, dict):
        return []
    layout = bar.get("layout")
    if not isinstance(layout, dict):
        return []
    out = []
    for name in BAR_SECTIONS:
        arr = layout.get(name)
        if isinstance(arr, list):
            out.append((name, arr))
    return out


def omafile_entries(config):
    found = []
    for name, arr in bar_sections(config):
        for index, entry in enumerate(arr):
            if isinstance(entry, dict) and entry.get("id") == PLUGIN_ENTRY_ID:
                found.append((name, arr, index, entry))
    return found


TRASH_ENTRY_KEYS = ("trashConfirm",)


def is_trash_entry(entry):
    return str(entry.get("mode", "")).lower() == "trash"


def bar_state(config):
    entries = omafile_entries(config)
    return {
        "present": bool(entries),
        "trashIcon": any(is_trash_entry(e) for _, _, _, e in entries),
        "count": len(entries),
    }


def op_baricon(req):
    req_id = req["id"]
    action = str(req.get("action") or "status")
    try:
        config = read_shell_config()
    except (OSError, ValueError) as e:
        send_error(req_id, "ENOENT", "could not read shell.json: %s" % e, SHELL_CONFIG_PATH)
        return

    if action == "status":
        state = bar_state(config)
        emit(dict({"id": req_id, "t": "baricon"}, **state))
        send_done(req_id)
        return

    if action not in ("add", "remove"):
        send_error(req_id, "EINVAL", "unknown action: %s" % action)
        return

    entries = omafile_entries(config)
    changed = False

    if action == "add":
        if not any(is_trash_entry(e) for _, _, _, e in entries):
            anchor = None
            for name, arr, index, entry in entries:
                if not is_trash_entry(entry):
                    anchor = (arr, index)
            new_entry = {"id": PLUGIN_ENTRY_ID, "mode": "trash", "trashConfirm": True}
            if anchor:
                anchor[0].insert(anchor[1] + 1, new_entry)
            else:
                sections = bar_sections(config)
                if not sections:
                    send_error(req_id, "EINVAL", "shell.json has no bar layout")
                    return
                sections[-1][1].append(new_entry)
            changed = True
    else:
        for name, arr, index, entry in reversed(entries):
            if is_trash_entry(entry):
                del arr[index]
                changed = True

    if changed:
        try:
            write_shell_config(config)
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), SHELL_CONFIG_PATH)
            return

    state = bar_state(config)
    emit(dict({"id": req_id, "t": "baricon", "changed": changed}, **state))
    send_done(req_id)


def op_barsettings(req):
    req_id = req["id"]
    settings = req.get("settings")
    if not isinstance(settings, dict):
        send_error(req_id, "EINVAL", "settings must be an object")
        return
    try:
        config = read_shell_config()
    except (OSError, ValueError) as e:
        send_error(req_id, "ENOENT", "could not read shell.json: %s" % e, SHELL_CONFIG_PATH)
        return

    changed = False
    for name, arr, index, entry in omafile_entries(config):
        trash = is_trash_entry(entry)
        merged = dict(entry)
        for key, value in settings.items():
            if key in ("id", "mode"):
                continue
            if trash and key not in TRASH_ENTRY_KEYS:
                continue
            merged[key] = value
        if merged != entry:
            arr[index] = merged
            changed = True

    if changed:
        try:
            write_shell_config(config)
        except OSError as e:
            send_error(req_id, errno_code(e), e.strerror or str(e), SHELL_CONFIG_PATH)
            return

    emit({"id": req_id, "t": "barsettings", "changed": changed})
    send_done(req_id)


ARCHIVE_SUFFIXES = (".tar.gz", ".tar.xz", ".tar.bz2", ".tar.zst", ".tar.lz", ".tar",
                    ".tgz", ".txz", ".tbz", ".tbz2", ".tzst", ".zip", ".7z", ".rar")


def archive_stem(name):
    lower = name.lower()
    for suffix in ARCHIVE_SUFFIXES:
        if lower.endswith(suffix) and len(name) > len(suffix):
            return name[:-len(suffix)]
    return os.path.splitext(name)[0] or name


def extract_argv(path, work):
    return [trusted_program("bsdtar"), "-xvf", path, "-C", work]


def archive_read_position(pid, archive):
    fd_dir = "/proc/%d/fd" % pid
    try:
        names = os.listdir(fd_dir)
    except OSError:
        return None
    for name in names:
        try:
            if os.readlink(os.path.join(fd_dir, name)) != archive:
                continue
            with open("/proc/%d/fdinfo/%s" % (pid, name)) as f:
                for line in f:
                    if line.startswith("pos:"):
                        return int(line.split()[1])
        except (OSError, ValueError, IndexError):
            continue
    return None


def run_bsdtar(argv, req_id, cancel_event, total, measure, on_entry=None, stdin_data=None):
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE if stdin_data is not None else subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=trusted_env(),
                            close_fds=True, start_new_session=True)
    if stdin_data is not None:
        def feed():
            try:
                proc.stdin.write(stdin_data)
            except OSError:
                pass
            finally:
                try:
                    proc.stdin.close()
                except OSError:
                    pass
        threading.Thread(target=feed, daemon=True).start()
    stream = proc.stderr.fileno()
    pending = b""
    errors = []
    error_bytes = 0
    files = 0
    current = ""
    done_bytes = 0
    started = time.monotonic()
    last_report = started
    reading = True

    def take(line):
        nonlocal files, current, error_bytes
        text = line.decode("utf-8", "replace").rstrip("\r")
        if text.startswith("x ") or text.startswith("a "):
            files += 1
            current = text[2:]
            if on_entry:
                on_entry(current)
        elif text and error_bytes < MAX_CAPTURE_BYTES:
            errors.append(text)
            error_bytes += len(text)

    try:
        while True:
            if cancel_event.is_set():
                kill_process_group(proc)
                proc.wait()
                return -1, "cancelled"
            if reading:
                ready, _, _ = select.select([stream], [], [], 0.25)
                if ready:
                    chunk = os.read(stream, 65536)
                    if chunk:
                        lines = (pending + chunk).split(b"\n")
                        pending = lines.pop()
                        for line in lines:
                            take(line)
                    else:
                        reading = False
            elif proc.poll() is not None:
                break
            else:
                time.sleep(0.05)
            now = time.monotonic()
            if now - last_report >= 0.25:
                last_report = now
                measured = measure(proc.pid)
                if measured is not None:
                    done_bytes = max(done_bytes, min(measured, total))
                elapsed = now - started
                if pending.startswith(b"x ") or pending.startswith(b"a "):
                    current = pending[2:].decode("utf-8", "replace")
                emit({"id": req_id, "t": "progress", "bytes": done_bytes, "total": total,
                      "files": files, "filesTotal": 0, "current": current,
                      "rate": done_bytes / elapsed if elapsed > 0 else 0})
        if pending:
            take(pending)
        return proc.returncode, "\n".join(errors).strip()
    except BaseException:
        kill_process_group(proc)
        raise
    finally:
        proc.stderr.close()


def run_extract(argv, archive, req_id, cancel_event):
    real = os.path.realpath(archive)
    return run_bsdtar(argv, req_id, cancel_event, os.path.getsize(archive),
                      lambda pid: archive_read_position(pid, real))


def op_extract(req, cancel_event):
    req_id = req["id"]
    path = req.get("path")
    if not isinstance(path, str) or not os.path.isfile(path):
        send_error(req_id, "EINVAL", "an archive file is required", path if isinstance(path, str) else None)
        return
    dest_dir = os.path.dirname(path)
    try:
        work = tempfile.mkdtemp(prefix=".omafile-extract-", dir=dest_dir)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), dest_dir)
        return
    try:
        try:
            argv = extract_argv(path, work)
        except FileNotFoundError:
            send_error(req_id, "EUNSUPPORTED", "bsdtar is not installed", path)
            return
        code, err = run_extract(argv, path, req_id, cancel_event)
        if code != 0:
            shutil.rmtree(work, ignore_errors=True)
            send_error(req_id, "ECANCELED" if code == -1 else "EFAIL", err or "could not extract", path)
            return
        items = os.listdir(work)
        dest_bytes = to_bytes(dest_dir)
        if len(items) == 1:
            final = os.path.join(dest_bytes, unique_dest_name(dest_bytes, to_bytes(items[0])))
            os.rename(os.path.join(work, items[0]), final)
        else:
            stem = to_bytes(archive_stem(os.path.basename(path)))
            final = os.path.join(dest_bytes, unique_dest_name(dest_bytes, stem))
            os.rename(work, final)
            work = None
        send_done(req_id, path=to_str(final))
    except OSError as e:
        if work:
            shutil.rmtree(work, ignore_errors=True)
        send_error(req_id, errno_code(e), e.strerror or str(e), path)
    finally:
        if work and os.path.isdir(work):
            shutil.rmtree(work, ignore_errors=True)


COMPRESS_SUFFIXES = (".zip", ".tar.xz", ".tar.gz", ".7z")


def compress_suffix(name):
    lower = name.lower()
    for suffix in COMPRESS_SUFFIXES:
        if lower.endswith(suffix) and len(name) > len(suffix):
            return name[-len(suffix):]
    return ""


def unique_archive_name(dest_bytes, name):
    suffix = compress_suffix(name)
    stem = name[:-len(suffix)]
    candidate = name
    n = 1
    while os.path.lexists(os.path.join(dest_bytes, to_bytes(candidate))):
        candidate = "%s (%d)%s" % (stem, n, suffix)
        n += 1
    return candidate


def compress_sizes(parent_bytes, names):
    sizes = {}
    for name in names:
        top = os.path.join(parent_bytes, name)
        lst = os.lstat(top)
        sizes[to_str(name)] = lst.st_size if stat.S_ISREG(lst.st_mode) else 0
        if not stat.S_ISDIR(lst.st_mode):
            continue
        for dirpath, dirnames, filenames in os.walk(top, followlinks=False):
            for child in filenames:
                full = os.path.join(dirpath, child)
                try:
                    child_lst = os.lstat(full)
                except OSError:
                    continue
                if stat.S_ISREG(child_lst.st_mode):
                    sizes[to_str(os.path.relpath(full, parent_bytes))] = child_lst.st_size
    return sizes


def op_compress(req, cancel_event):
    req_id = req["id"]
    paths = req.get("paths")
    name = req.get("name")
    if (not isinstance(paths, list) or not paths or not all(isinstance(p, str) and os.path.isabs(p) for p in paths)
            or not isinstance(name, str) or "/" in name or name in (".", "..") or not compress_suffix(name)):
        send_error(req_id, "EINVAL", "absolute paths and an archive name ending in .zip, .tar.xz, .tar.gz or .7z are required")
        return
    parent = os.path.dirname(os.path.normpath(paths[0]))
    names = []
    for p in paths:
        p = os.path.normpath(p)
        if os.path.dirname(p) != parent or p == parent:
            send_error(req_id, "EINVAL", "every item must be in the same folder", p)
            return
        if not os.path.lexists(p):
            send_error(req_id, "ENOENT", "no such file or directory", p)
            return
        names.append(to_bytes(os.path.basename(p)))
    parent_bytes = to_bytes(parent)
    try:
        sizes = compress_sizes(parent_bytes, names)
        fd, work = tempfile.mkstemp(prefix=".omafile-compress-", suffix=compress_suffix(name), dir=parent)
        os.close(fd)
    except OSError as e:
        send_error(req_id, errno_code(e), e.strerror or str(e), parent)
        return
    try:
        try:
            argv = [trusted_program("bsdtar"), "-a", "-cvf", work, "-C", parent, "--null", "-T", "-"]
        except FileNotFoundError:
            os.unlink(work)
            send_error(req_id, "EUNSUPPORTED", "bsdtar is not installed", parent)
            return
        done = [0]

        def counted(entry):
            done[0] += sizes.get(entry, 0)

        code, err = run_bsdtar(argv, req_id, cancel_event, sum(sizes.values()), lambda pid: done[0],
                               on_entry=counted, stdin_data=b"".join(n + b"\0" for n in names))
        if code != 0:
            os.unlink(work)
            send_error(req_id, "ECANCELED" if code == -1 else "EFAIL", err or "could not compress", parent)
            return
        while True:
            final = os.path.join(parent_bytes, to_bytes(unique_archive_name(parent_bytes, name)))
            try:
                os.link(work, final)
                break
            except FileExistsError:
                continue
        os.unlink(work)
        send_done(req_id, path=to_str(final))
    except OSError as e:
        if os.path.lexists(work):
            os.unlink(work)
        send_error(req_id, errno_code(e), e.strerror or str(e), parent)


CANCELLABLE_OPS = {
    "list": op_list,
    "search": op_search,
    "du": op_du,
    "copy": lambda r, c: op_copy_move(r, c, False),
    "move": lambda r, c: op_copy_move(r, c, True),
    "mounturi": op_mounturi,
    "mountdev": op_mountdev,
    "unmountdev": op_unmountdev,
    "recent": op_recent,
    "setdefaultfm": op_setdefaultfm,
    "unmounturi": op_unmounturi,
    "thumb": op_thumb,
    "counts": op_counts,
    "extract": op_extract,
    "compress": op_compress,
}

SIMPLE_OPS = {
    "clipset": op_clipset,
    "clipget": op_clipget,
    "clipimage": op_clipimage,
    "clipclear": op_clipclear,
    "samedev": op_samedev,
    "stat": op_stat,
    "peek": op_peek,
    "thumbtypes": op_thumbtypes,
    "bookmarks": op_bookmarks,
    "setbookmarks": op_setbookmarks,
    "trash": op_trash,
    "delete": op_delete,
    "restore": op_restore,
    "trashinfo": op_trashinfo,
    "emptytrash": op_emptytrash,
    "mkdir": op_mkdir,
    "mkfile": op_mkfile,
    "rename": op_rename,
    "identity": op_identity,
    "opener": op_opener,
    "setopener": op_setopener,
    "chmod": op_chmod,
    "chown": op_chown,
    "symlink": op_symlink,
    "freespace": op_freespace,
    "drives": op_drives,
    "netmounts": op_netmounts,
    "netdiscover": op_netdiscover,
    "defaultfm": op_defaultfm,
    "dirs": op_dirs,
    "ping": op_ping,
    "watch": op_watch,
    "unwatch": op_unwatch,
    "baricon": op_baricon,
    "barsettings": op_barsettings,
}

def dispatch(req):
    req_id = req.get("id")
    op = req.get("op")
    try:
        if op == "cancel":
            op_cancel(req)
            return
        if op == "resolve":
            op_resolve(req)
            return
        if op in CANCELLABLE_OPS:
            handler = CANCELLABLE_OPS[op]
            ev = register_inflight(req_id, op)
            try:
                handler(req, ev)
            finally:
                unregister_inflight(req_id)
            return
        if op in SIMPLE_OPS:
            SIMPLE_OPS[op](req)
            return
        send_error(req_id, "EUNSUPPORTED", "unknown op: %s" % op)
    except Exception as e:
        try:
            send_error(req_id, "EINTERNAL", str(e))
        except Exception:
            pass

ACTIVE_THREADS_LOCK = threading.Lock()
ACTIVE_THREADS = []

def run_and_untrack(req, t):
    try:
        dispatch(req)
    finally:
        with ACTIVE_THREADS_LOCK:
            if t in ACTIVE_THREADS:
                ACTIVE_THREADS.remove(t)

def main():
    try:
        sys.stdin.reconfigure(encoding="utf-8", errors="strict")
        sys.stdout.reconfigure(encoding="utf-8", errors="strict")
    except AttributeError:
        pass
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except ValueError:
            sys.stderr.write("malformed request line\n")
            sys.stderr.flush()
            continue
        if not isinstance(req, dict) or "op" not in req or "id" not in req:
            if isinstance(req, dict) and "id" in req:
                send_error(req["id"], "EINVAL", "missing op")
            continue
        holder = []
        t = threading.Thread(target=lambda: run_and_untrack(req, holder[0]), daemon=True)
        holder.append(t)
        with ACTIVE_THREADS_LOCK:
            ACTIVE_THREADS.append(t)
        t.start()
    deadline = time.monotonic() + 15.0
    while time.monotonic() < deadline:
        with ACTIVE_THREADS_LOCK:
            remaining = list(ACTIVE_THREADS)
        if not remaining:
            break
        for t in remaining:
            t.join(timeout=0.1)
            if time.monotonic() >= deadline:
                break

if __name__ == "__main__":
    main()
