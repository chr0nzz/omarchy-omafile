{
  "schemaVersion": 1,
  "id": "xyzlab.omafile",
  "name": "Omafile",
  "version": "0.1.0",
  "author": "xyzlab",
  "license": "MIT",
  "description": "A file manager for Omarchy. Opens as a real window with tabs and dual panes, watches directories live, copies and moves in the background with progress, and puts places, drives, transfers and trash in the bar.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Window.qml"
  },
  "barWidget": {
    "displayName": "Omafile",
    "description": "Open the file manager, jump to a place, watch transfers, empty the trash.",
    "category": "Tools",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "homePath": "",
      "showHidden": false,
      "sortBy": "name",
      "sortDirsFirst": true,
      "confirmDelete": true,
      "useTrash": true,
      "defaultView": "list",
      "terminal": "",
      "editor": "",
      "showTransferBadge": true,
      "glyph": "",
      "showDrives": true,
      "thumbnails": true,
      "windowMode": "window"
    },
    "schema": [
      {
        "key": "homePath",
        "type": "string",
        "label": "Start directory (empty for home)",
        "defaultValue": ""
      },
      {
        "key": "showHidden",
        "type": "boolean",
        "label": "Show hidden files",
        "defaultValue": false
      },
      {
        "key": "sortBy",
        "type": "string",
        "label": "Sort by: name, size, modified, type",
        "defaultValue": "name"
      },
      {
        "key": "sortDirsFirst",
        "type": "boolean",
        "label": "Directories first",
        "defaultValue": true
      },
      {
        "key": "confirmDelete",
        "type": "boolean",
        "label": "Confirm before deleting",
        "defaultValue": true
      },
      {
        "key": "useTrash",
        "type": "boolean",
        "label": "Delete moves to trash",
        "defaultValue": true
      },
      {
        "key": "defaultView",
        "type": "string",
        "label": "Default view: list or grid",
        "defaultValue": "list"
      },
      {
        "key": "terminal",
        "type": "string",
        "label": "Terminal command (empty for system default)",
        "defaultValue": ""
      },
      {
        "key": "editor",
        "type": "string",
        "label": "Editor command (empty for Omarchy default)",
        "defaultValue": ""
      },
      {
        "key": "showTransferBadge",
        "type": "boolean",
        "label": "Show transfer progress on the bar icon",
        "defaultValue": true
      },
      {
        "key": "glyph",
        "type": "string",
        "label": "Custom bar glyph (empty for folder)",
        "defaultValue": ""
      },
      {
        "key": "showDrives",
        "type": "boolean",
        "label": "Show drives in the sidebar",
        "defaultValue": true
      },
      {
        "key": "thumbnails",
        "type": "boolean",
        "label": "Show image previews in grid view",
        "defaultValue": true
      },
      {
        "key": "windowMode",
        "type": "string",
        "label": "Open as a window or a popup",
        "defaultValue": "window"
      }
    ]
  }
}
