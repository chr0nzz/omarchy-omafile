{
  "schemaVersion": 1,
  "id": "xyzlab.omafile",
  "name": "Omafile",
  "version": "1.3.2",
  "author": "xyzlab",
  "license": "MIT",
  "description": "A file manager for Omarchy. Opens as a real window with tabs and dual panes, watches directories live, copies and moves in the background with progress, and puts places, drives, transfers and trash in the bar.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Window.qml"
  },
  "barWidget": {
    "displayName": "Omafile",
    "description": "Open the file manager, jump to a place, watch transfers, empty the trash. A second one set to trash is a standalone trash can.",
    "category": "Tools",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "mode": "files",
      "homePath": "",
      "showHidden": false,
      "sortBy": "name",
      "sortDirsFirst": true,
      "confirmDelete": true,
      "confirmTrash": true,
      "useTrash": true,
      "defaultView": "list",
      "rememberFolderViews": true,
      "extractOnOpen": false,
      "dropAction": "auto",
      "viewScale": 1,
      "terminal": "",
      "editor": "",
      "showTransferBadge": true,
      "glyph": "",
      "showDrives": true,
      "thumbnails": true,
      "gridCaption1": "none",
      "gridCaption2": "none",
      "gridCaption3": "none",
      "windowMode": "window",
      "trashConfirm": true
    },
    "schema": [
      {
        "key": "mode",
        "type": "string",
        "label": "What this icon does: files or trash",
        "defaultValue": "files"
      },
      {
        "key": "homePath",
        "type": "string",
        "label": "Start directory (empty for home)",
        "defaultValue": ""
      },
      {
        "key": "showHidden",
        "type": "boolean",
        "label": "Show hidden files",
        "defaultValue": false
      },
      {
        "key": "sortBy",
        "type": "string",
        "label": "Sort by: name, size, modified, type",
        "defaultValue": "name"
      },
      {
        "key": "sortDirsFirst",
        "type": "boolean",
        "label": "Directories first",
        "defaultValue": true
      },
      {
        "key": "confirmDelete",
        "type": "boolean",
        "label": "Confirm before deleting",
        "defaultValue": true
      },
      {
        "key": "confirmTrash",
        "type": "boolean",
        "label": "Confirm before moving items to trash",
        "defaultValue": true
      },
      {
        "key": "useTrash",
        "type": "boolean",
        "label": "Delete moves to trash",
        "defaultValue": true
      },
      {
        "key": "dropAction",
        "type": "string",
        "label": "Drag and drop: auto, ask, copy or move",
        "defaultValue": "auto"
      },
      {
        "key": "defaultView",
        "type": "string",
        "label": "Default view: list, compact, grid or gallery",
        "defaultValue": "list"
      },
      {
        "key": "rememberFolderViews",
        "type": "boolean",
        "label": "Remember the view for each folder",
        "defaultValue": true
      },
      {
        "key": "extractOnOpen",
        "type": "boolean",
        "label": "Extract archives when opened",
        "defaultValue": false
      },
      {
        "key": "viewScale",
        "type": "number",
        "label": "View size multiplier for rows, icons and grid cells",
        "defaultValue": 1
      },
      {
        "key": "terminal",
        "type": "string",
        "label": "Terminal command (empty for system default)",
        "defaultValue": ""
      },
      {
        "key": "editor",
        "type": "string",
        "label": "Editor command (empty for Omarchy default)",
        "defaultValue": ""
      },
      {
        "key": "showTransferBadge",
        "type": "boolean",
        "label": "Show transfer progress on the bar icon",
        "defaultValue": true
      },
      {
        "key": "glyph",
        "type": "string",
        "label": "Custom bar glyph (empty for folder)",
        "defaultValue": ""
      },
      {
        "key": "showDrives",
        "type": "boolean",
        "label": "Show drives in the sidebar",
        "defaultValue": true
      },
      {
        "key": "thumbnails",
        "type": "boolean",
        "label": "Show image previews and thumbnails for videos and documents",
        "defaultValue": true
      },
      {
        "key": "gridCaption1",
        "type": "string",
        "label": "First grid caption: none, size, type, modified or permissions",
        "defaultValue": "none"
      },
      {
        "key": "gridCaption2",
        "type": "string",
        "label": "Second grid caption, shown from 90 percent zoom",
        "defaultValue": "none"
      },
      {
        "key": "gridCaption3",
        "type": "string",
        "label": "Third grid caption, shown from 130 percent zoom",
        "defaultValue": "none"
      },
      {
        "key": "windowMode",
        "type": "string",
        "label": "Open as a window or a popup",
        "defaultValue": "window"
      },
      {
        "key": "trashConfirm",
        "type": "boolean",
        "label": "Ask before a right click empties the trash",
        "defaultValue": true
      }
    ]
  }
}
